# ============================================================
# ACC ClubHub Backend - Environment Variables Template
# Phase 4.3: Event Registration System
# ============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================

# ============================================================
# Supabase Configuration
# ============================================================
# Get these from: https://supabase.com/dashboard > Your Project > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# ============================================================
# Database Connection
# ============================================================
# PostgreSQL connection string (Supabase provides this)
# Format: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ============================================================
# Email Service (Resend)
# ============================================================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# ============================================================
# CORS Configuration
# ============================================================
# Comma-separated list of allowed origins for API access
# Development: http://localhost:4321
# Production: https://your-acc-clubhub.vercel.app
ALLOWED_ORIGINS=http://localhost:4321,https://acc-clubhub.vercel.app

# ============================================================
# Application Settings
# ============================================================
APP_NAME=ACC ClubHub API
DEBUG=false
