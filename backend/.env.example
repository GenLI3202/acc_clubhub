# ============================================================
# ACC ClubHub Backend - Environment Variables Template
# Phase 4.3: Email-based Event Registration
# ============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================

# ============================================================
# Database Connection (Neon / Vercel Postgres)
# ============================================================
# Same database as Waline comments
# Get from: Vercel Dashboard > Storage > your Postgres > .env tab
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================================
# Email Service (Resend)
# ============================================================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# ============================================================
# CORS Configuration
# ============================================================
ALLOWED_ORIGINS=http://localhost:4321,https://acc-clubhub.vercel.app

# ============================================================
# Application Settings
# ============================================================
APP_NAME=ACC ClubHub API
DEBUG=false
