# Waline 评论系统服务端 URL
# 部署时请在 Vercel Dashboard 中配置此环境变量
PUBLIC_WALINE_SERVER_URL=https://your-waline.vercel.app

# Backend API URL
PUBLIC_API_URL=https://acc-clubhub-events-ms.vercel.app

# Canonical public URL embedded in generated mobile content
PUBLIC_SITE_URL=https://www.across-cc.de

# Oldest mobile application version accepted by the generated content feed
MOBILE_MINIMUM_APP_VERSION=0.1.0
