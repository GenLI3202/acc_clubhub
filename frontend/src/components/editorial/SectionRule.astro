---
// components/editorial/SectionRule.astro
// Ported from about.astro .section-rule: centered uppercase label flanked by 1px rules.

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="section-rule">{label}</div>

<style>
  .section-rule {
    max-width: 900px;
    margin: 72px auto 0;
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-heading);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-text-secondary);
    padding: 0 24px;
  }

  .section-rule::before,
  .section-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border-strong);
  }
</style>
