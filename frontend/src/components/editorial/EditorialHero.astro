---
// components/editorial/EditorialHero.astro
// Shared editorial hero block — eyebrow + H1 with accent bar + subtitle.
// Mirrors .about-title-block / .about-h1::after design language from about.astro.

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<div class="editorial-hero">
  <div class="editorial-eyebrow">{eyebrow}</div>
  <h1 class="editorial-h1">{title}</h1>
  <div class="editorial-subtitle">{subtitle}</div>
</div>

<style>
  .editorial-hero {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    padding: 64px 24px 0;
  }

  .editorial-eyebrow {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 14px;
  }

  .editorial-h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(40px, 5.5vw, 64px);
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--color-text-main);
    margin: 0;
  }

  .editorial-h1::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-accent);
    margin: 18px auto 0;
  }

  .editorial-subtitle {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: 17px;
    color: var(--color-text-secondary);
    margin-top: 14px;
    letter-spacing: 0.01em;
  }
</style>
