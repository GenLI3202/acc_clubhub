---
import { getNavLinks, locales, type Locale, t } from '../lib/i18n';
import { GlobalSearch } from './search/GlobalSearch';


interface Props {
  lang?: Locale;
  transparent?: boolean;
}

const { lang = 'zh', transparent = false } = Astro.props;
const navLinks = getNavLinks(lang);
const currentPath = Astro.url.pathname;

function getLangSwitchUrl(targetLang: Locale): string {
  const pathWithoutLang = currentPath.replace(/^\/(zh|en|de)/, '');
  return `/${targetLang}${pathWithoutLang || ''}`;
}
---

<header class:list={[{ 'header-transparent': transparent }]}>
  <nav>
    <a href={`/${lang}`} class="logo">
      <img src="/images/transparent_red_logo.png" alt="ACC ClubHub" width="40" height="40" />
      <span>ACC ClubHub</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <ul>
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[{ active: currentPath === link.href || (link.href !== `/${lang}` && currentPath.startsWith(link.href)) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="header-actions">
      <GlobalSearch
        client:idle
        lang={lang}
        translations={{
          searchPlaceholder: t(lang, 'search.placeholder'),
          noResults: t(lang, 'search.noResults')
        }}
      />

      <div class="lang-dropdown">
        <button class="lang-toggle">
          {lang.toUpperCase()}
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="lang-menu">
          {locales.map((l) => (
            <a
              href={getLangSwitchUrl(l)}
              class:list={['lang-link', { active: l === lang }]}
            >
              {l.toUpperCase()}
            </a>
          ))}
        </div>
      </div>
    </div>
  </nav>
</header>

{transparent && (
  <script>
    const header = document.querySelector('header');
    if (header) {
      const onScroll = () => {
        if (window.scrollY > 40) {
          header.classList.add('header-scrolled');
        } else {
          header.classList.remove('header-scrolled');
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  </script>
)}

<style>
  header {
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 100;
    /* Default: solid white */
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  /* Transparent mode: fixed so hero slides behind it */
  header.header-transparent {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
    box-shadow: none;
  }

  /* After scrolling: fade in white */
  header.header-transparent.header-scrolled {
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .logo:hover {
    text-decoration: none;
    color: var(--color-accent);
  }

  .logo img {
    border-radius: 4px;
  }

  /* Transparent mode: white logo text */
  header.header-transparent .logo {
    color: #ffffff;
  }
  header.header-transparent.header-scrolled .logo {
    color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: 1rem;
  }

  ul {
    display: flex;
    list-style: none;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }

  li a {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text-main);
    padding: 0.25rem 0.5rem;
    position: relative;
    transition: color var(--transition-fast);
  }

  /* Transparent mode: white nav links */
  header.header-transparent li a {
    color: rgba(255, 255, 255, 0.9);
  }
  header.header-transparent.header-scrolled li a {
    color: var(--color-text-main);
  }

  li a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  header.header-transparent li a:hover {
    color: #ffffff;
  }
  header.header-transparent.header-scrolled li a:hover {
    color: var(--color-accent);
  }

  /* Hover/active underline */
  li a::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 1px;
    transition: width var(--transition-base);
  }

  li a:hover::after,
  li a.active::after {
    width: 100%;
  }

  li a.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  header.header-transparent li a.active {
    color: #ffffff;
  }
  header.header-transparent.header-scrolled li a.active {
    color: var(--color-accent);
  }

  /* Mobile hamburger */
  .nav-toggle { display: none; }

  .nav-toggle-label {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle-label span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text-main);
    transition: all var(--transition-base);
  }

  header.header-transparent .nav-toggle-label span {
    background: #ffffff;
  }
  header.header-transparent.header-scrolled .nav-toggle-label span {
    background: var(--color-text-main);
  }

  @media (max-width: 768px) {
    .nav-toggle-label { display: flex; }

    ul {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
    }

    .nav-toggle:checked ~ ul { display: flex; }

    li a { display: block; padding: 0.5rem 0; }

    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }
    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    .header-actions {
      margin-left: auto;
      margin-right: 1rem;
    }
  }

  /* Language switcher */
  .lang-dropdown {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  header.header-transparent .lang-toggle {
    color: rgba(255, 255, 255, 0.9);
  }
  header.header-transparent.header-scrolled .lang-toggle {
    color: var(--color-text-main);
  }

  /* Search icon: white in transparent mode */
  header.header-transparent :global(.global-search-trigger) {
    color: rgba(255, 255, 255, 0.9);
  }
  header.header-transparent :global(.global-search-trigger:hover) {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.15);
  }
  header.header-transparent.header-scrolled :global(.global-search-trigger) {
    color: var(--color-text-main);
  }
  header.header-transparent.header-scrolled :global(.global-search-trigger:hover) {
    color: var(--color-primary);
    background: rgba(0, 0, 0, 0.05);
  }

  .arrow-icon {
    width: 12px;
    height: 12px;
    transition: transform var(--transition-fast);
    margin-top: 1px;
    opacity: 0.7;
  }

  .lang-dropdown:hover .arrow-icon { transform: rotate(180deg); }

  .lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: 0.25rem 0;
    display: none;
    flex-direction: column;
    min-width: 60px;
    z-index: 101;
  }

  .lang-dropdown:hover .lang-menu { display: flex; }

  .lang-link {
    display: block;
    padding: 0.4rem 0.8rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-text-main);
    text-decoration: none;
    text-align: center;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .lang-link:hover {
    background: var(--color-bg-secondary);
    color: var(--color-accent);
  }

  .lang-link.active {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
