---
import { getNavLinks, locales, type Locale, t } from '../lib/i18n';
import { GlobalSearch } from './search/GlobalSearch';


interface Props {
  lang?: Locale;
  transparent?: boolean;
}

const { lang = 'zh', transparent = false } = Astro.props;
const navLinks = getNavLinks(lang);
const currentPath = Astro.url.pathname;

function getLangSwitchUrl(targetLang: Locale): string {
  const pathWithoutLang = currentPath.replace(/^\/(zh|en|de)/, '');
  return `/${targetLang}${pathWithoutLang || ''}`;
}
---

<header class:list={[{ 'header-transparent': transparent }]}>
  <nav>
    <a href={`/${lang}`} class="logo">
      <span>ACC ClubHub</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <ul>
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[{ active: currentPath === link.href || (link.href !== `/${lang}` && currentPath.startsWith(link.href)) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="header-actions">
      <!-- Theme toggle: moon = go dark, sun = go light -->
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
        <!-- Moon icon — visible in light mode -->
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <!-- Sun icon — visible in dark mode -->
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <GlobalSearch
        client:idle
        lang={lang}
        translations={{
          searchPlaceholder: t(lang, 'search.placeholder'),
          noResults: t(lang, 'search.noResults')
        }}
      />

      <div class="lang-dropdown">
        <button class="lang-toggle">
          {lang.toUpperCase()}
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="lang-menu">
          {locales.map((l) => (
            <a
              href={getLangSwitchUrl(l)}
              class:list={['lang-link', { active: l === lang }]}
              data-lang={l}
            >
              {l.toUpperCase()}
            </a>
          ))}
        </div>
      </div>

      <a
        href={`/${lang}/membership`}
        class:list={['join-cta', { 'join-cta--active': currentPath.includes('/membership') }]}
        aria-label="Join ACC"
      >JOIN</a>
    </div>
  </nav>
</header>

<script>
  // Theme toggle — persists to localStorage, applies .dark to <html>
  const themeBtn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function applyTheme(dark: boolean) {
    root.classList.toggle('dark', dark);
    try { localStorage.setItem('acc-theme', dark ? 'dark' : 'light'); } catch (e) {}
  }

  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      applyTheme(!root.classList.contains('dark'));
    });
  }

  // Transparent-header scroll handler: check DOM class at runtime so this
  // single <script> block works on all pages without conditional rendering.
  // (A second conditional <script> block causes Astro to assign indices that
  // break script loading on non-transparent pages.)
  const header = document.querySelector('header');
  if (header?.classList.contains('header-transparent')) {
    const onScroll = () => {
      if (window.scrollY > 40) {
        header.classList.add('header-scrolled');
      } else {
        header.classList.remove('header-scrolled');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Language dropdown toggle. Use mousedown (not click) so this fires before
  // Preact's synthetic click delegation on pages with client:load islands.
  const dropdown = document.querySelector('.lang-dropdown');
  const toggle = dropdown?.querySelector('.lang-toggle');
  if (dropdown && toggle) {
    toggle.addEventListener('mousedown', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('open');
    });
    // Close when clicking outside
    document.addEventListener('mousedown', (e) => {
      if (!dropdown.contains(e.target as Node)) {
        dropdown.classList.remove('open');
      }
    });
  }

  // Save language preference when user switches
  document.querySelectorAll('.lang-link[data-lang]').forEach((link) => {
    link.addEventListener('click', () => {
      const lang = (link as HTMLAnchorElement).dataset.lang;
      if (lang) {
        try { localStorage.setItem('acc-locale', lang); } catch (e) {}
      }
    });
  });

  // Mobile nav: add .nav-open to <header> when checkbox is checked
  // (fallback for browsers without :has() support)
  const navToggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
  if (navToggle && header) {
    navToggle.addEventListener('change', () => {
      header.classList.toggle('nav-open', navToggle.checked);
    });
  }
</script>

<style>
  header {
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 100;
    /* Default: canvas with subtle blur */
    background: color-mix(in srgb, var(--color-bg-canvas) 97%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  /* Transparent mode: fixed so hero slides behind it */
  header.header-transparent {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
    box-shadow: none;
  }

  /* After scrolling: fade in canvas color */
  header.header-transparent.header-scrolled {
    background: color-mix(in srgb, var(--color-bg-canvas) 97%, transparent);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .logo:hover {
    text-decoration: none;
    color: var(--color-accent);
  }

  .logo img {
    border-radius: 4px;
    mix-blend-mode: multiply;
  }

  /* Transparent mode: white logo text */
  header.header-transparent .logo {
    color: #ffffff;
  }
  header.header-transparent.header-scrolled .logo {
    color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: 1rem;
  }

  .join-cta {
    background: var(--color-accent);
    color: #fff;
    padding: 8px 16px;
    border-radius: 9999px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
    transition: all 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
    margin-left: 0.25rem;
  }

  .join-cta:hover,
  .join-cta--active {
    background: var(--color-accent-dark);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    color: #fff;
    text-decoration: none;
  }

  ul {
    display: flex;
    list-style: none;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }

  li a {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text-main);
    padding: 0.25rem 0.5rem;
    position: relative;
    transition: color var(--transition-fast);
  }

  /* Transparent mode: white nav links */
  header.header-transparent li a {
    color: rgba(255, 255, 255, 0.9);
  }
  header.header-transparent.header-scrolled li a {
    color: var(--color-text-main);
  }

  li a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  header.header-transparent li a:hover {
    color: #ffffff;
  }
  header.header-transparent.header-scrolled li a:hover {
    color: var(--color-accent);
  }

  /* Hover/active underline */
  li a::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 1px;
    transition: width var(--transition-base);
  }

  li a:hover::after,
  li a.active::after {
    width: 100%;
  }

  li a.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  header.header-transparent li a.active {
    color: #ffffff;
  }
  header.header-transparent.header-scrolled li a.active {
    color: var(--color-accent);
  }

  /* Mobile hamburger */
  .nav-toggle { display: none; }

  .nav-toggle-label {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle-label span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text-main);
    transition: all var(--transition-base);
  }

  header.header-transparent .nav-toggle-label span {
    background: #ffffff;
  }
  header.header-transparent.header-scrolled .nav-toggle-label span {
    background: var(--color-text-main);
  }

  @media (max-width: 768px) {
    .nav-toggle-label { display: flex; }

    ul {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
    }

    .nav-toggle:checked ~ ul { display: flex; }

    li a { display: block; padding: 0.5rem 0; }

    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }
    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    .header-actions {
      margin-left: auto;
      margin-right: 1rem;
    }

    /* ── Mobile nav open: force solid background over hero ── */
    header:has(#nav-toggle:checked),
    header.nav-open {
      background: color-mix(in srgb, var(--color-bg-canvas) 98%, transparent) !important;
      backdrop-filter: blur(12px);
      border-bottom-color: var(--color-border) !important;
      z-index: 10000 !important;
    }

    header:has(#nav-toggle:checked) .logo,
    header.nav-open .logo {
      color: var(--color-accent) !important;
    }

    header:has(#nav-toggle:checked) li a,
    header.nav-open li a {
      color: var(--color-text-main) !important;
    }

    header:has(#nav-toggle:checked) li a.active,
    header.nav-open li a.active {
      color: var(--color-accent) !important;
    }

    header:has(#nav-toggle:checked) .nav-toggle-label span,
    header.nav-open .nav-toggle-label span {
      background: var(--color-text-main) !important;
    }

    header:has(#nav-toggle:checked) .lang-toggle,
    header.nav-open .lang-toggle {
      color: var(--color-text-main) !important;
    }
  }

  /* Theme toggle button */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    color: var(--color-text-main);
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--color-accent);
    background: rgba(0, 0, 0, 0.05);
  }

  .theme-toggle svg {
    width: 18px;
    height: 18px;
  }

  /* Light mode: show moon, hide sun */
  .icon-sun { display: none; }
  .icon-moon { display: block; }

  /* Dark mode: show sun, hide moon */
  :global(:root.dark) .icon-sun { display: block; }
  :global(:root.dark) .icon-moon { display: none; }

  /* Transparent header: white icon */
  header.header-transparent .theme-toggle { color: rgba(255, 255, 255, 0.9); }
  header.header-transparent .theme-toggle:hover { color: #ffffff; background: rgba(255, 255, 255, 0.15); }
  header.header-transparent.header-scrolled .theme-toggle { color: var(--color-text-main); }
  header.header-transparent.header-scrolled .theme-toggle:hover { color: var(--color-accent); background: rgba(0, 0, 0, 0.05); }

  /* Language switcher */
  .lang-dropdown {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  header.header-transparent .lang-toggle {
    color: rgba(255, 255, 255, 0.9);
  }
  header.header-transparent.header-scrolled .lang-toggle {
    color: var(--color-text-main);
  }

  /* Search icon: white in transparent mode */
  header.header-transparent :global(.global-search-trigger) {
    color: rgba(255, 255, 255, 0.9);
  }
  header.header-transparent :global(.global-search-trigger:hover) {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.15);
  }
  header.header-transparent.header-scrolled :global(.global-search-trigger) {
    color: var(--color-text-main);
  }
  header.header-transparent.header-scrolled :global(.global-search-trigger:hover) {
    color: var(--color-primary);
    background: rgba(0, 0, 0, 0.05);
  }

  .arrow-icon {
    width: 12px;
    height: 12px;
    transition: transform var(--transition-fast);
    margin-top: 1px;
    opacity: 0.7;
  }

  .lang-dropdown.open .arrow-icon { transform: rotate(180deg); }

  .lang-menu {
    position: absolute;
    top: 100%;
    right: 0;
    background: var(--color-bg-canvas);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    /* top padding bridges the visual gap so no hover dead-zone */
    padding: 0.5rem 0 0.25rem;
    display: none;
    flex-direction: column;
    min-width: 60px;
    z-index: 101;
  }

  .lang-dropdown.open .lang-menu { display: flex; }

  .lang-link {
    display: block;
    padding: 0.4rem 0.8rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-text-main);
    text-decoration: none;
    text-align: center;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .lang-link:hover {
    background: var(--color-bg-secondary);
    color: var(--color-accent);
  }

  .lang-link.active {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
