---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../lib/i18n';

interface Props {
  events: CollectionEntry<'events'>[];
  lang: Locale;
  heroEventId?: string;
}

const { events, lang, heroEventId } = Astro.props;

// Exclude the hero event from this section to avoid duplication
const cards = events.filter((e) => e.id !== heroEventId);

const heading = lang === 'zh' ? '即将到来' : lang === 'de' ? 'Nächste Events' : 'Upcoming Events';
const typeLabels: Record<string, string> = {
  'training-camp': lang === 'zh' ? '训练营' : lang === 'de' ? 'Trainingslager' : 'Training Camp',
  'social-ride': lang === 'zh' ? '休闲骑' : lang === 'de' ? 'Social Ride' : 'Social Ride',
  'race': lang === 'zh' ? '比赛' : lang === 'de' ? 'Rennen' : 'Race',
  'workshop': lang === 'zh' ? '工作坊' : lang === 'de' ? 'Workshop' : 'Workshop',
};

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString(
    lang === 'zh' ? 'zh-CN' : lang === 'de' ? 'de-DE' : 'en-GB',
    { month: 'short', day: 'numeric' }
  );
}
---

{cards.length > 0 && (
  <section class="upcoming-section">
    <h2 class="section-heading">{heading}</h2>
    <div class="upcoming-grid">
      {cards.map((event) => {
        return (
          <a href={`/${lang}/events/${event.data.slug}`} class="upcoming-card">
            {event.data.coverImage && (
              <div class="upcoming-card-img" style={`background-image: url('${event.data.coverImage}')`}></div>
            )}
            <div class="upcoming-card-body">
              <span class="upcoming-type">{typeLabels[event.data.eventType] ?? event.data.eventType}</span>
              <h3>{event.data.title}</h3>
              <p class="upcoming-meta">{formatDate(event.data.date)} · {event.data.location}</p>
              {event.data.description && <p class="upcoming-desc">{event.data.description}</p>}
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .upcoming-section {
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .section-heading {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .upcoming-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .upcoming-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-bg-canvas);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--color-text-main);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .upcoming-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    color: var(--color-text-main);
  }

  .upcoming-card-img {
    height: 160px;
    background-size: cover;
    background-position: center;
    background-color: var(--color-bg-secondary);
  }

  .upcoming-card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .upcoming-type {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .upcoming-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.3;
  }

  .upcoming-meta {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .upcoming-desc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin-top: 0.25rem;
  }
</style>
