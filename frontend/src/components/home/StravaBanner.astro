---
// src/components/home/StravaBanner.astro
import { t, type Locale } from "../../lib/i18n";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;

const STRAVA_CLUB_URL = "https://www.strava.com/clubs/accmunich";
---

<section class="strava-editorial">
    <div class="strava-editorial-inner">
        <div class="strava-accent-bar"></div>

        <div class="strava-content">
            <div class="strava-left">
                <div class="strava-eyebrow">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="#FC4C02"
                        aria-hidden="true"
                    >
                        <path
                            d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"
                        ></path>
                    </svg>
                    <span>STRAVA COMMUNITY</span>
                </div>
                <h2 class="strava-heading">{t(lang, "home.strava.title")}</h2>
                <p class="strava-body">{t(lang, "home.strava.subtitle")}</p>
                <p class="strava-meta">{t(lang, "home.strava.meta")}</p>
            </div>

            <div class="strava-actions">
                <a
                    href={STRAVA_CLUB_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-strava-primary"
                >
                    {t(lang, "home.strava.leaderboard")}
                </a>
                <a
                    href={STRAVA_CLUB_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-strava-outline"
                >
                    {t(lang, "home.strava.join")}
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .strava-editorial {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        background: #1a1a1a;
    }

    .strava-editorial-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--space-xl) var(--space-md);
        display: flex;
        gap: var(--space-lg);
        align-items: stretch;
    }

    /* Orange left accent bar */
    .strava-accent-bar {
        flex-shrink: 0;
        width: 4px;
        background: #fc4c02;
        border-radius: 2px;
    }

    .strava-content {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-xl);
    }

    /* --- Left text --- */
    .strava-left {
        flex: 1;
    }

    .strava-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-heading);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        color: #fc4c02;
        text-transform: uppercase;
        margin-bottom: var(--space-sm);
    }

    .strava-heading {
        font-family: var(--font-heading);
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 700;
        color: #ffffff;
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0 0 var(--space-sm);
    }

    .strava-body {
        font-family: var(--font-body);
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.6);
        line-height: 1.6;
        margin: 0 0 var(--space-sm);
        max-width: 460px;
    }

    .strava-meta {
        font-family: var(--font-heading);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: rgba(255, 255, 255, 0.35);
        text-transform: uppercase;
        margin: 0;
    }

    /* --- Right CTAs --- */
    .strava-actions {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        align-items: flex-end;
        flex-shrink: 0;
    }

    .btn-strava-primary {
        display: inline-block;
        background: #fc4c02;
        color: #ffffff;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        padding: 0.75rem 2rem;
        border-radius: var(--radius-btn);
        text-decoration: none;
        white-space: nowrap;
        transition:
            background var(--transition-fast),
            transform var(--transition-fast),
            box-shadow var(--transition-fast);
        box-shadow: 0 4px 16px rgba(252, 76, 2, 0.35);
    }

    .btn-strava-primary:hover {
        background: #e04400;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(252, 76, 2, 0.5);
        color: #ffffff;
        text-decoration: none;
    }

    .btn-strava-outline {
        display: inline-block;
        background: transparent;
        color: rgba(255, 255, 255, 0.75);
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        padding: 0.65rem 1.8rem;
        border-radius: var(--radius-btn);
        border: 1.5px solid rgba(255, 255, 255, 0.25);
        text-decoration: none;
        white-space: nowrap;
        transition:
            border-color var(--transition-fast),
            color var(--transition-fast),
            transform var(--transition-fast);
    }

    .btn-strava-outline:hover {
        border-color: rgba(255, 255, 255, 0.6);
        color: #ffffff;
        transform: translateY(-2px);
        text-decoration: none;
    }

    @media (max-width: 680px) {
        .strava-content {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-lg);
        }

        .strava-actions {
            align-items: flex-start;
            flex-direction: row;
            flex-wrap: wrap;
        }
    }
</style>
