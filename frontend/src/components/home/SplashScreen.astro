---
// SplashScreen.astro — ACC brand intro animation, homepage only
// Sequence: wheel rolls in → "Across Cycling Club" → abbreviates to "ACC ClubHub"
// Shows once per browser session via sessionStorage
---

<div class="splash" id="acc-splash" aria-hidden="true">
    <!-- Wheel: rolls in from left, decelerates to center -->
    <div class="splash-logo">
        <img
            src="/images/transparent_red_logo.png"
            alt=""
            aria-hidden="true"
            draggable="false"
        />
    </div>

    <!--
        Text stack: absolute-positioned layers prevent layout shift
        Phase 1: full name "Across Cycling Club"
        Phase 2: abbreviation "ACC ClubHub" + tagline
    -->
    <div class="splash-text-stack">
        <!-- Phase 1: full club name -->
        <div class="splash-phase-1">
            <p class="splash-fullname">Across Cycling Club</p>
        </div>

        <!-- Phase 2: abbreviation + tagline -->
        <div class="splash-phase-2">
            <h1 class="splash-name">ACC ClubHub</h1>
            <p class="splash-tagline">Ride free, ride together.</p>
        </div>
    </div>

    <!-- Progress bar — fills over 3s -->
    <div class="splash-progress">
        <div class="splash-progress-bar"></div>
    </div>
</div>

<style>
    .splash {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: var(--color-bg-canvas);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        pointer-events: none;
        opacity: 1;
        transition: opacity 0.5s ease;
    }

    /* ---- Wheel ---- */
    .splash-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .splash-logo img {
        width: min(40vw, 300px);
        height: auto;
        user-select: none;
        opacity: 0;
        transform: translateX(-50vw) rotate(0deg);
        /* rolls in over 0.9s, then holds at opacity 0.42 */
        animation: wheel-roll-in 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }

    /* ---- Text stack ---- */
    .splash-text-stack {
        position: relative;
        width: 100%;
        /* fixed height prevents layout shift when phase changes */
        height: 5rem;
        text-align: center;
    }

    /* Both phases sit on top of each other */
    .splash-phase-1,
    .splash-phase-2 {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
    }

    /* Phase 1: "Across Cycling Club" — fades in, then fades out */
    .splash-fullname {
        font-family: var(--font-heading);
        font-size: clamp(0.85rem, 2.2vw, 1.1rem);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--color-text-secondary);
        margin: 0;
        opacity: 0;
        /* appear at 0.9s, disappear at 1.8s */
        animation:
            content-in  0.35s 0.9s  ease forwards,
            content-out 0.25s 1.75s ease forwards;
    }

    /* Phase 2: "ACC ClubHub" — fades in after full name vanishes */
    .splash-name {
        font-family: var(--font-heading);
        font-size: clamp(1.8rem, 5vw, 3rem);
        font-weight: 700;
        color: var(--color-accent);
        letter-spacing: -0.02em;
        line-height: 1;
        margin: 0;
        opacity: 0;
        animation: content-in 0.35s 2.05s ease forwards;
    }

    .splash-tagline {
        font-family: var(--font-body);
        font-size: clamp(0.8rem, 1.8vw, 0.95rem);
        color: var(--color-text-secondary);
        letter-spacing: 0.02em;
        margin: 0;
        opacity: 0;
        animation: content-in 0.35s 2.3s ease forwards;
    }

    /* ---- Progress bar (3 s fill) ---- */
    .splash-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--color-border);
        overflow: hidden;
    }

    .splash-progress-bar {
        height: 100%;
        width: 0%;
        background: var(--color-accent);
        animation: progress-fill 3s linear forwards;
    }

    /* ---- Keyframes ---- */

    /* Wheel rolls in from left with natural deceleration */
    @keyframes wheel-roll-in {
        0% {
            opacity: 0;
            transform: translateX(-50vw) rotate(0deg);
        }
        12% {
            opacity: 0.42;
        }
        100% {
            opacity: 0.42;
            transform: translateX(0) rotate(720deg);
        }
    }

    @keyframes content-in {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0);   }
    }

    @keyframes content-out {
        from { opacity: 1; transform: translateY(0);    }
        to   { opacity: 0; transform: translateY(-6px); }
    }

    @keyframes progress-fill {
        from { width: 0%; }
        to   { width: 100%; }
    }
</style>

<script>
    (function () {
        const splash = document.getElementById("acc-splash");
        if (!splash) return;

        // Only show once per browser session
        if (sessionStorage.getItem("acc-splash-shown")) {
            splash.remove();
            return;
        }

        sessionStorage.setItem("acc-splash-shown", "1");

        // Total visible duration: 3 s, then 0.5 s fade-out
        setTimeout(function () {
            splash.style.opacity = "0";
            setTimeout(function () {
                splash.remove();
            }, 500);
        }, 3000);
    })();
</script>
