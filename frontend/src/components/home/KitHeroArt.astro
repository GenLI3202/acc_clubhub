---
// components/home/KitHeroArt.astro
// Background of the home hero's kit slide: the jersey's own motif painted
// large. Layered ink ridgelines, the vermilion strokes, the winding grey road
// and a 平安 seal, with the model photo fading in from the right.
// The lines are drawn like brush strokes each time the slide comes in.

import { ridgePath, type RidgeOptions } from '../../lib/home/ridgeline';

const WIDTH = 1600;
const HEIGHT = 900;
const SPAN = { startX: -40, endX: WIDTH + 40 };

interface Ridge extends RidgeOptions {
  readonly tone: 'far' | 'mid' | 'near' | 'red';
  readonly width: number;
  readonly opacity: number;
  /** Fill the ground below the line with a faint ink wash. */
  readonly wash?: boolean;
  /** Draw-in delay, in seconds. */
  readonly delay: number;
}

const RIDGES: readonly Ridge[] = [
  { ...SPAN, baseY: 430, amplitude: 170, peaks: 7, seed: 3, tone: 'far', width: 1.3, opacity: 0.3, delay: 0 },
  { ...SPAN, baseY: 480, amplitude: 150, peaks: 6, seed: 11, tone: 'far', width: 1.4, opacity: 0.38, wash: true, delay: 0.25 },
  { ...SPAN, baseY: 570, amplitude: 140, peaks: 5, seed: 21, tone: 'mid', width: 1.7, opacity: 0.5, wash: true, delay: 0.5 },
  { startX: 120, endX: 1060, baseY: 610, amplitude: 70, peaks: 4, seed: 5, tone: 'red', width: 2.6, opacity: 0.9, delay: 0.9 },
  { ...SPAN, baseY: 700, amplitude: 90, peaks: 5, seed: 31, tone: 'near', width: 1.9, opacity: 0.55, wash: true, delay: 0.75 },
  { startX: 560, endX: 1240, baseY: 735, amplitude: 45, peaks: 3, seed: 9, tone: 'red', width: 2.2, opacity: 0.75, delay: 1.2 },
];

const ridges = RIDGES.map((ridge) => {
  const line = ridgePath(ridge);
  return {
    ...ridge,
    line,
    wash: ridge.wash ? `${line} L${ridge.endX} ${HEIGHT} L${ridge.startX} ${HEIGHT} Z` : null,
  };
});

// The grey road of the jersey, climbing out of the dark ground into the hills.
const ROAD = 'M150 900 C70 850 250 810 170 760 S80 690 160 640 S250 590 190 555 S140 525 175 500';
---

<div class="kit-art" aria-hidden="true">
  <svg class="kit-art-svg" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} preserveAspectRatio="xMidYMax slice">
    <defs>
      <radialGradient id="kitArtSun" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#e2553a" stop-opacity="0.55" />
        <stop offset="0.55" stop-color="#e2553a" stop-opacity="0.22" />
        <stop offset="1" stop-color="#c62828" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="kitArtWash" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#8d949c" stop-opacity="0.1" />
        <stop offset="1" stop-color="#8d949c" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="kitArtRoad" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#6f7781" stop-opacity="0.45" />
        <stop offset="1" stop-color="#6f7781" stop-opacity="0.05" />
      </linearGradient>
      <!-- Roughens line edges so they read as ink on paper, not vector strokes. -->
      <filter id="kitArtInk" x="-5%" y="-20%" width="110%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" />
        <feDisplacementMap in="SourceGraphic" scale="5" />
      </filter>
      <filter id="kitArtBlur" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="28" />
      </filter>
    </defs>

    <rect class="kit-art-ground" width={WIDTH} height={HEIGHT} />
    <circle class="kit-art-sun" cx="640" cy="200" r="140" fill="url(#kitArtSun)" />

    <g class="kit-art-mist" filter="url(#kitArtBlur)">
      <ellipse cx="380" cy="470" rx="320" ry="38" fill="#8d949c" opacity="0.08" />
      <ellipse cx="900" cy="560" rx="360" ry="42" fill="#8d949c" opacity="0.06" />
    </g>

    {ridges.map((ridge) => (
      <g
        class:list={['kit-art-ridge', `kit-art-ridge--${ridge.tone}`]}
        filter={ridge.tone === 'far' ? undefined : 'url(#kitArtInk)'}
      >
        {ridge.wash && <path class="kit-art-wash" d={ridge.wash} fill="url(#kitArtWash)" />}
        <path
          class="kit-art-line"
          d={ridge.line}
          pathLength="1"
          fill="none"
          stroke-width={ridge.width}
          stroke-opacity={ridge.opacity}
          stroke-linecap="round"
          stroke-linejoin="round"
          style={`--delay: ${ridge.delay}s`}
        />
      </g>
    ))}

    <path
      class="kit-art-line kit-art-road"
      d={ROAD}
      pathLength="1"
      fill="none"
      stroke="url(#kitArtRoad)"
      stroke-width="9"
      stroke-linecap="round"
      style="--delay: 1.4s"
    />

    <g transform="translate(760 330) rotate(-4)">
      <g class="kit-art-seal">
        <rect x="-30" y="-46" width="60" height="92" rx="7" fill="#c62828" />
        <rect x="-25" y="-41" width="50" height="82" rx="5" fill="none" stroke="#f6d9d2" stroke-opacity="0.55" stroke-width="1.5" />
        <text x="0" y="-8" text-anchor="middle" font-size="30" fill="#fff4f0">平</text>
        <text x="0" y="30" text-anchor="middle" font-size="30" fill="#fff4f0">安</text>
      </g>
    </g>
  </svg>

  <img class="kit-art-photo" src="/images/uniform/model-left.webp" alt="" width="1086" height="1448" decoding="async" />
</div>

<style>
  .kit-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-bg-canvas);
  }

  .kit-art-ground {
    fill: var(--color-bg-canvas);
  }

  .kit-art-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .kit-art-seal text {
    font-family: 'STKaiti', 'KaiTi', 'Kaiti SC', serif;
    font-weight: 700;
  }

  /* Grey ink, paler with distance, as on the jersey. */
  .kit-art-ridge--far .kit-art-line { stroke: #9ea5ae; }
  .kit-art-ridge--mid .kit-art-line { stroke: #7b838d; }
  .kit-art-ridge--near .kit-art-line { stroke: #555c66; }
  .kit-art-ridge--red .kit-art-line { stroke: #d9542b; }

  /* The photo stands on the right and dissolves into the painting: a wide
     fade on the left, softer ones top and bottom. */
  .kit-art-photo {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 46%;
    object-fit: cover;
    object-position: center 30%;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 45%),
      linear-gradient(to bottom, transparent 0%, #000 14%, #000 82%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, #000 45%),
      linear-gradient(to bottom, transparent 0%, #000 14%, #000 82%, transparent 100%);
    mask-composite: intersect;
  }

  /* ---- Motion: only while the slide is showing ---- */
  .kit-art-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(.hero-slide.active) .kit-art-line {
    animation: kit-art-draw 2.6s cubic-bezier(0.6, 0.05, 0.3, 1) var(--delay, 0s) forwards;
  }
  .kit-art-seal {
    opacity: 0;
  }
  :global(.hero-slide.active) .kit-art-seal {
    animation: kit-art-stamp 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) 2s forwards;
  }
  :global(.hero-slide.active) .kit-art-sun {
    animation: kit-art-glow 6s ease-in-out infinite alternate;
  }
  :global(.hero-slide.active) .kit-art-ridge--far {
    animation: kit-art-drift 36s ease-in-out infinite alternate;
  }
  :global(.hero-slide.active) .kit-art-mist {
    animation: kit-art-drift-mist 24s ease-in-out infinite alternate;
  }
  :global(.hero-slide.active) .kit-art-photo {
    animation: kit-art-push 14s ease-out forwards;
  }

  @keyframes kit-art-draw {
    to { stroke-dashoffset: 0; }
  }
  /* The outer <g> places the seal; this inner one only scales around its own centre. */
  @keyframes kit-art-stamp {
    from { opacity: 0; transform: scale(1.6); }
    to { opacity: 0.95; transform: scale(1); }
  }
  @keyframes kit-art-glow {
    from { opacity: 0.75; }
    to { opacity: 1; }
  }
  @keyframes kit-art-drift {
    to { transform: translateX(-40px); }
  }
  @keyframes kit-art-drift-mist {
    to { transform: translateX(90px); }
  }
  @keyframes kit-art-push {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }

  /* On phones the photo carries the slide on its own. */
  /* On phones the photo fills the top and fades into the page colour, so the
     dark copy below sits on a clean ground. */
  @media (max-width: 640px) {
    .kit-art-svg { display: none; }
    .kit-art-photo {
      width: 100%;
      height: 62%;
      object-position: center 25%;
      -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kit-art-line { stroke-dashoffset: 0; }
    .kit-art-seal { opacity: 0.95; }
    :global(.hero-slide.active) :is(.kit-art-line, .kit-art-seal, .kit-art-sun, .kit-art-ridge--far, .kit-art-mist, .kit-art-photo) {
      animation: none;
    }
  }
</style>
