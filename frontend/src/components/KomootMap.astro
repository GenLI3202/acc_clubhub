---
/**
 * KomootMap.astro — Interactive Leaflet map for Komoot routes.
 * Props:
 *   coords: Array of [lat, lng] pairs (simplified route polyline)
 *   tourUrl: Full Komoot tour URL for the "View on Komoot" link
 *   height?: CSS height value (default "500px")
 */
interface Props {
  coords: number[][];
  tourUrl: string;
  height?: string;
}

const { coords, tourUrl, height = "500px" } = Astro.props;
const mapId = `komoot-map-${Math.random().toString(36).slice(2, 8)}`;
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<div class="komoot-map-wrapper">
  <div id={mapId} class="komoot-map" style={`height: ${height};`}></div>
  <div class="komoot-map-link">
    <a href={tourUrl} target="_blank" rel="noopener noreferrer">
      🗺️ Auf Komoot ansehen →
    </a>
  </div>
</div>

<script define:vars={{ mapId, coords }}>
  function initMap() {
    if (typeof L === "undefined") {
      // Leaflet not loaded yet, wait for it
      setTimeout(initMap, 100);
      return;
    }

    const map = L.map(mapId, {
      scrollWheelZoom: true,
      zoomControl: true,
      dragging: true,
      touchZoom: true,
      doubleClickZoom: true,
    });

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18,
    }).addTo(map);

    const polyline = L.polyline(coords, {
      color: "#e6500a",
      weight: 4,
      opacity: 0.85,
    }).addTo(map);

    // Add start/end markers
    if (coords.length > 0) {
      const startIcon = L.divIcon({
        html: '<div style="background:#1a7f37;color:white;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:12px;border:2px solid white;box-shadow:0 2px 4px rgba(0,0,0,.3);">A</div>',
        iconSize: [24, 24],
        iconAnchor: [12, 12],
        className: "",
      });
      const endIcon = L.divIcon({
        html: '<div style="background:#cf222e;color:white;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:12px;border:2px solid white;box-shadow:0 2px 4px rgba(0,0,0,.3);">B</div>',
        iconSize: [24, 24],
        iconAnchor: [12, 12],
        className: "",
      });
      L.marker(coords[0], { icon: startIcon }).addTo(map);
      L.marker(coords[coords.length - 1], { icon: endIcon }).addTo(map);
    }

    map.fitBounds(polyline.getBounds(), { padding: [30, 30] });
  }

  // Load Leaflet JS dynamically if not present
  if (typeof L === "undefined") {
    const script = document.createElement("script");
    script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
    script.integrity = "sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=";
    script.crossOrigin = "";
    script.onload = initMap;
    document.head.appendChild(script);
  } else {
    initMap();
  }
</script>

<style>
  .komoot-map-wrapper {
    margin: 1.5rem 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border-rough, #d0d7de);
  }
  .komoot-map {
    width: 100%;
    z-index: 0;
  }
  .komoot-map-link {
    padding: 0.6rem 1rem;
    background: #f6f8fa;
    border-top: 1px solid var(--color-border-rough, #d0d7de);
    font-size: 0.85rem;
  }
  .komoot-map-link a {
    color: var(--color-accent, #0969da);
    text-decoration: none;
    font-weight: 500;
  }
  .komoot-map-link a:hover {
    text-decoration: underline;
  }
</style>
