---
// src/components/WalineComments.astro
// Phase 4.2: Waline 评论组件

import { t, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// Waline 语言映射
const walineLangMap: Record<string, string> = {
  zh: 'zh-CN',
  en: 'en',
  de: 'de',
};
const walineLang = walineLangMap[lang] || 'en';

// Waline 服务端 URL（从环境变量读取，默认为开发环境）
const walineServerUrl = import.meta.env.PUBLIC_WALINE_SERVER_URL || 'https://acc-clubhub-waline.vercel.app';
---

<section class="comments-section">
  <h2>{t(lang, 'comments.title')}</h2>
  <p class="comments-desc">{t(lang, 'comments.description')}</p>
  <div class="waline-wrapper" id="waline"></div>
</section>

<!-- Waline 客户端脚本 -->
<script>
  import { init } from '@waline/client';

  const walineServerURL = '{walineServerUrl}';
  const walineLang = '{walineLang}';

  init({
    el: '#waline',
    serverURL: walineServerURL,
    lang: walineLang,
    requiredMeta: ['nick', 'mail'],
    dark: 'html[data-theme="dark"]',
  });
</script>

<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid var(--color-border-rough);
  }

  .comments-section h2 {
    font-family: var(--font-heading);
    color: var(--color-primary);
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .comments-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 0;
  }

  .waline-wrapper {
    margin-top: 1.5rem;
    min-height: 200px;
  }

  /* Waline 样式覆盖 - 匹配 Blaue Reiter V3 */
  .waline-wrapper :global(.waline-editor) {
    --waline-theme-color: var(--color-primary);
    --waline-active-color: var(--color-accent);
  }

  .waline-wrapper :global(.wl-btn) {
    background: var(--color-primary);
    color: white;
    font-family: var(--font-heading);
    font-weight: 600;
    border: 2px solid var(--color-border-rough);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .waline-wrapper :global(.wl-btn:hover) {
    background: var(--color-accent);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 var(--color-border-rough);
  }
</style>
