---
import RouteMapLeaflet from './RouteMapLeaflet';

interface Props {
  geojson: any;
  title?: string;
  komootUrl?: string;
  stravaUrl?: string;
  height?: number;
}

const {
  geojson,
  title = 'Route map',
  komootUrl,
  stravaUrl,
  height = 420,
} = Astro.props;
---

<RouteMapLeaflet
  client:load
  geojson={geojson}
  title={title}
  komootUrl={komootUrl}
  stravaUrl={stravaUrl}
  height={height}
/>

<style is:global>
  .route-map-card {
    margin: 2rem 0;
    padding: 1rem;
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 16px;
    background: #fff;
  }

  .route-map-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .route-map-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .route-map-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .route-map-leaflet {
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #d8dee4;
    background: #f6f8f7;
  }

  .route-map-leaflet .leaflet-container {
    width: 100%;
    height: 100%;
    font: inherit;
  }

  .route-map-leaflet .leaflet-control-attribution {
    font-size: 11px;
  }
</style>
