---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { locales, t, type Locale } from "../../lib/i18n";
import { SPONSORS_MAIN, SPONSORS_PARTNERS } from "../../data/sponsors";
import PartnerLogo from "../../components/sponsors/PartnerLogo.astro";

export function getStaticPaths() {
    return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const pageTitle = t(lang, "nav.partners");

const mainSponsorData = SPONSORS_MAIN.map((s) => ({
    ...s,
    cat: t(lang, s.catKey as Parameters<typeof t>[1]),
    blurb: t(lang, s.blurbKey as Parameters<typeof t>[1]),
    sealTopId: `seal-top-${s.id}`,
    sinceLabel: t(lang, "partners.since"),
}));

const partnerData = SPONSORS_PARTNERS.map((s) => ({
    ...s,
    cat: t(lang, s.catKey as Parameters<typeof t>[1]),
}));
---

<BaseLayout title={pageTitle} lang={lang}>
    <main class="partners-page">

        {/* ============================================================
            1. EDITORIAL HEADER
           ============================================================ */}
        <section class="partners-hero">
            <img
                src="/images/sponsors/logo-stamp-red-transparent.png"
                class="hero-watermark"
                alt=""
                aria-hidden="true"
            />
            <div class="hero-inner">
                <div class="hero-eyebrow">{t(lang, "partners.eyebrow")}</div>
                <h1 class="hero-title">{t(lang, "partners.title")}</h1>
                <div class="hero-rule" aria-hidden="true"></div>
                <p class="hero-lede">
                    {t(lang, "partners.lede1")}<br />
                    {t(lang, "partners.lede2")}
                </p>
            </div>
        </section>

        {/* ============================================================
            2. OFFICIAL PARTNERS — 2-col card grid
           ============================================================ */}
        <section class="section-main-sponsors">
            <div class="section-inner">
                <div class="section-label" aria-label={t(lang, "partners.officialPartners")}>
                    <span class="section-label-rule" aria-hidden="true"></span>
                    <span class="section-label-text">{t(lang, "partners.officialPartners")}</span>
                    <span class="section-label-rule" aria-hidden="true"></span>
                </div>
                <div class="main-sponsors-grid">
                    {mainSponsorData.map((s) => (
                        <div class="main-sponsor-card">
                            <div class="card-top">
                                <div class="card-eyebrow">
                                    OFFICIAL · {s.cat.toUpperCase()} · {s.sinceLabel.toUpperCase()} {s.since}
                                </div>
                                <div class="corner-seal" aria-hidden="true">
                                    <svg width="78" height="78" viewBox="0 0 78 78">
                                        <defs>
                                            <path id={s.sealTopId} d="M 39,39 m -28,0 a 28,28 0 1,1 56,0" fill="none" />
                                        </defs>
                                        <circle cx="37.5" cy="37.5" r="36" fill="none" stroke="var(--color-accent)" stroke-width="1.2" opacity="0.9" />
                                        <circle cx="37.5" cy="37.5" r="27" fill="none" stroke="var(--color-accent)" stroke-width="0.8" opacity="0.6" />
                                        <text font-family="Jost, sans-serif" font-weight="600" font-size="5.4" letter-spacing="2" fill="var(--color-accent)">
                                            <textPath href={"#" + s.sealTopId} startOffset="50%" text-anchor="middle">
                                                ACC · OFFICIAL PARTNER
                                            </textPath>
                                        </text>
                                        <text x="37.5" y="34" text-anchor="middle" font-family="Jost, sans-serif" font-weight="700" font-size="13" letter-spacing="0.04em" fill="var(--color-accent)" dominant-baseline="middle">ACC</text>
                                        <text x="37.5" y="45" text-anchor="middle" font-family="Jost, sans-serif" font-weight="500" font-size="8" letter-spacing="0.08em" fill="var(--color-accent)" opacity="0.85" font-style="italic" dominant-baseline="middle">{s.sinceLabel} {s.since}</text>
                                    </svg>
                                </div>
                            </div>
                            <div class="card-logo-well">
                                <img src={s.logoFull} alt={s.name} class="card-logo-img" />
                            </div>
                            <div class="card-footer">
                                <div class="card-footer-text">
                                    <div class="card-name">{s.name}</div>
                                    <div class="card-blurb">{s.blurb}</div>
                                </div>
                                <div class="card-arrow" aria-hidden="true">→</div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* ============================================================
            3. FRIENDS OF ACC — 4-col tile grid
           ============================================================ */}
        <section class="section-friends">
            <div class="section-inner">
                <div class="section-label">
                    <span class="section-label-rule" aria-hidden="true"></span>
                    <span class="section-label-text">{t(lang, "partners.friends")}</span>
                    <span class="section-label-rule" aria-hidden="true"></span>
                </div>
                <div class="friends-grid">
                    {partnerData.map((s, i) => (
                        <div class:list={["friend-tile", { "friend-tile--no-border": i === partnerData.length - 1 }]}>
                            <div class="friend-logo">
                                <PartnerLogo logoStyle={s.logoStyle} />
                            </div>
                            <div class="friend-cat">{s.cat}</div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* ============================================================
            4. BECOME A PARTNER — CTA
           ============================================================ */}
        <section class="section-cta">
            <div class="cta-inner">
                <div class="cta-eyebrow">{t(lang, "partners.becomePartner.eyebrow")}</div>
                <h2 class="cta-title">{t(lang, "partners.becomePartner.title")}</h2>
                <p class="cta-blurb">{t(lang, "partners.becomePartner.blurb")}</p>
                <div class="cta-buttons">
                    <a href="mailto:partners@across-cc.de" class="cta-btn cta-btn--primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="m22 7-10 5L2 7" />
                        </svg>
                        partners@across-cc.de
                    </a>
                    {/* TODO: replace href="#" with actual PDF when deck is ready */}
                    <a href="#" class="cta-btn cta-btn--ghost">
                        {t(lang, "partners.ctaDeck")} ↓
                    </a>
                </div>
            </div>
        </section>

    </main>
</BaseLayout>

<style>
    .partners-page {
        background: var(--color-bg-canvas);
    }

    /* ---- Hero ---- */
    .partners-hero {
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid var(--color-border);
    }

    .hero-watermark {
        position: absolute;
        right: -120px;
        top: -80px;
        width: 540px;
        height: 540px;
        opacity: 0.045;
        pointer-events: none;
        user-select: none;
    }

    :global(:root.dark) .hero-watermark {
        opacity: 0.06;
    }

    .hero-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 104px 32px 80px;
        text-align: center;
        position: relative;
    }

    .hero-eyebrow {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: 18px;
    }

    .hero-title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: clamp(48px, 6vw, 84px);
        letter-spacing: -0.035em;
        line-height: 1.0;
        margin: 0;
        color: var(--color-text-main);
    }

    .hero-rule {
        width: 56px;
        height: 3px;
        background: var(--color-accent);
        margin: 28px auto 0;
        border-radius: 2px;
    }

    .hero-lede {
        font-family: var(--font-body);
        font-size: 18px;
        font-weight: 300;
        color: var(--color-text-secondary);
        max-width: 640px;
        margin: 32px auto 0;
        line-height: 1.6;
    }

    /* ---- Section label (centred rule + text) ---- */
    .section-label {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 24px;
    }

    .section-label-rule {
        display: block;
        width: 80px;
        height: 1px;
        background: var(--color-primary);
        opacity: 0.8;
    }

    .section-label-text {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-primary);
    }

    /* ---- Official partners section ---- */
    .section-main-sponsors {
        background: var(--color-bg-canvas);
        border-bottom: 1px solid var(--color-border);
    }

    .section-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 80px 32px;
    }

    .main-sponsors-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 48px;
        margin-top: 56px;
    }

    .main-sponsor-card {
        background: var(--color-bg-canvas);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 32px 36px 28px;
        box-shadow: var(--shadow-sm);
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 420px;
        transition: transform 250ms ease, box-shadow 250ms ease;
    }

    .main-sponsor-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--color-border);
    }

    .card-eyebrow {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-accent);
        padding-top: 8px;
    }

    .corner-seal {
        flex-shrink: 0;
        width: 78px;
        height: 78px;
    }

    .card-logo-well {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 44px 12px;
        min-height: 200px;
    }

    .card-logo-img {
        max-height: 140px;
        max-width: 360px;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
    }

    .card-footer {
        padding-top: 22px;
        border-top: 1px solid var(--color-border);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
    }

    .card-footer-text {
        flex: 1;
        min-width: 0;
    }

    .card-name {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 16px;
        letter-spacing: -0.01em;
        color: var(--color-text-main);
        margin-bottom: 6px;
    }

    .card-blurb {
        font-family: var(--font-body);
        font-size: 14px;
        color: var(--color-text-secondary);
        line-height: 1.55;
        max-width: 48ch;
    }

    .card-arrow {
        font-family: var(--font-heading);
        font-size: 18px;
        color: var(--color-accent);
        flex-shrink: 0;
        margin-top: 2px;
    }

    /* ---- Friends section ---- */
    .section-friends {
        background: var(--color-bg-secondary);
        border-bottom: 1px solid var(--color-border);
    }

    .friends-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        border: 1px solid var(--color-border);
        background: var(--color-bg-canvas);
        border-radius: var(--radius-card);
        overflow: hidden;
        margin-top: 56px;
    }

    .friend-tile {
        padding: 56px 32px 32px;
        border-right: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        min-height: 200px;
        transition: background 200ms ease;
    }

    .friend-tile:hover {
        background: var(--color-bg-tint);
    }

    .friend-tile--no-border {
        border-right: none;
    }

    .friend-logo {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary);
        font-size: 16px;
        opacity: 0.78;
        transition: opacity 200ms ease, filter 200ms ease;
        filter: grayscale(0.6);
    }

    .friend-tile:hover .friend-logo {
        opacity: 1;
        filter: grayscale(0);
    }

    .friend-cat {
        margin-top: 24px;
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 10.5px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
        text-align: center;
    }

    /* ---- CTA section ---- */
    .section-cta {
        background: var(--color-bg-canvas);
    }

    .cta-inner {
        max-width: 720px;
        margin: 0 auto;
        padding: 96px 32px;
        text-align: center;
    }

    .cta-eyebrow {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
        margin-bottom: 18px;
    }

    .cta-title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 44px;
        letter-spacing: -0.025em;
        line-height: 1.1;
        margin: 0;
        color: var(--color-text-main);
    }

    .cta-blurb {
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.7;
        color: var(--color-text-secondary);
        font-weight: 300;
        max-width: 560px;
        margin: 24px auto 0;
    }

    .cta-buttons {
        display: flex;
        justify-content: center;
        gap: 14px;
        margin-top: 40px;
        flex-wrap: wrap;
    }

    .cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 16px 30px;
        border-radius: var(--radius-btn);
        text-decoration: none;
        transition: background 200ms ease, transform 200ms ease, box-shadow 200ms ease;
        cursor: pointer;
    }

    .cta-btn--primary {
        background: var(--color-accent);
        color: #fff;
        border: none;
    }

    .cta-btn--primary:hover {
        background: var(--color-accent-dark);
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
        color: #fff;
    }

    .cta-btn--ghost {
        background: transparent;
        color: var(--color-text-main);
        border: 1.5px solid var(--color-border-strong);
    }

    .cta-btn--ghost:hover {
        background: var(--color-text-main);
        color: var(--color-bg-canvas);
        border-color: var(--color-text-main);
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
    }
</style>
