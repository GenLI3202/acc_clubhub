---
export const prerender = true;
// src/pages/[lang]/knowledge/training/index.astro
// Library-style training page: EditorialHero → Featured shelf → 4 CategoryShelves → FilterPanel + ArticleGrid

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { locales, getLangFromEntry, t, type Locale } from '../../../../lib/i18n';
import { getFilterLabel } from '../../../../lib/i18n/filterTranslations';
import EditorialHero from '../../../../components/editorial/EditorialHero.astro';
import SectionRule from '../../../../components/editorial/SectionRule.astro';
import FeaturedShelf from '../../../../components/editorial/FeaturedShelf.astro';
import CategoryShelf from '../../../../components/knowledge/CategoryShelf.astro';
import TrainingLibraryPage from '../../../../components/content/TrainingLibraryPage';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const allTraining = await getCollection('training');
const langTraining = allTraining.filter(
  (entry) => getLangFromEntry(entry.filePath, 'training') === lang && entry.data.status !== 'draft'
);
const sortedTraining = langTraining.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Featured shelf: top 3 items with featured: true
const featuredItems = sortedTraining
  .filter((e) => e.data.featured)
  .slice(0, 3)
  .map((e) => {
    const d = new Date(e.data.date);
    const meta = !isNaN(d.getTime())
      ? d.toLocaleDateString(
          lang === 'zh' ? 'zh-CN' : lang === 'de' ? 'de-DE' : 'en-GB',
          { month: 'short', day: 'numeric', year: 'numeric' },
        )
      : e.data.date;
    return {
      href: `/${lang}/knowledge/training/${e.data.slug}`,
      title: e.data.title,
      description: e.data.description,
      cover: e.data.coverImage,
      tagLabel: getFilterLabel('category', e.data.category, lang),
      meta,
    };
  });

// Category shelves: top 4 items per category
const CATEGORY_ORDER = ['safety', 'skills', 'physical', 'planning', 'wellness', 'analytics'] as const;
type TrainingCategory = (typeof CATEGORY_ORDER)[number];

const byCategory = Object.fromEntries(
  CATEGORY_ORDER.map((cat) => [cat, sortedTraining.filter((e) => e.data.category === cat).slice(0, 4)])
) as Record<TrainingCategory, typeof sortedTraining>;

const categoryTitles = Object.fromEntries(
  CATEGORY_ORDER.map((cat) => [cat, t(lang, `knowledge.training.category.${cat}`)])
) as Record<TrainingCategory, string>;

const categoryDescs = Object.fromEntries(
  CATEGORY_ORDER.map((cat) => [cat, t(lang, `knowledge.training.categoryDesc.${cat}`)])
) as Record<TrainingCategory, string>;

const pageTitle = t(lang, 'nav.training');
---

<BaseLayout title={pageTitle} lang={lang}>
  <article class="training-library-page">
    <EditorialHero
      eyebrow={t(lang, 'editorial.eyebrow.training')}
      title={pageTitle}
      subtitle={t(lang, 'knowledge.training.subtitle')}
    />

    {featuredItems.length > 0 && (
      <>
        <SectionRule label={t(lang, 'editorial.section.featured')} />
        <FeaturedShelf items={featuredItems} lang={lang} />
      </>
    )}

    {sortedTraining.length === 0 ? (
      <p class="training-empty">{t(lang, 'knowledge.training.empty')}</p>
    ) : (
      <>
        <SectionRule label={t(lang, 'editorial.section.byCategory')} />

        {CATEGORY_ORDER.map((cat) => (
          <CategoryShelf
            category={cat}
            items={byCategory[cat]}
            lang={lang}
            viewAllHref={`/${lang}/knowledge/training?category=${cat}#all-articles`}
            categoryTitle={categoryTitles[cat]}
            categoryDesc={categoryDescs[cat]}
          />
        ))}

        <SectionRule label={t(lang, 'editorial.section.allArticles')} />

        <TrainingLibraryPage
          client:load
          initialItems={sortedTraining}
          lang={lang}
        />
      </>
    )}
  </article>
</BaseLayout>

<style>
  .training-library-page {
    padding-bottom: 0;
  }

  /* Shown when a locale has no published articles yet, so the page reads as
     "in progress" rather than a stack of empty section rules. */
  .training-empty {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
    text-align: center;
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-text-muted, #6b6b6b);
  }
</style>
