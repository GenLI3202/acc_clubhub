---
export const prerender = true;
// src/pages/[lang]/knowledge/gear/index.astro
// Library-style gear page: EditorialHero, Featured shelf, CategoryShelves, ArticleGrid

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { locales, getLangFromEntry, t, type Locale } from '../../../../lib/i18n';
import { getFilterLabel } from '../../../../lib/i18n/filterTranslations';
import EditorialHero from '../../../../components/editorial/EditorialHero.astro';
import SectionRule from '../../../../components/editorial/SectionRule.astro';
import FeaturedShelf from '../../../../components/editorial/FeaturedShelf.astro';
import CategoryShelf from '../../../../components/knowledge/CategoryShelf.astro';
import GearLibraryPage from '../../../../components/content/GearLibraryPage';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const allGear = await getCollection('gear');
const langGear = allGear.filter(
  (entry) => getLangFromEntry(entry.filePath, 'gear') === lang && entry.data.status !== 'draft',
);
const sortedGear = langGear.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const featuredItems = sortedGear
  .filter((entry) => entry.data.featured)
  .slice(0, 3)
  .map((entry) => {
    const date = new Date(entry.data.date);
    const meta = !isNaN(date.getTime())
      ? date.toLocaleDateString(
          lang === 'zh' ? 'zh-CN' : lang === 'de' ? 'de-DE' : 'en-GB',
          { month: 'short', day: 'numeric', year: 'numeric' },
        )
      : entry.data.date;

    return {
      href: `/${lang}/knowledge/gear/${entry.data.slug}`,
      title: entry.data.title,
      description: entry.data.description,
      cover: entry.data.cover,
      tagLabel: getFilterLabel('category', entry.data.category ?? '', lang),
      meta,
    };
  });

const CATEGORY_ORDER = [
  'bike-build',
  'electronics',
  'apparel',
  'maintenance',
] as const;
type GearCategory = (typeof CATEGORY_ORDER)[number];

const byCategory: Record<GearCategory, typeof sortedGear> = {
  'bike-build': sortedGear
    .filter((entry) => entry.data.category === 'bike-build')
    .slice(0, 4),
  electronics: sortedGear
    .filter((entry) => entry.data.category === 'electronics')
    .slice(0, 4),
  apparel: sortedGear
    .filter((entry) => entry.data.category === 'apparel')
    .slice(0, 4),
  maintenance: sortedGear
    .filter((entry) => entry.data.category === 'maintenance')
    .slice(0, 4),
};

const categoryTitles: Record<GearCategory, string> = {
  'bike-build': t(lang, 'knowledge.gear.category.bike-build'),
  electronics: t(lang, 'knowledge.gear.category.electronics'),
  apparel: t(lang, 'knowledge.gear.category.apparel'),
  maintenance: t(lang, 'knowledge.gear.category.maintenance'),
};

const categoryDescs: Record<GearCategory, string> = {
  'bike-build': t(lang, 'knowledge.gear.categoryDesc.bike-build'),
  electronics: t(lang, 'knowledge.gear.categoryDesc.electronics'),
  apparel: t(lang, 'knowledge.gear.categoryDesc.apparel'),
  maintenance: t(lang, 'knowledge.gear.categoryDesc.maintenance'),
};

const pageTitle = t(lang, 'nav.gear');
---


<BaseLayout title={pageTitle} lang={lang}>
  <article class="gear-library-page">
    <EditorialHero
      eyebrow={t(lang, 'editorial.eyebrow.knowledge')}
      title={pageTitle}
      subtitle={t(lang, 'knowledge.gear.subtitle')}
    />

    {featuredItems.length > 0 && (
      <>
        <SectionRule label={t(lang, 'editorial.section.featured')} />
        <FeaturedShelf items={featuredItems} lang={lang} />
      </>
    )}

    <SectionRule label={t(lang, 'editorial.section.byCategory')} />

    {CATEGORY_ORDER.map((cat) => (
      <CategoryShelf
        category={cat}
        items={byCategory[cat]}
        lang={lang}
        viewAllHref={`/${lang}/knowledge/gear?category=${cat}#all-articles`}
        categoryTitle={categoryTitles[cat]}
        categoryDesc={categoryDescs[cat]}
        basePath="/knowledge/gear"
      />
    ))}

    <SectionRule label={t(lang, 'editorial.section.allArticles')} />

    <GearLibraryPage
      client:load
      initialItems={sortedGear}
      lang={lang}
    />
  </article>
</BaseLayout>

<style>
  .gear-library-page {
    padding-bottom: 0;
  }
</style>
