---
// src/pages/[lang]/events/[slug].astro
// 慕城日常 - 活动详情页 (Phase 4.3: with registration form)

import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { getLangFromEntry, t, type Locale } from '../../../lib/i18n';
import { getTodayAtMidnight } from '../../../lib/events/eventHelpers';
import { EventRegistrationForm } from '../../../components/EventRegistrationForm';
import '../../../components/EventRegistrationForm.css';
import SubscribeFloatingBanner from '../../../components/SubscribeFloatingBanner.astro';

export const prerender = false;

// SSR: fetch content collection per request
const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const allEvents = await getCollection('events');
const entry = allEvents.find((e) => e.data.slug === slug);

if (!entry) {
  return Astro.redirect(`/${lang}/events`);
}

const { Content } = await render(entry);

// API URL from environment
const apiUrl = import.meta.env.PUBLIC_API_URL || "https://acc-clubhub-events-ms.vercel.app";

// Participant portal: check for token in query param
let participantData = null;
const token = Astro.url.searchParams.get("token");

if (token) {
  try {
    const res = await fetch(`${apiUrl}/api/events/${entry.data.slug}/participant?token=${encodeURIComponent(token)}`);
    if (res.ok) {
      participantData = await res.json();
    }
  } catch {
    // Invalid token — silently ignore, show normal page
  }
}

const registrationLabels: Record<string, string> = {
  zh: '立即报名',
  en: 'Register Now',
  de: 'Jetzt anmelden',
};

const isPastEvent = new Date(entry.data.date) < getTodayAtMidnight();

const endedLabels: Record<string, string> = {
  zh: '该活动已结束，报名通道已关闭。',
  en: 'This event has ended. Registration is closed.',
  de: 'Diese Veranstaltung ist beendet. Die Anmeldung ist geschlossen.',
};
---

<ArticleLayout
  title={entry.data.title}
  date={entry.data.date}
  cover={entry.data.cover}
  lang={lang}
  backLink={`/${lang}/events`}
  backLabel={t(lang, 'nav.events')}
>
  <!-- Fallback: External registration link (if provided) -->
  {entry.data.registrationLink && (
    <a href={entry.data.registrationLink} target="_blank" rel="noopener" class="event-register-btn">
      {registrationLabels[lang] || registrationLabels.en} →
    </a>
  )}

  <!-- Event Info -->
  <div class="event-info">
    {entry.data.eventType && (
      <span class="event-type-badge">{entry.data.eventType}</span>
    )}
    {entry.data.location && (
      <span class="event-location">📍 {entry.data.location}</span>
    )}
  </div>

  <!-- Main Content -->
  <Content />

  <!-- Participant List (shown when valid token is present) -->
  {participantData && (
    <section class="participant-portal" style="margin-top: 2rem; padding: 1.5rem; background: #f6f8fa; border: 1px solid #d0d7de; border-radius: 8px;">
      <h3 style="margin: 0 0 1rem 0; font-size: 1.1rem; color: #24292f;">
        Participants ({participantData.total_confirmed})
      </h3>
      <p style="margin: 0 0 1rem 0; font-size: 0.9rem; color: #57606a;">
        Your registration status: <strong>{participantData.your_status}</strong>
      </p>
      {participantData.participants.length > 0 ? (
        <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem;">
          {participantData.participants.map((p: any) => (
            <li style="padding: 0.5rem 0.75rem; background: white; border-radius: 4px; border: 1px solid #eaeef2;">
              {p.name}
            </li>
          ))}
        </ul>
      ) : (
        <p style="color: #57606a; font-size: 0.9rem;">No confirmed participants yet.</p>
      )}
    </section>
  )}

  <!-- Registration Form: inline compact, before comments -->
  {isPastEvent && (
    <div slot="before-comments" class="event-ended-notice">
      {endedLabels[lang] ?? endedLabels.en}
    </div>
  )}
  {!isPastEvent && !entry.data.registrationLink && (
    <div
      slot="before-comments"
      id="registration-container"
      data-slug={entry.data.slug}
      data-title={entry.data.title}
      data-location={entry.data.location}
      data-event-date={entry.data.date}
      data-event-type={entry.data.eventType}
      data-max-participants={entry.data.maxParticipants != null ? String(entry.data.maxParticipants) : ''}
      data-registration-deadline={entry.data.registrationDeadline ?? ''}
      data-lang={lang}
      data-api-url={apiUrl}
    >
      <!-- EventRegistrationForm will be hydrated here -->
    </div>
  )}
  <!-- Floating subscribe banner: only on past events (active events have the form checkbox) -->
  {isPastEvent && <SubscribeFloatingBanner lang={lang} apiUrl={apiUrl} />}
</ArticleLayout>

<!-- Client-side script to hydrate registration form -->
<script>
  import { h, render } from 'preact';
  import { EventRegistrationForm } from '../../../components/EventRegistrationForm';
  import type { Locale } from '../../../lib/i18n';

  function initRegistrationForm() {
    const container = document.getElementById('registration-container');
    if (!container) return;

    const slug = container.dataset.slug;
    const title = container.dataset.title ?? '';
    const location = container.dataset.location ?? '';
    const eventDate = container.dataset.eventDate ?? '';
    const eventType = container.dataset.eventType ?? 'social-ride';
    const maxParticipantsRaw = container.dataset.maxParticipants;
    const maxParticipants = maxParticipantsRaw ? parseInt(maxParticipantsRaw, 10) : null;
    const registrationDeadline = container.dataset.registrationDeadline || null;
    const lang = (container.dataset.lang ?? 'zh') as Locale;
    const apiUrl = container.dataset.apiUrl ?? '';

    if (!slug || !apiUrl) {
      console.error('Missing data attributes for registration form');
      return;
    }

    render(
      h(EventRegistrationForm, {
        eventSlug: slug,
        eventTitle: title,
        eventLocation: location,
        eventDate,
        eventType,
        maxParticipants,
        registrationDeadline,
        lang,
        apiUrl,
      }),
      container
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRegistrationForm);
  } else {
    initRegistrationForm();
  }
</script>

<style>
  .event-info {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border-rough);
  }

  .event-type-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: var(--color-primary);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 4px;
  }

  .event-location {
    font-size: 0.95rem;
    color: #666;
  }

  .event-register-btn {
    display: inline-block;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-accent);
    color: white;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    border: 2px solid var(--color-border-rough);
    border-radius: 4px;
    text-decoration: none;
    margin-bottom: var(--space-lg);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 3px 3px 0 var(--color-border-rough);
  }

  .event-register-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-primary);
    text-decoration: none;
    color: white;
  }
</style>
