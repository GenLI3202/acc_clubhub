---
// src/pages/[lang]/events/[slug].astro
// 慕城日常 - 活动详情页 (Phase 4.3: with registration form)

import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { getLangFromEntry, t, type Locale } from '../../../lib/i18n';
import { EventRegistrationForm } from '../../../components/EventRegistrationForm';
import '../../../components/EventRegistrationForm.css';

export async function getStaticPaths() {
  const allEvents = await getCollection('events');
  return allEvents.map((entry) => {
    const lang = getLangFromEntry(entry.filePath, 'events');
    return {
      params: { lang, slug: entry.data.slug },
      props: { entry },
    };
  });
}

type Props = {
  entry: Awaited<ReturnType<typeof getCollection<'events'>>>[number];
};

const { entry } = Astro.props;
const { lang } = Astro.params as { lang: Locale };
const { Content } = await render(entry);

const registrationLabels: Record<string, string> = {
  zh: '立即报名',
  en: 'Register Now',
  de: 'Jetzt anmelden',
};

// API URL from environment
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://acc-clubhub-events-ms.vercel.app';
---

<ArticleLayout
  title={entry.data.title}
  date={entry.data.date}
  cover={entry.data.cover}
  lang={lang}
  backLink={`/${lang}/events`}
  backLabel={t(lang, 'nav.events')}
>
  <div class="event-info">
    {entry.data.eventType && (
      <span class="event-type-badge">{entry.data.eventType}</span>
    )}
    {entry.data.location && (
      <span class="event-location">📍 {entry.data.location}</span>
    )}
  </div>

  <!-- Registration Form (if no external link) -->
  {!entry.data.registrationLink && (
    <div
      id="registration-container"
      data-slug={entry.data.slug}
      data-lang={lang}
      data-api-url={apiUrl}
    >
      <!-- EventRegistrationForm will be hydrated here -->
    </div>
  )}

  <!-- Fallback: External registration link -->
  {entry.data.registrationLink && (
    <a href={entry.data.registrationLink} target="_blank" rel="noopener" class="event-register-btn">
      {registrationLabels[lang] || registrationLabels.en} →
    </a>
  )}

  <Content />
</ArticleLayout>

<!-- Client-side script to hydrate registration form -->
<script>
  import { h, render } from 'preact';
  import { EventRegistrationForm } from '../../../components/EventRegistrationForm';

  async function initRegistrationForm() {
    const container = document.getElementById('registration-container');
    if (!container) return;

    const slug = container.dataset.slug;
    const lang = container.dataset.lang;
    const apiUrl = container.dataset.apiUrl;

    if (!slug || !lang || !apiUrl) {
      console.error('Missing data attributes for registration form');
      return;
    }

    try {
      // Fetch event data from API
      const response = await fetch(`${apiUrl}/api/events/${slug}`);
      if (!response.ok) {
        throw new Error('Failed to load event data');
      }

      const eventData = await response.json();

      // Calculate available spots
      const availableSpots = eventData.max_participants
        ? eventData.max_participants - eventData.current_participants
        : null;

      // Check if deadline passed
      const isDeadlinePassed = eventData.registration_deadline
        ? new Date(eventData.registration_deadline) < new Date()
        : false;

      // Render Preact component
      render(
        h(EventRegistrationForm, {
          eventId: eventData.id,
          eventSlug: slug,
          availableSpots,
          isDeadlinePassed,
          lang,
          apiUrl,
        }),
        container
      );
    } catch (error) {
      console.error('Failed to initialize registration form:', error);
      container.innerHTML = '<p class="error">Registration form unavailable</p>';
    }
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRegistrationForm);
  } else {
    initRegistrationForm();
  }
</script>

<style>
  .event-info {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .event-type-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: var(--color-primary);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 4px;
  }

  .event-location {
    font-size: 0.95rem;
    color: #666;
  }

  .event-register-btn {
    display: inline-block;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-accent);
    color: white;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    border: 2px solid var(--color-border-rough);
    border-radius: 4px;
    text-decoration: none;
    margin-bottom: var(--space-lg);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 3px 3px 0 var(--color-border-rough);
  }

  .event-register-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-primary);
    text-decoration: none;
    color: white;
  }
</style>
