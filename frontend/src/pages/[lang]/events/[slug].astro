---
// src/pages/[lang]/events/[slug].astro
// 慕城日常 - 活动详情页 (Phase 4.3: with registration form)

import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { t, type Locale } from '../../../lib/i18n';
import { getTodayAtMidnight } from '../../../lib/events/eventHelpers';
import { resolveEventEntryBySlug } from '../../../lib/events/recurringEvents';
import { EventRegistrationForm } from '../../../components/EventRegistrationForm';
import '../../../components/EventRegistrationForm.css';
import SubscribeFloatingBanner from '../../../components/SubscribeFloatingBanner.astro';

export const prerender = false;

// SSR: fetch content collection per request
const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const allEvents = await getCollection('events');
const entry = resolveEventEntryBySlug(allEvents, slug, lang);

if (!entry) {
  return Astro.redirect(`/${lang}/events`);
}

const sourceEntry = allEvents.find((e) => e.id === entry.id) ?? entry;
const { Content } = await render(sourceEntry);

// API URL from environment
const apiUrl = import.meta.env.PUBLIC_API_URL || "https://acc-clubhub-events-ms.vercel.app";

// Participant portal: check for token in query param
let participantData = null;
const token = Astro.url.searchParams.get("token");

if (token) {
  try {
    const res = await fetch(`${apiUrl}/api/events/${entry.data.slug}/participant?token=${encodeURIComponent(token)}`);
    if (res.ok) {
      participantData = await res.json();
    }
  } catch {
    // Invalid token — silently ignore, show normal page
  }
}

const registrationLabels: Record<string, string> = {
  zh: '立即报名',
  en: 'Register Now',
  de: 'Jetzt anmelden',
};

const eventTypeLabels: Record<string, Record<string, string>> = {
  'social-ride':   { zh: '休闲骑', en: 'Social Ride', de: 'Social Ride' },
  'training-camp': { zh: '训练营', en: 'Training Camp', de: 'Trainingslager' },
  'race':          { zh: '比赛', en: 'Race', de: 'Rennen' },
  'workshop':      { zh: '工作坊', en: 'Workshop', de: 'Workshop' },
};
const eventTypeLabel = (eventTypeLabels[entry.data.eventType] ?? {})[lang] ?? entry.data.eventType;

const isPastEvent = new Date(entry.data.date) < getTodayAtMidnight();

// Effective registration deadline: explicit value in frontmatter, or default to day before event at 22:00
const rawDeadline = entry.data.registrationDeadline;
const effectiveDeadline = rawDeadline
  ? String(rawDeadline)
  : (() => {
      const d = new Date(entry.data.date);
      d.setUTCDate(d.getUTCDate() - 1);
      return `${d.toISOString().slice(0, 10)}T22:00:00`;
    })();

const endedLabels: Record<string, string> = {
  zh: '该活动已结束，报名通道已关闭。',
  en: 'This event has ended. Registration is closed.',
  de: 'Diese Veranstaltung ist beendet. Die Anmeldung ist geschlossen.',
};

const isACCOfficialRide = entry.data.ACCOfficialRide === true;
---

<ArticleLayout
  title={entry.data.title}
  date={entry.data.date}
  cover={entry.data.cover}
  lang={lang}
  backLink={`/${lang}/events`}
  backLabel={t(lang, 'nav.events')}
>
  <!-- Fallback: External registration link (if provided) -->
  {entry.data.registrationLink && (
    <a href={entry.data.registrationLink} target="_blank" rel="noopener" class="event-register-btn">
      {registrationLabels[lang] || registrationLabels.en} →
    </a>
  )}

  <!-- Event Info -->
  <div class="event-info">
    {entry.data.eventType && (
      <span class="event-type-badge">{eventTypeLabel}</span>
    )}
    {entry.data.location && (
      <span class="event-location">📍 {entry.data.location}</span>
    )}
  </div>

  <!-- Main Content -->
  <Content />

  <!-- Participant List (shown when valid token is present) -->
  {participantData && (
    <section class="participant-portal" style="margin-top: 2rem; padding: 1.5rem; background: #f6f8fa; border: 1px solid #d0d7de; border-radius: 8px;">
      <h3 style="margin: 0 0 1rem 0; font-size: 1.1rem; color: #24292f;">
        Participants ({participantData.total_confirmed})
      </h3>
      <p style="margin: 0 0 1rem 0; font-size: 0.9rem; color: #57606a;">
        Your registration status: <strong>{participantData.your_status}</strong>
      </p>
      {participantData.participants.length > 0 ? (
        <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem;">
          {participantData.participants.map((p: any) => (
            <li style="padding: 0.5rem 0.75rem; background: white; border-radius: 4px; border: 1px solid #eaeef2;">
              {p.name}
            </li>
          ))}
        </ul>
      ) : (
        <p style="color: #57606a; font-size: 0.9rem;">No confirmed participants yet.</p>
      )}
    </section>
  )}

  <!-- Registration Form: inline compact, before comments -->
  {isPastEvent && (
    <div slot="before-comments" class="event-ended-notice">
      {endedLabels[lang] ?? endedLabels.en}
    </div>
  )}
  {!isPastEvent && !entry.data.registrationLink && (
    <div
      slot="before-comments"
      id="registration-container"
      data-slug={entry.data.slug}
      data-title={entry.data.title}
      data-location={entry.data.location}
      data-event-date={entry.data.date}
      data-event-type={entry.data.eventType}
      data-max-participants={entry.data.maxParticipants != null ? String(entry.data.maxParticipants) : ''}
      data-registration-deadline={effectiveDeadline}
      data-wechat-qr-code={entry.data.wechatQrCode ?? ''}
      data-acc-official-ride={isACCOfficialRide ? 'true' : ''}
      data-lang={lang}
      data-api-url={apiUrl}
    >
      <!-- EventRegistrationForm will be hydrated here -->
    </div>
  )}
  <!-- Floating subscribe banner: only on past events (active events have the form checkbox) -->
  {isPastEvent && <SubscribeFloatingBanner lang={lang} apiUrl={apiUrl} />}
</ArticleLayout>

<!-- Client-side script to hydrate registration form -->
<script>
  import { h, render } from 'preact';
  import { EventRegistrationForm } from '../../../components/EventRegistrationForm';
  import type { Locale } from '../../../lib/i18n';

  function initRegistrationForm() {
    const container = document.getElementById('registration-container');
    if (!container) return;

    const slug = container.dataset.slug;
    const title = container.dataset.title ?? '';
    const location = container.dataset.location ?? '';
    const eventDate = container.dataset.eventDate ?? '';
    const eventType = container.dataset.eventType ?? 'social-ride';
    const maxParticipantsRaw = container.dataset.maxParticipants;
    const maxParticipants = maxParticipantsRaw ? parseInt(maxParticipantsRaw, 10) : null;
    const registrationDeadline = container.dataset.registrationDeadline || null;
    const wechatQrCode = container.dataset.wechatQrCode || null;
    const isACCOfficialRide = container.dataset.accOfficialRide === 'true';
    const lang = (container.dataset.lang ?? 'zh') as Locale;
    const apiUrl = container.dataset.apiUrl ?? '';

    if (!slug || !apiUrl) {
      console.error('Missing data attributes for registration form');
      return;
    }

    render(
      h(EventRegistrationForm, {
        eventSlug: slug,
        eventTitle: title,
        eventLocation: location,
        eventDate,
        eventType,
        maxParticipants,
        registrationDeadline,
        wechatQrCode,
        isACCOfficialRide,
        lang,
        apiUrl,
      }),
      container
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRegistrationForm);
  } else {
    initRegistrationForm();
  }
</script>

<!-- Interactive Komoot map (Leaflet) for route previews embedded in markdown -->
<script>
  function initKomootMaps() {
    const mapContainers = document.querySelectorAll<HTMLDivElement>('.komoot-interactive-map');
    if (mapContainers.length === 0) return;

    // Load Leaflet CSS
    if (!document.querySelector('link[href*="leaflet"]')) {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      css.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
      css.crossOrigin = '';
      document.head.appendChild(css);
    }

    function createMaps() {
      const L = (window as any).L;
      if (!L) { setTimeout(createMaps, 100); return; }

      mapContainers.forEach((container) => {
        if (container.dataset.initialized) return;
        container.dataset.initialized = '1';

        const coords: [number, number][] = JSON.parse(container.dataset.coords || '[]');
        const tourUrl = container.dataset.tourUrl || '#';
        if (coords.length === 0) return;

        // Create map wrapper
        container.style.borderRadius = '8px';
        container.style.overflow = 'hidden';
        container.style.border = '1px solid var(--color-border-rough, #d0d7de)';
        container.style.margin = '1.5rem 0';

        const mapDiv = document.createElement('div');
        mapDiv.style.height = '500px';
        mapDiv.style.width = '100%';
        container.appendChild(mapDiv);

        const linkDiv = document.createElement('div');
        linkDiv.style.padding = '0.6rem 1rem';
        linkDiv.style.background = '#f6f8fa';
        linkDiv.style.borderTop = '1px solid var(--color-border-rough, #d0d7de)';
        linkDiv.style.fontSize = '0.85rem';
        linkDiv.innerHTML = `<a href="${tourUrl}" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent,#0969da);text-decoration:none;font-weight:500;">🗺️ Auf Komoot ansehen →</a>`;
        container.appendChild(linkDiv);

        const map = L.map(mapDiv, {
          scrollWheelZoom: true,
          zoomControl: true,
          dragging: true,
          touchZoom: true,
          doubleClickZoom: true,
        });

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          maxZoom: 18,
        }).addTo(map);

        const polyline = L.polyline(coords, {
          color: '#e6500a',
          weight: 4,
          opacity: 0.85,
        }).addTo(map);

        // Start/end markers
        const startIcon = L.divIcon({
          html: '<div style="background:#1a7f37;color:white;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:12px;border:2px solid white;box-shadow:0 2px 4px rgba(0,0,0,.3);">A</div>',
          iconSize: [24, 24],
          iconAnchor: [12, 12],
          className: '',
        });
        const endIcon = L.divIcon({
          html: '<div style="background:#cf222e;color:white;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:12px;border:2px solid white;box-shadow:0 2px 4px rgba(0,0,0,.3);">B</div>',
          iconSize: [24, 24],
          iconAnchor: [12, 12],
          className: '',
        });
        L.marker(coords[0], { icon: startIcon }).addTo(map);
        L.marker(coords[coords.length - 1], { icon: endIcon }).addTo(map);

        map.fitBounds(polyline.getBounds(), { padding: [30, 30] });
      });
    }

    // Load Leaflet JS if not present
    if (!(window as any).L) {
      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
      script.crossOrigin = '';
      script.onload = createMaps;
      document.head.appendChild(script);
    } else {
      createMaps();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initKomootMaps);
  } else {
    initKomootMaps();
  }
</script>

<style>
  .event-info {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border-rough);
  }

  .event-type-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: var(--color-primary);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 4px;
  }

  .event-location {
    font-size: 0.95rem;
    color: #666;
  }

  .event-register-btn {
    display: inline-block;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-accent);
    color: white;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    border: 2px solid var(--color-border-rough);
    border-radius: 4px;
    text-decoration: none;
    margin-bottom: var(--space-lg);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 3px 3px 0 var(--color-border-rough);
  }

  .event-register-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-primary);
    text-decoration: none;
    color: white;
  }
</style>
