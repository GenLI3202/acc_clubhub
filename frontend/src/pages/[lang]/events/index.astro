---
export const prerender = false;
// src/pages/[lang]/events/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { locales, defaultLocale, t, type Locale } from '../../../lib/i18n';
import { splitEvents, getRegulars } from '../../../lib/events/eventHelpers';
import { resolveRecurringEvents } from '../../../lib/events/recurringEvents';
import EventHero from '../../../components/events/EventHero.astro';
import UpcomingEvents from '../../../components/events/UpcomingEvents.astro';
import WeeklyRegulars from '../../../components/events/WeeklyRegulars.astro';
import PastEvents from '../../../components/events/PastEvents.astro';
import SubscribeFloatingBanner from '../../../components/SubscribeFloatingBanner.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const pageTitle = t(lang, 'nav.events');

const allEvents = await getCollection('events');
const langEvents = allEvents.filter((e) => {
  const entryLang = e.id.includes('/') ? e.id.split('/')[0] : defaultLocale;
  return entryLang === lang && e.data.status !== 'draft';
});

const effectiveEvents = resolveRecurringEvents(langEvents);
const { upcoming, past } = splitEvents(effectiveEvents);

// Carousel hero: events with displaySection === 'hero', sorted by date
const carouselEvents = upcoming
  .filter((e) => e.data.displaySection === 'hero')
  .sort((a, b) => new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf());

// Upcoming cards: events with displaySection === 'upcoming'
const upcomingCards = upcoming.filter((e) => e.data.displaySection === 'upcoming');

const regulars = getRegulars(upcoming);
const apiUrl = import.meta.env.PUBLIC_API_URL || "https://acc-clubhub-events-ms.vercel.app";
---


<BaseLayout
  title={pageTitle}
  lang={lang}
  headerTransparent={true}
  heroImagePreload={carouselEvents[0]?.data.coverImage}
>
  <EventHero slot="hero" events={carouselEvents} lang={lang} />

  <UpcomingEvents events={upcomingCards} lang={lang} />
  <WeeklyRegulars events={regulars} lang={lang} />
  <PastEvents events={past} lang={lang} />
  <SubscribeFloatingBanner lang={lang} apiUrl={apiUrl} />
</BaseLayout>
