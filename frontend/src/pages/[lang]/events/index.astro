---
// src/pages/[lang]/events/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { locales, defaultLocale, t, type Locale } from '../../../lib/i18n';
import { splitEvents, getRegulars } from '../../../lib/events/eventHelpers';
import EventHero from '../../../components/events/EventHero.astro';
import WeeklyRegulars from '../../../components/events/WeeklyRegulars.astro';
import PastEvents from '../../../components/events/PastEvents.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const pageTitle = t(lang, 'nav.events');

const allEvents = await getCollection('events');
const langEvents = allEvents.filter((e) => {
  const entryLang = e.id.includes('/') ? e.id.split('/')[0] : defaultLocale;
  return entryLang === lang && e.data.status !== 'draft';
});

const { upcoming, past } = splitEvents(langEvents);
// Carousel: non-social-ride upcoming events (featured first, then by date)
const carouselEvents = upcoming
  .filter((e) => e.data.eventType !== 'social-ride')
  .sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0));
const regulars = getRegulars(upcoming);
---

<BaseLayout
  title={pageTitle}
  lang={lang}
  headerTransparent={true}
  heroImagePreload={carouselEvents[0]?.data.coverImage}
>
  <EventHero slot="hero" events={carouselEvents} lang={lang} />

  <WeeklyRegulars events={regulars} lang={lang} />
  <PastEvents events={past} lang={lang} />
</BaseLayout>
