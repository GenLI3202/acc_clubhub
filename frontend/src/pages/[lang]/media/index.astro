---
export const prerender = true;
// src/pages/[lang]/media/index.astro
// Editorial hero + featured shelf above the existing MasonryGrid feed.

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { locales, getLangFromEntry, t, type Locale } from '../../../lib/i18n';
import { getFilterLabel } from '../../../lib/i18n/filterTranslations';
import EditorialHero from '../../../components/editorial/EditorialHero.astro';
import SectionRule from '../../../components/editorial/SectionRule.astro';
import FeaturedShelf from '../../../components/editorial/FeaturedShelf.astro';
import MediaPage from '../../../components/content/MediaPage';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const allMedia = await getCollection('media');
const langMedia = allMedia.filter(
  (entry) => getLangFromEntry(entry.filePath, 'media') === lang && entry.data.status !== 'draft'
);
const sortedMedia = langMedia.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Top 3 featured items for the shelf
const featuredEntries = sortedMedia.filter((e) => e.data.featured).slice(0, 3);
const featuredSlugs = new Set(featuredEntries.map((e) => e.data.slug));

const featuredItems = featuredEntries.map((e) => {
  const d = new Date(e.data.date);
  const meta = !isNaN(d.getTime())
    ? d.toLocaleDateString(
        lang === 'zh' ? 'zh-CN' : lang === 'de' ? 'de-DE' : 'en-GB',
        { month: 'short', day: 'numeric', year: 'numeric' },
      )
    : e.data.date;
  return {
    href: `/${lang}/media/${e.data.slug}`,
    title: e.data.title,
    description: e.data.description,
    cover: e.data.coverImage,
    tagLabel: getFilterLabel('type', e.data.type, lang),
    meta,
  };
});

// Remove featured items from the masonry feed to avoid duplication
const masonryItems = sortedMedia.filter((e) => !featuredSlugs.has(e.data.slug));

const pageTitle = t(lang, 'nav.media');
---

<BaseLayout title={pageTitle} lang={lang}>
  <article class="media-editorial-page">
    <EditorialHero
      eyebrow={t(lang, 'editorial.eyebrow.media')}
      title={pageTitle}
      subtitle={t(lang, 'media.subtitle')}
    />

    {featuredItems.length > 0 && (
      <>
        <SectionRule label={t(lang, 'editorial.section.featured')} />
        <FeaturedShelf items={featuredItems} lang={lang} />
      </>
    )}

    <SectionRule label={t(lang, 'editorial.section.allMedia')} />

    <MediaPage
      client:load
      initialItems={masonryItems}
      lang={lang}
    />
  </article>
</BaseLayout>

<style>
  .media-editorial-page {
    padding-bottom: 0;
  }
</style>
