const c = content[lang];
---

<BaseLayout title={c.title} lang={lang}>
  <article class="charter-page">
    <header class="charter-header">
      <a href={`/${lang}/membership`} class="charter-back-link">{c.backLabel}</a>
      <h1>{c.title}</h1>
      <p class="charter-subtitle">{c.subtitle}</p>
    </header>

    <section class="charter-intro">
      <div set:html={marked.parse(c.intro.trim())} />
    </section>

    <section class="charter-values" aria-labelledby="charter-values-title">
      <h2 id="charter-values-title">{c.valuesTitle}</h2>
      {c.values.map((value) => (
        <p>{value}</p>
      ))}
    </section>

    {c.sections.map((section) => (
      <section class="charter-section">
        <h2>{section.title}</h2>
        {'lede' in section && section.lede && (
          <p class="section-lede">{section.lede}</p>
        )}
        {'note' in section && section.note && (
          <p class="legal-note">{section.note}</p>
        )}
        <div set:html={marked.parse(section.body.trim())} />
      </section>
    ))}

    <footer class="charter-footer">
      {c.footer.map((line) => (
        <p>{line}</p>
      ))}
    </footer>
  </article>
</BaseLayout>

<style>
  .charter-page {
    max-width: 860px;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
    color: #2f2f2f;
  }

  .charter-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 3px solid var(--color-border-rough);
  }

  .charter-back-link {
