const c = content[lang];
---

<BaseLayout title={c.title} lang={lang} headerTransparent={true} heroImagePreload={HERO_IMG}>

  {/* ============================================================
      HERO — full-bleed photo, overlaps transparent header
     ============================================================ */}
  <section slot="hero" class="mem-hero" style={`background-image: url(${HERO_IMG});`}>
    <div class="mem-hero-overlay" aria-hidden="true"></div>
    <div class="mem-hero-content">
      <h1 class="mem-hero-h1">{c.heroTitle}</h1>
      <p class="mem-hero-subtitle">
        {c.heroSubtitle}
        <span class="mem-hero-accent">{c.heroAccent}</span>
      </p>
    </div>
  </section>

  {/* ============================================================
      PROSE INTRO
     ============================================================ */}
  <section class="mem-intro">
    <div class="mem-eyebrow mem-eyebrow--accent">{c.introEyebrow}</div>
    <h2 class="mem-intro-h2">{c.introTitle}</h2>
    {c.introBody.map((paragraph) => (
      <p class="mem-intro-body">{paragraph}</p>
    ))}
    <p class="mem-intro-tagline">{c.tagline}</p>
    <hr class="mem-intro-rule" />
  </section>

  {/* ============================================================
      THREE-IMAGE EDITORIAL STRIP
     ============================================================ */}
  <section class="mem-photo-strip">
    <div class="mem-photo-grid">
      {[
        { img: CAFE_IMG, label: c.photos[0] },
        { img: ALPS_IMG, label: c.photos[1] },
        { img: GROUP_IMG, label: c.photos[2] },
      ].map((p) => (
        <div class="mem-photo-item">
          <div class="mem-photo-img" style={`background-image: url(${p.img});`}></div>
          <div class="mem-photo-caption">
            <div class="mem-photo-label">{p.label}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* ============================================================
      BENEFITS
     ============================================================ */}
  <section class="mem-benefits-section">
    <div class="mem-benefits-inner">
      <div class="mem-benefits-header">
        <h2 class="mem-benefits-h2">{c.benefitsTitle}</h2>
      </div>

      <div class="mem-benefits-list">
        {c.benefits.map((b) => (
          <div class="mem-benefit-row">
            <div class="mem-benefit-num">{b.n}</div>
            <div class="mem-benefit-title">{b.title}</div>
            <div class="mem-benefit-desc-col">
              <div class="mem-benefit-desc">{b.desc}</div>
              {b.link && (
                <a href={b.link.href} class="mem-benefit-link">{b.link.label} →</a>
              )}
            </div>
          </div>
        ))}
        <div class="mem-benefits-footer-row">
          <span class="mem-benefits-more">{c.benefitsMore}</span>
          <span class="mem-benefits-charter-link">
            {c.benefitsCharterPrefix} <a href={`/${lang}/membership-charter`} class="mem-link">{c.benefitsCharterLink} →</a>
          </span>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
      入会须知 — pricing + terms combined
     ============================================================ */}
  <section class="mem-joinnote-section" id="charter">
    <div class="mem-joinnote-inner">

      <div class="mem-joinnote-heading-row">
        <h2 class="mem-joinnote-h2">{c.joinTitle}</h2>
      </div>

      {/* ── pricing block ── */}
      <div class="mem-pricing-block">
        <p class="mem-pricing-year-label">{c.pricingYear}</p>
        <div class="mem-pricing-grid">
          <div class="mem-pricing-col-head"></div>
          <div class="mem-pricing-col-head">{c.student}</div>
          <div class="mem-pricing-col-head">{c.nonStudent}</div>

          <div class="mem-pricing-row-label">{c.returningMember}</div>
          <div class="mem-pricing-amount">10€</div>
          <div class="mem-pricing-amount">15€</div>

          <div class="mem-pricing-row-label">{c.newMember}</div>
          <div class="mem-pricing-amount">29€</div>
          <div class="mem-pricing-amount">49€</div>

          <div class="mem-pricing-footnote">{c.pricingFootnote}</div>
        </div>
      </div>

      {/* ── terms accordion ── */}
      <div class="mem-terms-list" id="mem-terms-list">
        {c.terms.map((t, i) => (
          <div class="mem-term-item" data-term-index={i}>
            <button class="mem-term-btn is-open" type="button" aria-expanded="true" data-term-btn>
              <span class="mem-term-btn-inner">
                <span class="mem-term-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="mem-term-q">{t.q}</span>
              </span>
              <span class="mem-term-plus" aria-hidden="true">+</span>
            </button>
            <div class="mem-term-answer" data-term-answer>
              {t.a}
            </div>
          </div>
        ))}
      </div>

      <div class="mem-terms-charter-link">
        <a href={`/${lang}/membership-charter`} class="mem-link-sm">{c.fullCharterLink} →</a>
      </div>

    </div>
  </section>

  <script is:inline>
    (function initTermsAccordion() {
      const list = document.getElementById('mem-terms-list');
      if (!list) return;
      list.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-term-btn]');
        if (!btn) return;
        const item = btn.closest('[data-term-index]');
        if (!item) return;
        const answer = item.querySelector('[data-term-answer]');
        if (!answer) return;
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        btn.classList.toggle('is-open', !isOpen);
        answer.hidden = isOpen;
      });
    })();
  </script>

  {/* ============================================================
      CTA
     ============================================================ */}
  <section class="mem-cta-section">
    <img
      src="/images/about/logo-stamp-red-transparent.png"
      alt=""
      aria-hidden="true"
      class="mem-cta-watermark"
    />
    <div class="mem-cta-content">
      <h2 class="mem-cta-h2">
        Let us ride,
        <span class="mem-cta-italic"> free and together.</span>
      </h2>
