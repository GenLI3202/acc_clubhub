---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { locales, t, type Locale, type UIKey } from "../../lib/i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

type Tier = {
  title: UIKey;
  price: string;
  note?: UIKey;
};

const tiers: Tier[] = [
  {
    title: "membership.tierOld",
    price: "10€",
    note: "membership.tierOldNote",
  },
  {
    title: "membership.tierStudent",
    price: "29€",
  },
  {
    title: "membership.tierRegular",
    price: "49€",
  },
];

const benefits: UIKey[] = [
  "membership.benefit1",
  "membership.benefit2",
  "membership.benefit3",
  "membership.benefit4",
  "membership.benefit5",
  "membership.benefit6",
  "membership.benefit7",
];

const terms: UIKey[] = [
  "membership.term1",
  "membership.term2",
  "membership.term3",
  "membership.term4",
  "membership.term5",
  "membership.term6",
  "membership.term7",
];
---

<BaseLayout title={t(lang, "membership.h1")} lang={lang}>
  <article class="membership-page">
    <section class="membership-hero" aria-labelledby="membership-title">
      <p class="membership-eyebrow">{t(lang, "membership.eyebrow")}</p>
      <h1 id="membership-title">{t(lang, "membership.h1")}</h1>
      <p class="membership-tagline">{t(lang, "membership.tagline")}</p>
    </section>

    <div class="section-rule">{t(lang, "membership.pricingTitle")}</div>

    <section class="pricing-grid" aria-label={t(lang, "membership.pricingTitle")}>
      {tiers.map((tier) => (
        <article class="pricing-card">
          <div class="tier-name">{t(lang, tier.title)}</div>
          <div class="tier-price">
            {tier.price}
            {!tier.note && <span>{t(lang, "membership.priceSuffix")}</span>}
          </div>
          {tier.note && <p class="tier-note">{t(lang, tier.note)}</p>}
        </article>
      ))}
    </section>

    <p class="pricing-footnote">
      {t(lang, "membership.validUntil")} · {t(lang, "membership.bonusNote")}
    </p>

    <div class="section-rule">{t(lang, "membership.benefitsTitle")}</div>

    <section class="benefits-section" aria-label={t(lang, "membership.benefitsTitle")}>
      <ul class="benefits-list">
        {benefits.map((benefit) => (
          <li>
            <span class="benefit-icon" aria-hidden="true">+</span>
            <span>{t(lang, benefit)}</span>
          </li>
        ))}
        <li class="benefit-muted">
          <span class="benefit-icon" aria-hidden="true">+</span>
          <span>{t(lang, "membership.moreComingSoon")}</span>
        </li>
      </ul>
    </section>

    <details class="membership-terms">
      <summary>{t(lang, "membership.termsTitle")}</summary>
      <ol>
        {terms.map((term) => <li>{t(lang, term)}</li>)}
      </ol>
    </details>

    <section class="membership-cta" aria-label={t(lang, "membership.ctaBtn")}>
      <a class="signup-button" href="#">{t(lang, "membership.ctaBtn")}</a>
      <p>{t(lang, "membership.ctaNote")}</p>
    </section>
  </article>
</BaseLayout>

<style>
  .membership-page {
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(3rem, 7vw, 6rem);
  }

  .membership-hero {
    max-width: 780px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .membership-eyebrow,
  .section-rule,
  .tier-name,
  .tier-note {
    font-family: var(--font-heading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .membership-eyebrow {
    margin-bottom: 0.75rem;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.78rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.95;
    letter-spacing: 0;
    margin-bottom: 1rem;
  }

  .membership-tagline {
    color: var(--color-text-secondary);
    font-size: clamp(1.1rem, 2.5vw, 1.45rem);
  }

  .section-rule {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .section-rule::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .pricing-card {
    min-height: 190px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg-canvas);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: var(--shadow-sm);
  }

  .tier-name {
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-size: clamp(3rem, 6vw, 4.75rem);
    font-weight: 700;
    line-height: 1;
  }

  .tier-price span {
    color: var(--color-text-muted);
    font-size: 1rem;
    font-weight: 600;
  }

  .tier-note {
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .pricing-footnote {
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    text-align: center;
  }

  .benefits-section {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-bg-canvas);
  }

  .benefits-list {
    list-style: none;
  }

  .benefits-list li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    gap: 0.75rem;
    min-height: 58px;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-main);
    font-weight: 500;
  }

  .benefits-list li:last-child {
    border-bottom: 0;
  }

  .benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-full);
    background: rgba(198, 40, 40, 0.08);
    color: var(--color-accent);
    font-weight: 800;
  }

  .benefit-muted {
    color: var(--color-text-muted) !important;
    background: var(--color-bg-secondary);
  }

  .benefit-muted .benefit-icon {
    background: transparent;
    color: var(--color-text-muted);
  }

  .membership-terms {
    margin-top: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg-secondary);
    padding: 1rem 1.25rem;
  }

  .membership-terms summary {
    cursor: pointer;
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .membership-terms ol {
    margin-top: 1rem;
    padding-left: 1.25rem;
    color: var(--color-text-secondary);
  }

  .membership-terms li + li {
    margin-top: 0.55rem;
  }

  .membership-cta {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .signup-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.85rem 2rem;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .signup-button:hover {
    background: var(--color-accent-dark);
    color: #ffffff;
    text-decoration: none;
  }

  .membership-cta p {
    max-width: 520px;
    margin: 0.8rem auto 0;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  :global(:root.dark) .pricing-card,
  :global(:root.dark) .benefits-section {
    background: var(--color-bg-secondary);
  }

  :global(:root.dark) .benefit-icon {
    background: rgba(198, 40, 40, 0.18);
  }

  @media (max-width: 760px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .pricing-card {
      min-height: 160px;
    }

    .benefits-list li {
      grid-template-columns: 1.75rem 1fr;
      padding: 0.85rem 0.9rem;
    }
  }
</style>
