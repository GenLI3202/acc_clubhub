---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const HERO_IMG = "/images/membership/membership-hero.jpg";
const GROUP_IMG = "/images/membership/weekend-ride.jpg";
const ALPS_IMG = "/images/membership/multi-day-ride.jpg";
const CAFE_IMG = "/images/membership/afterwork.jpg";

const GOOGLE_FORM_URL = "https://docs.google.com/forms/d/e/1FAIpQLScPF0Pep4V7LrfuAQVE8Ww1wE3wP_w9LQbXhpm5xyDA8Goiaw/viewform?usp=pp_url";

const content = {
  zh: {
    title: "加入 ACC",
    heroTitle: "加入 ACC",
    heroSubtitle: "Let us ride —",
    heroAccent: " free and together.",
    introEyebrow: "关于 ACC",
    introTitle: "不止是骑行，更是同频的连结",
    introBody: [
      "ACC (Across Cycling Club) 扎根慕尼黑，背靠阿尔卑斯。我们始于华人骑行社群，但向所有热爱公路与砾石 (Gravel) 的朋友敞开大门。",
      "我们相信，纯粹的热爱不应该伴随内耗，因此 ACC 的第一准则是：让自己人舒服。我们拒绝无意义的\"卷功率\"，抵制身材与装备焦虑。我们存在的意义，是为 ACC 成员提供一个纯粹、没有压力的骑行根据地。",
      "无论你追求的是巴伐利亚乡间的轻松周末 social ride，还是下班后酣畅淋漓的硬核训练 training day；无论是伊萨河畔的微风，还是阿尔卑斯山口的挑战，只要你想和一群人一起感受在路上的自由，这里就有你的位置。跨越语言与背景，我们在轮流破风与沿途的咖啡小憩中，找到共同的节奏。",
      "在这里，我们不仅组织规律的团骑，也分享专业的器械知识与硬核路线。ACC 致力于成为欧洲骑行文化中的一面旗帜，为每一位热爱户外的骑行者提供最好的体验和最可靠的后勤支持。",
    ],
    tagline: "Let us ride, free and together.",
    photos: ["After Work", "多日远征", "周末团骑"],
    benefitsTitle: "会员权益",
    benefitsMore: "更多权益陆续公布 ——",
    benefitsCharterPrefix: "详情请了解",
    benefitsCharterLink: "会员章程与责任义务",
    benefits: [
      {
        n: "01",
        title: "全年 70+ 次团骑活动",
        desc: "每周的 After Work、周末长距离骑游、训练日，以及一年一两次的多日远征 —— 一份够你骑一整年的日程。",
      },
      {
        n: "02",
        title: "BLSV 官方活动保险",
        desc: "所有官方注册活动覆盖巴伐利亚州体协的事故保险。会员才能享受这份保障。",
        link: { label: "了解保险权益详情", href: `/${lang}/insurance` },
      },
      {
        n: "03",
        title: "雏鹰计划 · 进阶培训",
        desc: "从新手到入门小 Pro 的系统培训：踩踏、选线、下坡、气动姿势、骑行安全 —— 把「正确的废话」换成讲到点子上的方法。",
      },
      {
        n: "04",
        title: "ACC 队服与周边购买权",
        desc: "队服、徽章、文化衫等会员限定周边的优先购买与会员价。",
      },
      {
        n: "05",
        title: "合作单位优惠",
        desc: "ACC 自有周边的会员折扣，以及与慕尼黑车店、咖啡馆、训练房等合作单位的会员专属优惠。",
      },
      {
        n: "06",
        title: "赞助物资使用权",
        desc: "未来 ACC 拉到体育品牌赞助后，会员将享有赞助配件、装备的优先使用与体验权。",
      },
      {
        n: "07",
        title: "多日骑行与年度庆典",
        desc: "ACC 年度多日远征、季度庆典、年终聚会的会员专属席位。",
      },
      {
        n: "08",
        title: "成为领骑候选人",
        desc: "会员可申请加入领骑考核 —— 通过后享有带队补贴、社媒激励金、赛事报销等更多权益。",
        link: { label: "了解领骑权利与义务", href: `/${lang}/ride-leader` },
      },
    ],
    joinTitle: "入会须知",
    pricingYear: "2026 / 27 会员年 年费",
    student: "学生",
    nonStudent: "非学生",
    returningMember: "老会员",
    newMember: "新会员",
    pricingFootnote: "首次办理须另缴华人体协 10€ 开户费",
    terms: [
      { q: "有效期", a: "会籍统一至次年 5 月 31 日，每年 6 月 1 日续费。2026 年 5 月报名者，会籍同样至 2027 年 5 月 31 日。" },
      { q: "费用构成", a: "会费包含巴伐利亚州体协（BLSV）年度管理费 10€（含会员事故保险）。新会员首次办理须另缴华人体协 10€ 开户费，因此实际转账金额为学生 39€ / 非学生 59€。其余部分进入俱乐部公共账户。" },
      { q: "退款政策", a: "会费一经缴纳，概不退款。" },
      { q: "活动参与", a: "骑行活动存在固有风险，参与者须自行承担。官方注册活动涵盖 BLSV 事故保险。详细参与规则见会员章程。" },
      { q: "行为规范", a: "遵守骑行准则，尊重队友、行人及其他道路使用者。详细规范见会员章程。" },
      { q: "会费用途", a: "100% 用于俱乐部运营（含领骑补贴、活动组织及赛事参与费用等）与年度储备金。账目对全体会员透明。" },
    ],
    fullCharterLink: "查看完整会员章程",
    ctaLabel: "前往报名表",
  },
  en: {
    title: "Join ACC",
    heroTitle: "Join ACC",
    heroSubtitle: "Let us ride —",
    heroAccent: " free and together.",
    introEyebrow: "About ACC",
    introTitle: "More than rides. A community that moves together.",
    introBody: [
      "ACC (Across Cycling Club) is rooted in Munich, with the Alps as our backyard. We began as a Chinese-speaking cycling community, and we welcome everyone who loves road and gravel riding.",
      "We believe a pure love of cycling should not come with pressure. ACC's first principle is simple: make our own people feel at ease. We do not worship meaningless power-number competition, body anxiety, or gear anxiety. ACC exists to give members a calm, pressure-free cycling home base.",
      "Whether you want an easy weekend social ride through Bavarian countryside, a focused after-work training day, a breezy Isar spin, or a mountain-pass challenge in the Alps, there is a place for you here. Across languages and backgrounds, we find a shared rhythm through rotating pulls, regrouping, and coffee stops along the way.",
      "We organize regular group rides, share practical gear knowledge, and build serious route resources. ACC aims to become a visible part of European cycling culture while giving every outdoor-minded rider a better, safer, and more supported experience.",
    ],
    tagline: "Let us ride, free and together.",
    photos: ["After Work", "Multi-day trips", "Weekend rides"],
    benefitsTitle: "Member Benefits",
    benefitsMore: "More benefits will be announced —",
    benefitsCharterPrefix: "Read the",
    benefitsCharterLink: "member charter and responsibilities",
    benefits: [
      {
        n: "01",
        title: "70+ official rides per year",
        desc: "Weekly after-work rides, weekend endurance routes, training days, and one or two multi-day trips each year: enough riding for a full season.",
      },
      {
        n: "02",
        title: "BLSV official event insurance",
        desc: "Registered official club activities are covered by the Bavarian sports association's accident insurance. This protection is a member benefit.",
        link: { label: "Read insurance details", href: `/${lang}/insurance` },
      },
      {
        n: "03",
        title: "Eaglet program · skills progression",
        desc: "Structured training from beginner to confident club rider: pedaling, line choice, descending, aero position, and group-ride safety explained in a way that actually helps.",
      },
      {
