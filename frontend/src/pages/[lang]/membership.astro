        title: "ACC kit and merchandise access",
        desc: "Priority access and member pricing for jerseys, badges, cultural shirts, and other member-only club items.",
      },
      {
        n: "05",
        title: "Partner discounts",
        desc: "Member discounts on ACC merchandise and selected benefits from Munich bike shops, cafés, training spaces, and future partners.",
      },
      {
        n: "06",
