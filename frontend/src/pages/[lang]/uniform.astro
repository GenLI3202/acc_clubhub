---
export const prerender = true;
// src/pages/[lang]/uniform.astro
// 2026 kit: the design story, an order flow (choose -> pay -> Google Form),
// the size guide and the order terms. Reached from the About page banner.
//
// Static HTML carries all the story, terms and contact text; only the order
// flow and the size finder hydrate. Orders close 25 Oct 2026 (see
// lib/uniform/pricing.ts), decided in the browser so the page needs no rebuild.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { Countdown } from '../../components/uniform/Countdown';
import { SizeGuide } from '../../components/uniform/SizeGuide';
import { UniformShop } from '../../components/uniform/UniformShop';
import { locales, type Locale } from '../../lib/i18n';
import { getUniformCopy } from '../../lib/uniform/copy';
import { PAYMENT } from '../../lib/uniform/payment';
import '../../components/uniform/uniform.css';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const copy = getUniformCopy(lang);
const { hero, terms, contact } = copy;
---

<BaseLayout title={copy.meta.title} lang={lang} heroImagePreload="/images/uniform/model-left.webp">
  <section slot="hero" class="kit-hero">
    <div class="kit-hero-inner">
      <div class="kit-hero-text">
        <p class="kit-hero-eyebrow">{hero.eyebrow}</p>
        <h1 class="kit-hero-title">{hero.title}</h1>
        <p class="kit-hero-lede">{hero.lede}</p>
        <p class="kit-hero-deadline">{hero.deadline}</p>
        <Countdown client:load lang={lang} />
        <a class="kit-btn kit-btn--solid" href="#kit-shop">{hero.cta}</a>
        <ol class="kit-timeline">
          {hero.timeline.map((item) => (
            <li>
              <strong>{item.when}</strong>
              <span>{item.what}</span>
            </li>
          ))}
        </ol>
      </div>
      <div class="kit-hero-photo" data-sample={copy.shop.sampleBadge}>
        <img
          src="/images/uniform/model-left.webp"
          alt={copy.shop.imageAlt.left}
          width="1086"
          height="1448"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <article class="kit-page">
    <section class="kit-wrap" aria-label={copy.shop.title}>
      <UniformShop client:load lang={lang} />
    </section>

    <section class="kit-wrap" id="size-guide" aria-labelledby="kit-size-title">
      <SizeGuide client:visible lang={lang} />
    </section>

    <section class="kit-wrap kit-terms" id="kit-terms" aria-labelledby="kit-terms-title">
      <h2 class="kit-h2" id="kit-terms-title">{terms.title}</h2>
      <ol class="kit-terms-list">
        {terms.items.map((item) => <li>{item}</li>)}
      </ol>
    </section>

    <section class="kit-wrap kit-contact" aria-labelledby="kit-contact-title">
      <div>
        <h2 class="kit-h2" id="kit-contact-title">{contact.title}</h2>
        <p class="kit-lede">{contact.body}</p>
        <p class="kit-contact-line">
          <span>{contact.email}</span>
          <a href={`mailto:${PAYMENT.contact.email}`}>{PAYMENT.contact.email}</a>
        </p>
      </div>
      <figure class="kit-contact-qr">
        <img
          src={PAYMENT.contact.wechatQrImage}
          alt={contact.wechat}
          width="240"
          height="320"
          loading="lazy"
        />
        <figcaption>{contact.wechat}</figcaption>
      </figure>
    </section>
  </article>
</BaseLayout>

<style>
  .kit-wrap {
    max-width: min(1280px, 100% - 2rem);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 0;
  }
  :global(main:has(.kit-page)) {
    padding-top: 0;
    padding-bottom: clamp(3rem, 8vw, 6rem);
    max-width: none;
  }

  /* ---------- Hero ---------- */
  .kit-hero {
    background: #111;
    color: #fff;
  }
  .kit-hero-inner {
    max-width: min(1280px, 100% - 2rem);
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 3.5rem) 0;
    align-items: center;
  }
  @media (min-width: 900px) {
    .kit-hero-inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }
  .kit-hero-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 0.6rem;
  }
  .kit-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 700;
    color: #fff; /* global h1 colour is near-black; the hero is dark */
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .kit-hero-lede {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    max-width: 30rem;
    margin: 0 0 1.25rem;
  }
  .kit-hero-deadline {
    display: inline-block;
    font-size: 0.875rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-md);
    margin: 0 0 1.5rem;
  }
  .kit-hero-text .kit-btn {
    display: flex;
    width: fit-content;
  }
  .kit-timeline {
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    display: grid;
    gap: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 1.25rem;
  }
  @media (min-width: 640px) {
    .kit-timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  .kit-timeline li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .kit-timeline strong {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: #fff;
  }
  .kit-hero-photo {
    position: relative;
  }
  .kit-hero-photo[data-sample]::after {
    content: attr(data-sample);
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.25rem 0.65rem;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(17, 17, 17, 0.72);
    border-radius: var(--radius-full);
  }
  .kit-hero-photo {
    border-radius: var(--radius-card);
    overflow: hidden;
    max-height: 34rem;
  }
  .kit-hero-photo img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 34rem;
    object-fit: cover;
    object-position: center 28%;
  }

  /* ---------- Terms + contact ---------- */
  .kit-terms-list {
    margin: 0;
    padding-left: 1.3rem;
    display: grid;
    gap: 0.65rem;
    max-width: 52rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .kit-contact {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 720px) {
    .kit-contact { grid-template-columns: minmax(0, 1fr) auto; }
  }
  .kit-contact-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
  }
  .kit-contact-line span {
    color: var(--color-text-secondary);
  }
  .kit-contact-line a {
    color: var(--color-accent);
  }
  .kit-contact-qr {
    margin: 0;
    text-align: center;
  }
  .kit-contact-qr img {
    width: 11rem;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
  .kit-contact-qr figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }
</style>
