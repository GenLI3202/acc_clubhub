---
export const prerender = true;
// src/pages/[lang]/uniform.astro
// 2026 kit: the design story, an order flow (choose -> pay -> Google Form),
// the size guide and the order terms. Reached from the About page banner.
//
// Static HTML carries all the story, terms and contact text; only the order
// flow and the size finder hydrate. Orders close 25 Oct 2026 (see
// lib/uniform/pricing.ts), decided in the browser so the page needs no rebuild.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { SizeGuide } from '../../components/uniform/SizeGuide';
import { UniformShop } from '../../components/uniform/UniformShop';
import { locales, type Locale } from '../../lib/i18n';
import { getUniformCopy } from '../../lib/uniform/copy';
import type { SymbolKey } from '../../lib/uniform/copy/types';
import { PAYMENT } from '../../lib/uniform/payment';
import '../../components/uniform/uniform.css';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const copy = getUniformCopy(lang);
const { hero, story, terms, contact } = copy;

const SYMBOL_FILES: Record<SymbolKey, string> = {
  mountains: 'mountain-rider',
  paths: 'parallel',
  borders: 'bridge',
  across: 'crossing',
};
---

<BaseLayout title={copy.meta.title} lang={lang} heroImagePreload="/images/uniform/model-front.webp">
  <section slot="hero" class="kit-hero">
    <div class="kit-hero-inner">
      <div class="kit-hero-text">
        <p class="kit-hero-eyebrow">{hero.eyebrow}</p>
        <h1 class="kit-hero-title">{hero.title}</h1>
        <p class="kit-hero-lede">{hero.lede}</p>
        <p class="kit-hero-deadline">{hero.deadline}</p>
        <a class="kit-btn kit-btn--solid" href="#kit-shop">{hero.cta}</a>
        <ol class="kit-timeline">
          {hero.timeline.map((item) => (
            <li>
              <strong>{item.when}</strong>
              <span>{item.what}</span>
            </li>
          ))}
        </ol>
      </div>
      <div class="kit-hero-photo" data-sample={copy.shop.sampleBadge}>
        <img
          src="/images/uniform/model-front.webp"
          alt={copy.shop.imageAlt.front}
          width="1086"
          height="1448"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <article class="kit-page">
    <section class="kit-wrap kit-story" aria-labelledby="kit-story-title">
      <div class="kit-story-grid">
        <div>
          <p class="kit-eyebrow">{story.eyebrow}</p>
          <h2 class="kit-h2" id="kit-story-title">{story.title}</h2>
          {story.paragraphs.map((paragraph) => <p class="kit-story-p">{paragraph}</p>)}
          <p class="kit-produced">{story.producedBy}</p>
        </div>
        <figure class="kit-story-photo" data-sample={copy.shop.sampleBadge}>
          <img
            src="/images/uniform/model-back.webp"
            alt={copy.shop.imageAlt.back}
            width="1086"
            height="1448"
            loading="lazy"
          />
        </figure>
      </div>

      <figure class="kit-flat">
        <img
          src="/images/uniform/flat-jersey.webp"
          alt={copy.shop.imageAlt.flat}
          width="1400"
          height="890"
          loading="lazy"
        />
      </figure>

      <div class="kit-meaning">
        <div>
          <h3 class="kit-h3">{story.symbolsTitle}</h3>
          <ul class="kit-symbols">
            {story.symbols.map((symbol) => (
              <li>
                <img
                  src={`/images/about/symbols/${SYMBOL_FILES[symbol.key]}.svg`}
                  alt=""
                  width="72"
                  height="48"
                  loading="lazy"
                />
                <span>{symbol.name}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="kit-h3">{story.detailsTitle}</h3>
          <dl class="kit-details">
            {story.details.map((detail) => (
              <div>
                <dt>{detail.title}</dt>
                <dd>{detail.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <aside class="kit-sample" role="note">
        <strong>{story.sampleTitle}</strong>
        <p>{story.sampleText}</p>
      </aside>
    </section>

    <section class="kit-wrap" aria-label={copy.shop.title}>
      <UniformShop client:load lang={lang} />
    </section>

    <section class="kit-wrap" id="size-guide" aria-labelledby="kit-size-title">
      <SizeGuide client:visible lang={lang} />
    </section>

    <section class="kit-wrap kit-terms" id="kit-terms" aria-labelledby="kit-terms-title">
      <h2 class="kit-h2" id="kit-terms-title">{terms.title}</h2>
      <ol class="kit-terms-list">
        {terms.items.map((item) => <li>{item}</li>)}
      </ol>
    </section>

    <section class="kit-wrap kit-contact" aria-labelledby="kit-contact-title">
      <div>
        <h2 class="kit-h2" id="kit-contact-title">{contact.title}</h2>
        <p class="kit-lede">{contact.body}</p>
        <p class="kit-contact-line">
          <span>{contact.email}</span>
          <a href={`mailto:${PAYMENT.contact.email}`}>{PAYMENT.contact.email}</a>
        </p>
      </div>
      <figure class="kit-contact-qr">
        <img
          src={PAYMENT.contact.wechatQrImage}
          alt={contact.wechat}
          width="240"
          height="320"
          loading="lazy"
        />
        <figcaption>{contact.wechat}</figcaption>
      </figure>
    </section>
  </article>
</BaseLayout>

<style>
  .kit-wrap {
    max-width: min(1280px, 100% - 2rem);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 0;
  }
  :global(main:has(.kit-page)) {
    padding-top: 0;
    padding-bottom: clamp(3rem, 8vw, 6rem);
    max-width: none;
  }

  /* ---------- Hero ---------- */
  .kit-hero {
    background: #111;
    color: #fff;
  }
  .kit-hero-inner {
    max-width: min(1280px, 100% - 2rem);
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 3.5rem) 0;
    align-items: center;
  }
  @media (min-width: 900px) {
    .kit-hero-inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }
  .kit-hero-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 0.6rem;
  }
  .kit-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 700;
    color: #fff; /* global h1 colour is near-black; the hero is dark */
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .kit-hero-lede {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    max-width: 30rem;
    margin: 0 0 1.25rem;
  }
  .kit-hero-deadline {
    display: inline-block;
    font-size: 0.875rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-md);
    margin: 0 0 1.5rem;
  }
  .kit-hero-text .kit-btn {
    display: flex;
    width: fit-content;
  }
  .kit-timeline {
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    display: grid;
    gap: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 1.25rem;
  }
  @media (min-width: 640px) {
    .kit-timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  .kit-timeline li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .kit-timeline strong {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: #fff;
  }
  .kit-hero-photo,
  .kit-story-photo {
    position: relative;
  }
  .kit-hero-photo[data-sample]::after,
  .kit-story-photo[data-sample]::after {
    content: attr(data-sample);
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.25rem 0.65rem;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(17, 17, 17, 0.72);
    border-radius: var(--radius-full);
  }
  .kit-hero-photo {
    border-radius: var(--radius-card);
    overflow: hidden;
    max-height: 34rem;
  }
  .kit-hero-photo img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 34rem;
    object-fit: cover;
    object-position: center 30%;
  }

  /* ---------- Story ---------- */
  .kit-story-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .kit-story-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }
  .kit-story-p {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.85;
    margin: 0 0 1.1rem;
    max-width: 40rem;
  }
  .kit-produced {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary);
    margin: 1.5rem 0 0;
  }
  .kit-story-photo,
  .kit-flat {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-bg-secondary);
  }
  .kit-story-photo img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 34rem;
    object-fit: cover;
  }
  .kit-flat {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    background: #fff;
    border: 1px solid var(--color-border);
  }
  .kit-flat img {
    display: block;
    width: 100%;
    height: auto;
  }
  .kit-meaning {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .kit-meaning { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  }
  .kit-h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }
  .kit-symbols {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
  }
  .kit-symbols li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .kit-symbols img {
    height: 2.75rem;
    width: auto;
    align-self: flex-start;
  }
  .kit-details {
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .kit-details div {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .kit-details dt {
    font-family: var(--font-heading);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .kit-details dd {
    margin: 0;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }
  .kit-sample {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding: 1.1rem 1.4rem;
    border-left: 4px solid var(--color-accent);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
  }
  .kit-sample p {
    margin: 0.4rem 0 0;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  /* ---------- Terms + contact ---------- */
  .kit-terms-list {
    margin: 0;
    padding-left: 1.3rem;
    display: grid;
    gap: 0.65rem;
    max-width: 52rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .kit-contact {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 720px) {
    .kit-contact { grid-template-columns: minmax(0, 1fr) auto; }
  }
  .kit-contact-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
  }
  .kit-contact-line span {
    color: var(--color-text-secondary);
  }
  .kit-contact-line a {
    color: var(--color-accent);
  }
  .kit-contact-qr {
    margin: 0;
    text-align: center;
  }
  .kit-contact-qr img {
    width: 11rem;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
  .kit-contact-qr figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }
</style>
