---
export const prerender = true;
// src/pages/[lang]/routes/[slug].astro
// 骑行路线 - 详情页

import BaseLayout from '../../../layouts/BaseLayout.astro';
import WalineComments from '../../../components/WalineComments.astro';
import { getCollection, render } from 'astro:content';
import { getLangFromEntry, t, type Locale } from '../../../lib/i18n';
import { getFilterLabel } from '../../../lib/i18n/filterTranslations';
import { format_route_distance } from '../../../lib/routes/route_metrics';

export async function getStaticPaths() {
  const allRoutes = await getCollection('routes');
  return allRoutes.map((entry) => {
    const lang = getLangFromEntry(entry.filePath, 'routes');
    return {
      params: { lang, slug: entry.data.slug },
      props: { entry },
    };
  });
}

type Props = {
  entry: Awaited<ReturnType<typeof getCollection<'routes'>>>[number];
};

const { entry } = Astro.props;
const { lang } = Astro.params as { lang: Locale };
const { Content } = await render(entry);

// 难度标签翻译
const difficultyLabels: Record<string, Record<string, string>> = {
  zh: { easy: '简单', medium: '中等', hard: '困难', expert: '专家' },
  en: { easy: 'Easy', medium: 'Medium', hard: 'Hard', expert: 'Expert' },
  de: { easy: 'Leicht', medium: 'Mittel', hard: 'Schwer', expert: 'Experte' },
};

const difficultyColors: Record<string, string> = {
  easy: '#4ade80',
  medium: '#facc15',
  hard: '#f97316',
  expert: '#ef4444',
};

const route_actions = {
  zh: {
    eyebrow: "路线导航",
    title: "打开完整路线",
    description: "前往路线平台查看完整轨迹、路况信息并开始导航。",
    komoot_label: "在 Komoot 查看完整路线",
    strava_label: "在 Strava 查看完整路线",
  },
  en: {
    eyebrow: "Route navigation",
    title: "Open the full route",
    description: "View the full track, route details and navigation options.",
    komoot_label: "View full route on Komoot",
    strava_label: "View full route on Strava",
  },
  de: {
    eyebrow: "Routennavigation",
    title: "Komplette Route öffnen",
    description: "Strecke, Routendetails und Navigation beim Anbieter ansehen.",
    komoot_label: "Komplette Route bei Komoot ansehen",
    strava_label: "Komplette Route bei Strava ansehen",
  },
} as const;

const route_action = route_actions[lang];
---


<BaseLayout title={entry.data.name} lang={lang}>
  <article class="route-detail">
    <header class="route-header">
      <a href={`/${lang}/routes`} class="route-back">
        ← {t(lang, 'nav.routes')}
      </a>

      <h1>{entry.data.name}</h1>
      
      <div class="route-meta-row">
        <div>
           <p class="route-region">📍 {getFilterLabel('region', entry.data.region, lang)}</p>
           {entry.data.author && <p class="route-author">By {entry.data.author}</p>}
        </div>

        {entry.data.xiaohongshuUrl && (
          <a href={entry.data.xiaohongshuUrl} target="_blank" rel="noopener" class="xhs-link">
            小红书 (Xiaohongshu) ↗
          </a>
        )}
      </div>
    </header>

    {entry.data.cover && (
      <img src={entry.data.cover} alt={entry.data.name} class="route-cover" />
    )}

    <div class="route-stats">
      <div class="stat">
        <span class="stat-value">
          {format_route_distance(entry.data.distance, entry.data.distanceRange, lang)}
        </span>
        <span class="stat-label">{lang === 'zh' ? '距离' : lang === 'de' ? 'Distanz' : 'Distance'}</span>
      </div>
      {entry.data.elevation !== undefined && (
        <div class="stat">
          <span class="stat-value">{entry.data.elevation} m</span>
          <span class="stat-label">{lang === 'zh' ? '累计爬升' : lang === 'de' ? 'Anstieg' : 'Elevation gain'}</span>
        </div>
      )}
      <div class="stat">
        <span
          class="stat-value stat-difficulty"
          style={`color: ${difficultyColors[entry.data.difficulty]}`}
        >
          {difficultyLabels[lang][entry.data.difficulty]}
        </span>
        <span class="stat-label">{lang === 'zh' ? '难度' : lang === 'de' ? 'Schwierigkeit' : 'Difficulty'}</span>
      </div>
    </div>

    <section class="route-platforms" aria-labelledby="route-platforms-title">
      <div class="route-platforms__copy">
        <p class="route-platforms__eyebrow">{route_action.eyebrow}</p>
        <h2 id="route-platforms-title">{route_action.title}</h2>
        <p class="route-platforms__description">
          {route_action.description}
        </p>
      </div>

      <div class="route-links">
        {entry.data.stravaUrl && (
          <a
            href={entry.data.stravaUrl}
            target="_blank"
            rel="noopener"
            class="route-link route-link--strava"
            aria-label={route_action.strava_label}
          >
            <span class="route-link__brand">Strava</span>
            <span class="route-link__label">
              {route_action.strava_label}
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        )}
        {entry.data.komootUrl && (
          <a
            href={entry.data.komootUrl}
            target="_blank"
            rel="noopener"
            class="route-link route-link--komoot"
            aria-label={route_action.komoot_label}
          >
            <span class="route-link__brand">Komoot</span>
            <span class="route-link__label">
              {route_action.komoot_label}
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        )}
      </div>
    </section>

    <div class="route-content prose">
      <Content />
    </div>

    <WalineComments lang={lang} />
  </article>
</BaseLayout>

<style>
  .route-detail {
    max-width: 800px;
    margin: 0 auto;
  }

  .route-header {
    margin-bottom: var(--space-lg);
  }

  .route-back {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .route-back:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .route-header h1 {
    font-size: 2.2rem;
    line-height: 1.2;
    margin-bottom: var(--space-xs);
  }

  .route-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end; /* Align bottom to match text baselines better if needed */
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .route-region {
    font-size: 1.1rem;
    color: #666;
    margin: 0;
  }

  .route-author {
    font-size: 0.9rem;
    color: #888;
    margin: 4px 0 0 0;
    font-style: italic;
  }

  .xhs-link {
    display: inline-block;
    padding: 2px 8px;
    background-color: #ff2442;
    color: white;
    font-size: 0.8rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .xhs-link:hover {
    opacity: 0.9;
    text-decoration: none;
    color: white;
  }

  .route-cover {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: var(--radius-aero);
    border: 2px solid var(--color-border-rough);
    margin-bottom: var(--space-lg);
  }

  .route-stats {
    display: flex;
    gap: var(--space-lg);
    padding: var(--space-md);
    background: rgba(255, 255, 255, 0.7);
    border: 2px solid var(--color-border-rough);
    border-radius: var(--radius-aero);
    margin-bottom: var(--space-lg);
  }

  .stat {
    text-align: center;
    flex: 1;
  }

  .stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.85rem;
    color: #666;
  }

  .stat-difficulty {
    font-size: 1.5rem;
  }

  .route-platforms {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-lg);
    color: var(--color-text-light);
    background: var(--color-primary);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--space-lg);
  }

  .route-platforms__eyebrow {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .route-platforms h2 {
    margin: 0;
    color: inherit;
    font-size: 1.6rem;
  }

  .route-platforms__description {
    margin: var(--space-sm) 0 0;
    color: inherit;
    line-height: 1.6;
  }

  .route-links {
    display: grid;
    gap: var(--space-sm);
  }

  .route-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    font-family: var(--font-heading);
    color: var(--color-primary);
    background: var(--color-bg-canvas);
    border: 2px solid var(--color-bg-canvas);
    border-radius: var(--radius-btn);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .route-link__brand {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .route-link__label {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    font-size: 1rem;
    font-weight: 700;
  }

  .route-link:hover {
    color: var(--color-text-light);
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    text-decoration: none;
    transform: translateY(-0.125rem);
  }

  .route-link:focus-visible {
    outline: auto;
    outline-offset: var(--space-xs);
  }

  .route-content {
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .route-content :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .route-content :global(p) {
    margin-bottom: var(--space-md);
  }

  .route-content :global(ul) {
    margin-bottom: var(--space-md);
    padding-left: 1.5rem;
  }

  .route-content :global(h2:last-of-type) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border-strong);
  }

  .route-content :global(h2:last-of-type)::before {
    content: "↗";
    display: grid;
    place-items: center;
    width: var(--space-lg);
    height: var(--space-lg);
    color: var(--color-text-light);
    background: var(--color-accent);
    border-radius: var(--radius-full);
  }

  .route-content :global(h2:last-of-type + ul) {
    display: grid;
    gap: var(--space-sm);
    margin: 0 0 var(--space-lg);
    padding: 0;
    list-style: none;
  }

  .route-content :global(h2:last-of-type + ul li) {
    margin: 0;
  }

  .route-content :global(h2:last-of-type + ul a) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md);
    color: var(--color-primary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-btn);
    box-shadow: var(--shadow-sm);
    font-weight: 700;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .route-content :global(h2:last-of-type + ul a)::after {
    content: "↗";
    flex: none;
    color: var(--color-accent);
    font-size: 1.2rem;
  }

  .route-content :global(h2:last-of-type + ul a:hover) {
    color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-0.125rem);
  }

  .route-content :global(h2:last-of-type + ul a:focus-visible) {
    outline: auto;
    outline-offset: var(--space-xs);
  }

  .route-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-md);
  }

  .route-content :global(th),
  .route-content :global(td) {
    padding: var(--space-sm);
    border: 1px solid var(--color-border-rough);
    text-align: left;
  }

  .route-content :global(th) {
    background: rgba(45, 93, 155, 0.1);
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .route-platforms {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      padding: var(--space-md);
    }
  }
</style>
