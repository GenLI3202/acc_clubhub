---
export const prerender = true;
// src/pages/[lang]/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, t, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const tagline =
  lang === 'zh' ? '慕尼黑骑行社群，自由骑行，一路同行。'
  : lang === 'de' ? 'Münchner Radsportgemeinschaft. Frei fahren, gemeinsam weiter.'
  : 'Munich cycling community. Ride free, ride together.';

const ctaLabel =
  lang === 'zh' ? '加入下次骑行 →'
  : lang === 'de' ? 'Nächste Ausfahrt →'
  : 'Join Next Ride →';

const sections = [
  {
    title: lang === 'zh' ? '慕城日常' : lang === 'de' ? 'Münchner Alltag' : 'Munich Daily',
    href: `/${lang}/events`,
    description:
      lang === 'zh' ? 'Social Ride、Training Day、活动报名'
      : lang === 'de' ? 'Social Ride, Training Day, Anmeldung'
      : 'Social Ride, Training Day, Registration',
  },
  {
    title: lang === 'zh' ? '车影骑踪' : lang === 'de' ? 'Medien Archiv' : 'Media Archive',
    href: `/${lang}/media`,
    description:
      lang === 'zh' ? '影像资料、骑友访谈、翻山越岭记录'
      : lang === 'de' ? 'Videos, Interviews, Bergabenteuer'
      : 'Videos, Interviews, Mountain Adventures',
  },
  {
    title: lang === 'zh' ? '器械知识' : lang === 'de' ? 'Ausrüstung' : 'Gear Guide',
    href: `/${lang}/knowledge/gear`,
    description:
      lang === 'zh' ? '购车指南、维修 Workshop、新品解读'
      : lang === 'de' ? 'Kaufberatung, Workshops, Neuheiten'
      : 'Buying Guide, Workshops, New Products',
  },
  {
    title: lang === 'zh' ? '科学训练' : lang === 'de' ? 'Wissenschaft' : 'Science Training',
    href: `/${lang}/knowledge/training`,
    description:
      lang === 'zh' ? '训练方法论、安全科普'
      : lang === 'de' ? 'Trainingsmethoden, Sicherheit'
      : 'Training Methods, Safety Tips',
  },
  {
    title: lang === 'zh' ? '骑行路线库' : lang === 'de' ? 'Routendatenbank' : 'Route Database',
    href: `/${lang}/routes`,
    description:
      lang === 'zh' ? '可搜索路线数据库、Strava/Komoot 链接'
      : lang === 'de' ? 'Suchbare Routen, Strava/Komoot Links'
      : 'Searchable Routes, Strava/Komoot Links',
  },
];
---
export const prerender = true;

<BaseLayout title={t(lang, 'nav.home')} lang={lang} headerTransparent={true} heroImagePreload="/images/uploads/RR120-SONNTAG-cPIARAZZI-20.jpg">

  <!-- Hero: full-width, breaks out of main's max-width -->
  <section slot="hero" class="homepage-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Across Cycling Club · München</p>
      <h1 class="hero-title">ACC ClubHub</h1>
      <p class="hero-tagline">{tagline}</p>
      <a href={`/${lang}/events`} class="hero-cta">{ctaLabel}</a>
    </div>
  </section>

  <!-- Section cards grid -->
  <div class="hub-grid">
    {sections.map((section) => (
      <a href={section.href} class="hub-card">
        <h3>{section.title}</h3>
        <p>{section.description}</p>
      </a>
    ))}
  </div>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .homepage-hero {
    position: relative;
    width: 100%;
    height: 85vh;
    min-height: 480px;
    max-height: 760px;
    overflow: hidden;
    background-image: url('/images/uploads/RR120-SONNTAG-cPIARAZZI-20.jpg');
    background-size: cover;
    background-position: center 40%;
    display: flex;
    align-items: flex-end;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.35) 50%,
      rgba(0, 0, 0, 0.1) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 3rem 2rem;
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
  }

  .hero-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }

  .hero-tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 2rem;
    max-width: 480px;
    line-height: 1.5;
  }

  .hero-cta {
    display: inline-block;
    background: var(--color-accent);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.75rem 2rem;
    border-radius: var(--radius-btn);
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: var(--shadow-md);
  }

  .hero-cta:hover {
    background: var(--color-accent-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    color: #ffffff;
    text-decoration: none;
  }

  /* ---- Hub grid spacing ---- */
  .hub-grid {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
</style>
