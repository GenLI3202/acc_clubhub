---
export const prerender = true;
// src/pages/[lang]/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { locales, defaultLocale, t, type Locale } from "../../lib/i18n";
import { splitEvents, isEventInSection } from "../../lib/events/eventHelpers";
import { resolveRecurringEvents } from "../../lib/events/recurringEvents";
import HomeHero from "../../components/home/HomeHero.astro";
import NextRideBanner from "../../components/home/NextRideBanner.astro";
import MembershipTeaser from "../../components/home/MembershipTeaser.astro";
import PillarSection from "../../components/home/PillarSection.astro";
import SplashScreen from "../../components/home/SplashScreen.astro";
import StravaWidget from "../../components/home/StravaWidget.astro";
import SponsorStrip from "../../components/home/SponsorStrip.astro";

export function getStaticPaths() {
    return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

// --- Data fetching ---
const allEvents = await getCollection("events");
const langEvents = allEvents.filter((e) => {
    const entryLang = e.id.includes("/") ? e.id.split("/")[0] : defaultLocale;
    return entryLang === lang && e.data.status !== "draft" && e.data.directOnly !== true;
});
const effectiveEvents = resolveRecurringEvents(langEvents);
const { upcoming } = splitEvents(effectiveEvents);
const heroEvent = upcoming[0] ?? null;

// Hero carousel: upcoming events flagged for the hero section. Events with an
// explicit heroPriority lead (lower first); the rest follow by soonest date.
// The brand slide is prepended inside HomeHero, so this may safely be empty.
const heroCarouselEvents = upcoming
    .filter((e) => isEventInSection(e, "hero"))
    .sort((a, b) => {
        const pa = a.data.heroPriority ?? Number.POSITIVE_INFINITY;
        const pb = b.data.heroPriority ?? Number.POSITIVE_INFINITY;
        if (pa !== pb) return pa - pb;
        return new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf();
    })
    .slice(0, 3);

const eventItems = upcoming.slice(0, 2).map((e) => ({
    title: e.data.title,
    href: `/${lang}/events/${e.data.slug ?? e.id.split("/").pop()}`,
    meta: new Date(e.data.date).toLocaleDateString(
        lang === "zh" ? "zh-CN" : lang === "de" ? "de-DE" : "en-GB",
        { month: "short", day: "numeric" },
    ),
}));

const allMedia = await getCollection("media");
const mediaItems = allMedia
    .filter((e) => {
        const entryLang = e.id.includes("/")
            ? e.id.split("/")[0]
            : defaultLocale;
        return entryLang === lang;
    })
    .sort(
        (a, b) =>
            new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
    )
    .slice(0, 2)
    .map((e) => ({
        title: e.data.title,
        href: `/${lang}/media/${e.data.slug ?? e.id.split("/").pop()}`,
    }));

const allTraining = await getCollection("training");
const trainingItems = allTraining
    .filter((e) => {
        const entryLang = e.id.includes("/")
            ? e.id.split("/")[0]
            : defaultLocale;
        return entryLang === lang && e.data.status !== "draft";
    })
    .sort(
        (a, b) =>
            new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
    )
    .slice(0, 2)
    .map((e) => ({
        title: e.data.title,
        href: `/${lang}/knowledge/training/${e.data.slug ?? e.id.split("/").pop()}`,
    }));

const allRoutes = await getCollection("routes");
const routeItems = allRoutes
    .filter((e) => {
        const entryLang = e.id.includes("/")
            ? e.id.split("/")[0]
            : defaultLocale;
        return entryLang === lang;
    })
    .slice(0, 2)
    .map((e) => ({
        title: e.data.name,
        href: `/${lang}/routes/${e.data.slug ?? e.id.split("/").pop()}`,
        meta: `${e.data.distance}km · ${e.data.elevation}m`,
    }));
---

<BaseLayout
    title={t(lang, "nav.home")}
    lang={lang}
    headerTransparent={true}
    heroImagePreload="/images/home/acc-hero-group.jpg"
>
    <SplashScreen />

    <!-- Hero carousel: full-width, breaks out of main's max-width -->
    <HomeHero slot="hero" lang={lang} events={heroCarouselEvents} />

    <!-- Next Ride Banner -->
    <NextRideBanner event={heroEvent} lang={lang} />

    <!-- Membership Teaser -->
    <MembershipTeaser lang={lang} />

    <!-- Strava Floating Widget -->
    <StravaWidget lang={lang} />

    <!-- Content Pillar Sections -->
    <PillarSection
        title={t(lang, "home.events.title")}
        subtitle={t(lang, "home.events.subtitle")}
        ctaLabel={t(lang, "home.viewAll")}
        ctaHref={`/${lang}/events`}
        imageUrl="/images/media/adventure/rad-race-120-2025/gallery/2026-group-turn.jpg"
        imageAlt="ACC group ride"
        imagePosition="left"
        alternate={false}
        items={eventItems}
    />

    <PillarSection
        title={t(lang, "home.media.title")}
        subtitle={t(lang, "home.media.subtitle")}
        ctaLabel={t(lang, "home.viewAll")}
        ctaHref={`/${lang}/media`}
        imageUrl="/images/media/video/alps-summer-2025/cover.jpg"
        imageAlt="ACC media archive"
        imagePosition="right"
        alternate={true}
        items={mediaItems}
    />

    <PillarSection
        title={t(lang, "home.training.title")}
        subtitle={t(lang, "home.training.subtitle")}
        ctaLabel={t(lang, "home.viewAll")}
        ctaHref={`/${lang}/knowledge/training`}
        imageUrl="/images/media/adventure/rad-race-120-2025/gallery/2025-sonntag.jpg"
        imageAlt="Training ride"
        imagePosition="left"
        alternate={false}
        items={trainingItems}
        comingSoon={trainingItems.length === 0
            ? t(lang, "home.comingSoon")
            : undefined}
    />

    <PillarSection
        title={t(lang, "home.routes.title")}
        subtitle={t(lang, "home.routes.subtitle")}
        ctaLabel={t(lang, "home.viewAll")}
        ctaHref={`/${lang}/routes`}
        imageUrl="/images/shared/stock/munich-cycling.jpg"
        imageAlt="Cycling route landscape"
        imagePosition="right"
        alternate={true}
        items={routeItems}
    />

    <PillarSection
        title={t(lang, "home.gear.title")}
        subtitle={t(lang, "home.gear.subtitle")}
        ctaLabel={t(lang, "home.viewAll")}
        ctaHref={`/${lang}/knowledge/gear`}
        imageUrl="/images/shared/stock/bike-fitting.jpg"
        imageAlt="Bike fitting and gear workshop"
        imagePosition="left"
        alternate={false}
        comingSoon={t(lang, "home.comingSoon")}
    />

    <SponsorStrip lang={lang} />
</BaseLayout>

