---
export const prerender = true;
// src/pages/[lang]/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { locales, defaultLocale, t, type Locale } from "../../lib/i18n";
import { splitEvents } from "../../lib/events/eventHelpers";
import NextRideBanner from "../../components/home/NextRideBanner.astro";
import PillarSection from "../../components/home/PillarSection.astro";
import SplashScreen from "../../components/home/SplashScreen.astro";
import StravaWidget from "../../components/home/StravaWidget.astro";

export function getStaticPaths() {
    return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

// --- Data fetching ---
const allEvents = await getCollection("events");
const langEvents = allEvents.filter((e) => {
    const entryLang = e.id.includes("/") ? e.id.split("/")[0] : defaultLocale;
    return entryLang === lang;
});
const { upcoming } = splitEvents(langEvents);
const heroEvent = upcoming[0] ?? null;

const eventItems = upcoming.slice(0, 2).map((e) => ({
    title: e.data.title,
    href: `/${lang}/events/${e.data.slug ?? e.id.split("/").pop()}`,
    meta: new Date(e.data.date).toLocaleDateString(
        lang === "zh" ? "zh-CN" : lang === "de" ? "de-DE" : "en-GB",
        { month: "short", day: "numeric" },
    ),
}));

const allMedia = await getCollection("media");
const mediaItems = allMedia
    .filter((e) => {
        const entryLang = e.id.includes("/")
            ? e.id.split("/")[0]
            : defaultLocale;
        return entryLang === lang;
    })
    .sort(
        (a, b) =>
            new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
    )
    .slice(0, 2)
    .map((e) => ({
        title: e.data.title,
        href: `/${lang}/media/${e.data.slug ?? e.id.split("/").pop()}`,
    }));

const allRoutes = await getCollection("routes");
const routeItems = allRoutes
    .filter((e) => {
        const entryLang = e.id.includes("/")
            ? e.id.split("/")[0]
            : defaultLocale;
        return entryLang === lang;
    })
    .slice(0, 2)
    .map((e) => ({
        title: e.data.name,
        href: `/${lang}/routes/${e.data.slug ?? e.id.split("/").pop()}`,
        meta: `${e.data.distance}km · ${e.data.elevation}m`,
    }));
---

<BaseLayout
    title={t(lang, "nav.home")}
    lang={lang}
    headerTransparent={true}
    heroImagePreload="/images/media/adventure/rad-race-120-2025/gallery/2026-group.jpg"
>
    <SplashScreen />

    <!-- Hero: full-width, breaks out of main's max-width -->
    <section slot="hero" class="homepage-hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <p class="hero-eyebrow">Across Cycling Club · München</p>
            <h1 class="hero-title">ACC ClubHub</h1>
            <p class="hero-tagline">{t(lang, "home.tagline")}</p>
            <a href={`/${lang}/events`} class="hero-cta">
                {t(lang, "home.heroCta")}
            </a>
        </div>
    </section>

    <!-- Next Ride Banner -->
    <NextRideBanner event={heroEvent} lang={lang} />

    <!-- Strava Floating Widget -->
    <StravaWidget lang={lang} />

    <!-- Content Pillar Sections -->
    <PillarSection
        title={t(lang, "home.events.title")}
        subtitle={t(lang, "home.events.subtitle")}
        ctaLabel={t(lang, "home.viewAll")}
        ctaHref={`/${lang}/events`}
        imageUrl="/images/media/adventure/rad-race-120-2025/gallery/2026-group-turn.jpg"
        imageAlt="ACC group ride"
        imagePosition="left"
        alternate={false}
        items={eventItems}
    />

    <PillarSection
        title={t(lang, "home.media.title")}
        subtitle={t(lang, "home.media.subtitle")}
        ctaLabel={t(lang, "home.viewAll")}
        ctaHref={`/${lang}/media`}
        imageUrl="/images/media/video/alps-summer-2025/cover.jpg"
        imageAlt="ACC media archive"
        imagePosition="right"
        alternate={true}
        items={mediaItems}
    />

    <PillarSection
        title={t(lang, "home.gear.title")}
        subtitle={t(lang, "home.gear.subtitle")}
        ctaLabel={t(lang, "home.viewAll")}
        ctaHref={`/${lang}/knowledge/gear`}
        imageUrl="/images/shared/stock/canyon-road-bike.webp"
        imageAlt="Cycling gear"
        imagePosition="left"
        alternate={false}
        comingSoon={t(lang, "home.comingSoon")}
    />

    <PillarSection
        title={t(lang, "home.training.title")}
        subtitle={t(lang, "home.training.subtitle")}
        ctaLabel={t(lang, "home.viewAll")}
        ctaHref={`/${lang}/knowledge/training`}
        imageUrl="/images/media/adventure/rad-race-120-2025/gallery/2025-sonntag.jpg"
        imageAlt="Training ride"
        imagePosition="right"
        alternate={true}
        comingSoon={t(lang, "home.comingSoon")}
    />

    <PillarSection
        title={t(lang, "home.routes.title")}
        subtitle={t(lang, "home.routes.subtitle")}
        ctaLabel={t(lang, "home.viewAll")}
        ctaHref={`/${lang}/routes`}
        imageUrl="/images/shared/stock/munich-cycling.jpg"
        imageAlt="Cycling route landscape"
        imagePosition="left"
        alternate={false}
        items={routeItems}
    />
</BaseLayout>

<style>
    /* ---- Hero ---- */
    .homepage-hero {
        position: relative;
        width: 100%;
        height: 85vh;
        min-height: 480px;
        max-height: 760px;
        overflow: hidden;
        background-image: url("/images/media/adventure/rad-race-120-2025/gallery/2026-group.jpg");
        background-size: cover;
        background-position: center 40%;
        display: flex;
        align-items: flex-end;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.75) 0%,
            rgba(0, 0, 0, 0.35) 50%,
            rgba(0, 0, 0, 0.1) 100%
        );
    }

    .hero-content {
        position: relative;
        z-index: 1;
        padding: 3rem 2rem;
        max-width: var(--max-width);
        margin: 0 auto;
        width: 100%;
    }

    .hero-eyebrow {
        font-family: var(--font-heading);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 0.5rem;
    }

    .hero-title {
        font-family: var(--font-heading);
        font-size: clamp(3rem, 8vw, 5.5rem);
        font-weight: 700;
        color: #ffffff;
        line-height: 1;
        margin-bottom: 1rem;
        letter-spacing: -0.03em;
    }

    .hero-tagline {
        font-family: var(--font-body);
        font-size: clamp(1rem, 2vw, 1.2rem);
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 2rem;
        max-width: 480px;
        line-height: 1.5;
    }

    .hero-cta {
        display: inline-block;
        background: var(--color-accent);
        color: #ffffff;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.75rem 2rem;
        border-radius: var(--radius-btn);
        text-decoration: none;
        transition:
            background var(--transition-fast),
            transform var(--transition-fast),
            box-shadow var(--transition-fast);
        box-shadow: var(--shadow-md);
    }

    .hero-cta:hover {
        background: var(--color-accent-dark);
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
        color: #ffffff;
        text-decoration: none;
    }
</style>
