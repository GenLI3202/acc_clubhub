---
export const prerender = true;
// src/pages/[lang]/ride-leader.astro
// ACC Ride Leader — public overview page

import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, locales } from '../../lib/i18n';

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Locale };

const content = {
  zh: {
    title: '领骑权利与义务',
    subtitle: 'Ride Leader Charter · ACC 2026/27',
    intro: '领骑（Ride Leader）是 ACC 骑行文化的核心。ACC 的领骑们是自愿付出时间与热情带领队伍的骑友。以下是领骑角色的概要说明；完整章程与补贴政策将在资格认定后单独签署。',
    backLink: { label: '← 返回会员页面', href: `/${lang}/membership` },
    rights: {
      heading: '领骑权益',
      note: '资格认定后，领骑将享有以下专属权益：',
      items: [
        { n: '01', title: '官网单车展示', desc: '个人专属单车展示于 About Us 页面 Stamp Bike Wall 专区，成为 ACC 对外形象的一部分。' },
        { n: '02', title: '专属领骑队服', desc: '领骑版队服设有与标准会员队服区分的专属标识。' },
        { n: '03', title: '带队补贴', desc: '每次带队活动享有俱乐部补贴，按参与领骑人数均分。' },
        { n: '04', title: '年度里程奖励', desc: '年度领骑里程达到约定门槛后，享有会费报销及超额里程奖励。具体数值见章程协议。' },
        { n: '05', title: '社媒激励金', desc: '发布 ACC 相关内容至小红书或 Instagram，依赞数与收藏数获得现金奖励。具体规则见章程协议。' },
      ],
    },
    duties: {
      heading: '领骑义务',
      note: '担任领骑须承担以下职责：',
      items: [
        { n: '01', title: '出行安全', desc: '执行骑前头盔检查；把握合理车速与队形；路口等候确认安全后方可示意通行；日落后开灯。' },
        { n: '02', title: '带队全流程', desc: '集合时核实名单与非会员缴费；骑行中定期清点人数、处理掉队；解散后 24 小时内完成数据录入。' },
        { n: '03', title: '文明骑行', desc: '遵守德国道路交通法（StVO）；礼让行人；禁止公共道路竞速。' },
        { n: '04', title: '应急响应', desc: '成员受伤时第一响应（必要时拨打 112）；处理机械故障；极端天气下有权取消或缩短路线。' },
      ],
    },
    charter: {
      heading: '完整章程',
      body: '领骑章程详细载明补贴政策、社媒激励规则、违规处理流程及权责划分。章程在领骑资格认定后由俱乐部与领骑双方签署确认。',
    },
  },
  en: {
    title: 'Ride Leader Charter',
    subtitle: 'Rights & Responsibilities · ACC 2026/27',
    intro: 'Ride Leaders are the backbone of ACC\'s cycling culture. ACC\'s ride leaders are fellow cyclists who voluntarily give their time and expertise to lead the group. The following is a public overview of the role; the full charter and compensation policy are signed separately upon confirmation of ride leader status.',
    backLink: { label: '← Back to membership', href: `/${lang}/membership` },
    rights: {
      heading: 'Ride Leader Rights',
      note: 'Upon confirmation, ride leaders receive the following exclusive benefits:',
      items: [
        { n: '01', title: 'Website feature', desc: 'Your personal bike is displayed on the About Us page in the Stamp Bike Wall section, making you part of ACC\'s public identity.' },
        { n: '02', title: 'Exclusive ride leader kit', desc: 'Ride leader kit features a distinguishing mark not found on standard member kit.' },
        { n: '03', title: 'Per-ride subsidy', desc: 'A club subsidy is paid after each led ride, split equally among participating ride leaders.' },
        { n: '04', title: 'Annual mileage reward', desc: 'Ride leaders who meet the annual mileage threshold qualify for membership fee reimbursement and over-performance bonuses. Specific figures in the charter agreement.' },
        { n: '05', title: 'Social media incentive', desc: 'Cash rewards for ACC-related posts on 小红书 (RedNote) or Instagram, based on likes and saves. Specific rules in the charter agreement.' },
      ],
    },
    duties: {
      heading: 'Ride Leader Duties',
      note: 'Taking on the ride leader role means committing to the following responsibilities:',
      items: [
        { n: '01', title: 'Ride safety', desc: 'Enforce helmet checks; manage pace and formation; hold at junctions until safe to proceed; lights on after sunset.' },
        { n: '02', title: 'Ride workflow', desc: 'Verify attendance and non-member fees at the start; count heads during the ride; submit ride data within 24 hours of finishing.' },
        { n: '03', title: 'Respectful riding', desc: 'Comply with German road traffic law (StVO); give way to pedestrians; no racing on public roads.' },
        { n: '04', title: 'Emergency response', desc: 'First response for injuries (call 112 if needed); handle mechanicals; authority to cancel or shorten in extreme weather.' },
      ],
    },
    charter: {
      heading: 'Full Charter',
      body: 'The full ride leader charter details the subsidy policy, social media incentive rules, disciplinary process, and allocation of responsibilities. The charter is signed between the club and the ride leader upon confirmation of status.',
    },
  },
  de: {
    title: 'Tourguide-Charta',
    subtitle: 'Rechte & Pflichten · ACC 2026/27',
    intro: 'Tourguides sind das Herzstück der ACC-Fahrradkultur. ACCs Tourguides sind Mitradfahrer, die freiwillig ihre Zeit und Erfahrung einbringen, um die Gruppe zu führen. Die folgende Seite bietet eine öffentliche Übersicht der Rolle; die vollständige Charta und Vergütungsregelungen werden nach Bestätigung des Tourguide-Status gesondert unterzeichnet.',
    backLink: { label: '← Zurück zur Mitgliedschaft', href: `/${lang}/membership` },
    rights: {
      heading: 'Rechte der Tourguides',
      note: 'Nach Bestätigung erhalten Tourguides folgende exklusive Vorteile:',
      items: [
        { n: '01', title: 'Darstellung auf der Website', desc: 'Ihr persönliches Fahrrad wird auf der About Us-Seite in der Stamp Bike Wall Section präsentiert.' },
        { n: '02', title: 'Exklusives Tourguide-Trikot', desc: 'Das Tourguide-Trikot trägt eine besondere Kennzeichnung, die es vom Standard-Mitgliedertrikot unterscheidet.' },
        { n: '03', title: 'Vergütung pro Ausfahrt', desc: 'Nach jeder geführten Ausfahrt wird eine Vereinsvergütung gleichmäßig auf alle teilnehmenden Tourguides aufgeteilt.' },
        { n: '04', title: 'Kilometerprämie', desc: 'Tourguides, die den Jahreskm-Richtwert erreichen, erhalten Beitragsrückerstattung und Mehrleistungsbonus. Genaue Werte in der Charta.' },
        { n: '05', title: 'Social-Media-Prämie', desc: 'Barauszahlungen für ACC-bezogene Beiträge auf 小红书 oder Instagram nach Likes und Saves. Regeln in der Charta.' },
      ],
    },
    duties: {
      heading: 'Pflichten der Tourguides',
      note: 'Die Übernahme der Tourguide-Rolle umfasst folgende Verantwortlichkeiten:',
      items: [
        { n: '01', title: 'Fahrsicherheit', desc: 'Helmkontrolle durchführen; Tempo und Formation managen; an Kreuzungen warten bis es sicher ist; Lichter nach Sonnenuntergang einschalten.' },
        { n: '02', title: 'Ablauf der Ausfahrt', desc: 'Teilnehmerliste und Nichtmitgliedgebühren zu Beginn prüfen; während der Fahrt Köpfe zählen; Fahrtdaten innerhalb von 24 Stunden einpflegen.' },
        { n: '03', title: 'Respektvolles Fahren', desc: 'StVO einhalten; Fußgänger Vorrang geben; kein Rennen auf öffentlichen Straßen.' },
        { n: '04', title: 'Notfallreaktion', desc: 'Erste Reaktion bei Verletzungen (ggf. 112 anrufen); Pannen beheben; Befugnis zur Absage oder Verkürzung bei Extremwetter.' },
      ],
    },
    charter: {
      heading: 'Vollständige Charta',
      body: 'Die vollständige Tourguide-Charta enthält Details zur Vergütungspolitik, Social-Media-Prämienregeln, Disziplinarverfahren und Haftungsverteilung. Die Charta wird nach Bestätigung des Tourguide-Status zwischen Verein und Tourguide unterzeichnet.',
    },
  },
};

const c = content[lang];
---

<BaseLayout title={c.title} lang={lang}>
  <article class="rl-page">

    <header class="rl-header">
      <a href={c.backLink.href} class="rl-back-link">{c.backLink.label}</a>
      <h1>{c.title}</h1>
      <p class="rl-subtitle">{c.subtitle}</p>
    </header>

    <div class="rl-intro">
      <p>{c.intro}</p>
    </div>

    {/* ── RIGHTS ── */}
    <section class="rl-block">
      <div class="rl-block-header">
        <div class="rl-eyebrow">{c.rights.heading}</div>
        <p class="rl-block-note">{c.rights.note}</p>
      </div>
      <div class="rl-list">
        {c.rights.items.map((item) => (
          <div class="rl-row">
            <div class="rl-row-num">{item.n}</div>
            <div class="rl-row-title">{item.title}</div>
            <div class="rl-row-desc">{item.desc}</div>
          </div>
        ))}
      </div>
    </section>

    {/* ── DUTIES ── */}
    <section class="rl-block rl-block--alt">
      <div class="rl-block-header">
        <div class="rl-eyebrow">{c.duties.heading}</div>
        <p class="rl-block-note">{c.duties.note}</p>
      </div>
      <div class="rl-list">
        {c.duties.items.map((item) => (
          <div class="rl-row">
            <div class="rl-row-num">{item.n}</div>
            <div class="rl-row-title">{item.title}</div>
            <div class="rl-row-desc">{item.desc}</div>
          </div>
        ))}
      </div>
    </section>

    {/* ── CHARTER NOTE ── */}
    <section class="rl-charter-note">
      <div class="rl-charter-icon" aria-hidden="true">◆</div>
      <h2 class="rl-charter-heading">{c.charter.heading}</h2>
      <p class="rl-charter-body">{c.charter.body}</p>
    </section>

    <footer class="rl-footer">
      <a href={c.backLink.href} class="rl-back-link">{c.backLink.label}</a>
    </footer>

  </article>
</BaseLayout>

<style>
  .rl-page {
    max-width: 860px;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }

  /* ── back link ── */
  .rl-back-link {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    text-decoration: none;
    margin-bottom: var(--space-md);
    transition: opacity 150ms ease;
  }
  .rl-back-link:hover { opacity: 0.7; }

  /* ── header ── */
  .rl-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 3px solid var(--color-border-rough);
  }
  .rl-header h1 {
    font-size: 2.5rem;
    color: var(--color-primary);
    margin: var(--space-xs) 0;
  }
  .rl-subtitle {
    color: #888;
    font-size: 0.95rem;
    font-style: italic;
    margin: 0;
  }

  /* ── intro box ── */
  .rl-intro {
    background: rgba(42, 92, 166, 0.05);
    padding: var(--space-lg);
    border-left: 4px solid var(--color-primary);
    margin-bottom: var(--space-xl);
    border-radius: 4px;
  }
  .rl-intro p {
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  /* ── section blocks ── */
  .rl-block {
    padding: 48px 0;
    border-top: 1px solid var(--color-border-rough);
  }
  .rl-block--alt {
    background: rgba(0,0,0,0.02);
    padding: 48px 32px;
    margin: 0 -32px;
    border-top: none;
    border-radius: 4px;
  }

  .rl-block-header {
    margin-bottom: 32px;
  }
  .rl-eyebrow {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 8px;
  }
  .rl-block-note {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: #666;
    margin: 0;
    font-style: italic;
  }

  /* ── row list ── */
  .rl-list {
    display: flex;
    flex-direction: column;
  }
  .rl-row {
    display: grid;
    grid-template-columns: 52px 180px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
    align-items: baseline;
  }
  .rl-row-num {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.12em;
  }
  .rl-row-title {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text-main);
    letter-spacing: -0.01em;
  }
  .rl-row-desc {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  /* ── charter note ── */
  .rl-charter-note {
    margin-top: 56px;
    padding: 36px 40px;
    border: 1px solid var(--color-border-rough);
    border-radius: 4px;
    text-align: center;
  }
  .rl-charter-icon {
    font-size: 10px;
    color: var(--color-accent);
    letter-spacing: 0.3em;
    margin-bottom: 16px;
  }
  .rl-charter-heading {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .rl-charter-body {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: #555;
    margin: 0;
    max-width: 560px;
    margin-inline: auto;
  }

  /* ── footer ── */
  .rl-footer {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border-rough);
    margin-top: var(--space-xl);
  }

  /* ── responsive ── */
  @media (max-width: 768px) {
    .rl-page { padding: var(--space-md); }
    .rl-header h1 { font-size: 1.9rem; }
    .rl-block--alt { padding: 40px 20px; margin: 0 -20px; }
    .rl-row {
      grid-template-columns: 40px 1fr;
      grid-template-rows: auto auto;
    }
    .rl-row-desc { grid-column: 1 / -1; padding-left: 40px; }
    .rl-charter-note { padding: 28px 20px; }
  }
</style>
