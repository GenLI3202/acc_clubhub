        '</svg>',

        // 3. Gliding Crane / Dove (素描滑翔白鹤 — 舒展双翼工写兼备)
        '<svg viewBox="0 0 52 30" fill="none" aria-hidden="true" style="display:block;width:100%;height:100%;overflow:visible;filter:url(#acc-ink-wash);">' +
          '<path d="M26 13 C17 3, 9 2, 2 9 C11 11, 19 15, 25 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />' +
          '<path d="M26 13 C35 3, 43 2, 50 9 C41 11, 33 15, 27 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />' +
          '<path d="M6 9 C13 14, 20 18, 25 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.8" />' +
          '<path d="M46 9 C39 14, 32 18, 27 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.8" />' +
          '<path d="M11 12 C18 17, 22 20, 26 22" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.6" />' +
          '<path d="M41 12 C34 17, 30 20, 26 22" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.6" />' +
          '<path d="M26 12 C24 15, 24 19, 26 23 C28 19, 28 15, 26 12 Z" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="1.3" />' +
          '<circle cx="26" cy="10" r="1.5" fill="currentColor" />' +
          '<path d="M24 23 L22 29" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />' +
          '<path d="M26 23 L26 30" stroke="currentColor" stroke-width="2.0" stroke-linecap="round" />' +
          '<path d="M28 23 L30 29" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />' +
          '<path d="M2 9 C11 5, 20 7, 26 13 C32 7, 41 5, 50 9 C42 16, 34 21, 26 23 C18 21, 10 16, 2 9 Z" fill="currentColor" fill-opacity="0.13" />' +
        '</svg>',

        // 4. Banking Alpine Chough (高山悬崖翻飞 — 昂首掠影灵动)
        '<svg viewBox="0 0 46 42" fill="none" aria-hidden="true" style="display:block;width:100%;height:100%;overflow:visible;filter:url(#acc-ink-wash);">' +
          '<path d="M19 22 C13 13, 8 5, 5 1 C10 8, 15 16, 19 25" stroke="currentColor" stroke-width="3.0" stroke-linecap="round" stroke-linejoin="round" />' +
          '<path d="M8 4 C13 11, 17 18, 20 27" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.8" />' +
          '<path d="M22 24 C28 22, 36 21, 43 23 C36 27, 29 30, 24 33" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />' +
          '<path d="M39 24 C33 28, 28 31, 23 34" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.75" />' +
          '<path d="M19 20 C18 18, 19 16, 21 16 C23 16, 23 18, 22 21 Z" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1.4" />' +
          '<path d="M22 17 L25 16" stroke="currentColor" stroke-width="2.0" stroke-linecap="round" />' +
          '<path d="M21 32 C19 36, 16 39, 13 41" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />' +
          '<path d="M22 32 C22 36, 22 39, 21 42" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.85" />' +
          '<path d="M5 1 C11 7, 16 14, 20 22 C27 21, 35 21, 43 23 C34 28, 27 33, 22 33 C17 29, 11 18, 5 1 Z" fill="currentColor" fill-opacity="0.13" />' +
        '</svg>'
      ];

      // Palette strictly sampled from the alpine ridge contours (深灰、绿、红、蓝)
      const BIRD_PALETTE_LIGHT = [
        '#2D312E', '#1B7A43', '#C92A2A', '#0084B4',
        '#454B46', '#22864C', '#DC2626', '#0284C7'
      ];
      const BIRD_PALETTE_DARK = [
        '#E4E8E5', '#4ADE80', '#F87171', '#38BDF8',
        '#F2F5F3', '#22C55E', '#EF4444', '#60A5FA'
      ];

      function setupBirdsContainer(container) {
        const roads = document.querySelector('.roads');
        if (!roads || !container) {
          return {
            width: window.innerWidth,
            height: window.innerHeight,
            isPortrait: window.innerHeight > window.innerWidth
          };
        }
        const rect = roads.getBoundingClientRect();
        const top = Math.max(0, rect.top);
        const bottom = Math.min(window.innerHeight, rect.bottom);
        const height = Math.max(260, bottom - top);

        // Constrain the bird flock layer strictly to the visible .roads mountain section
        container.style.position = 'fixed';
        container.style.top = `${top}px`;
        container.style.left = '0px';
        container.style.width = '100vw';
        container.style.height = `${height}px`;
        container.style.overflow = 'hidden';
        container.style.pointerEvents = 'none';

        return {
          width: window.innerWidth,
          height: height,
          isPortrait: window.innerHeight > window.innerWidth
        };
      }

      function spawnBirdsAssemble(container) {
        container.innerHTML = '';
        const b = setupBirdsContainer(container);
        const isDark = document.documentElement.classList.contains('dark');
        const palette = isDark ? BIRD_PALETTE_DARK : BIRD_PALETTE_LIGHT;
        const fragment = document.createDocumentFragment();

        // Enlarged +50% art bird size: 78px - 110px desktop, 60px - 82px portrait
        const baseSize = b.isPortrait ? 60 : 78;
        const sizeRange = b.isPortrait ? 22 : 32;

        // 5 Cohesive Formations (Total 54 birds):
        // 1. Top-Left High Alpine (11)
        // 2. Top-Right High Alpine (11)
        // 3. Left Mountain Slope (12)
        // 4. Right Mountain Slope (12)
        // 5. Upper ACROSS Sky (8)
        const formations = [
          { count: 11, type: 'top-left' },
          { count: 11, type: 'top-right' },
          { count: 12, type: 'left' },
          { count: 12, type: 'right' },
          { count: 8, type: 'top' }
        ];

        let birdIndex = 0;
        formations.forEach((f) => {
          for (let i = 0; i < f.count; i++) {
            const bird = document.createElement('span');
            bird.className = 'bird-particle bird-converge';

            let sx, sy, tx, ty, sRot;

            if (f.type === 'top-left') {
              // Diagonal swoop from top-left high sky to top-left area of card
              sx = -(b.width * 0.35) - (i * 22) - Math.random() * 25;
              sy = -(b.height * 0.36) - (i * 8) - Math.random() * 15;
              tx = -(b.isPortrait ? 80 : 160) + (Math.random() - 0.5) * 120;
              ty = -(b.isPortrait ? 60 : 90) + (Math.random() - 0.5) * 80;
              sRot = (Math.atan2(ty - sy, tx - sx) * 180 / Math.PI) + (Math.random() - 0.5) * 6;
            } else if (f.type === 'top-right') {
              // Diagonal swoop from top-right high sky to top-right area of card
              sx = (b.width * 0.35) + (i * 22) + Math.random() * 25;
              sy = -(b.height * 0.36) - (i * 8) - Math.random() * 15;
              tx = (b.isPortrait ? 80 : 160) + (Math.random() - 0.5) * 120;
              ty = -(b.isPortrait ? 60 : 90) + (Math.random() - 0.5) * 80;
              sRot = (Math.atan2(ty - sy, tx - sx) * 180 / Math.PI) + (Math.random() - 0.5) * 6;
            } else if (f.type === 'left') {
              // Left mid-mountain slope echelon to left wing of card
              const streamOffset = (i - f.count / 2) * 18;
              sx = -(b.width * 0.40) - (i * 24) - Math.random() * 30;
              sy = streamOffset + (Math.random() - 0.5) * 20;
              tx = -(b.isPortrait ? 90 : 180) + (Math.random() - 0.5) * 100;
              ty = (Math.random() - 0.5) * (b.isPortrait ? 120 : 180);
              sRot = (Math.atan2(ty - sy, tx - sx) * 180 / Math.PI) + (Math.random() - 0.5) * 6;
            } else if (f.type === 'right') {
              // Right mid-mountain slope echelon to right wing of card
              const streamOffset = (i - f.count / 2) * 18;
              sx = (b.width * 0.40) + (i * 24) + Math.random() * 30;
              sy = streamOffset + (Math.random() - 0.5) * 20;
              tx = (b.isPortrait ? 90 : 180) + (Math.random() - 0.5) * 100;
              ty = (Math.random() - 0.5) * (b.isPortrait ? 120 : 180);
              sRot = (Math.atan2(ty - sy, tx - sx) * 180 / Math.PI) + (Math.random() - 0.5) * 6;
            } else {
              // Upper ACROSS sky echelon to card center-top
              sx = (i - f.count / 2) * 44 + (Math.random() - 0.5) * 20;
              sy = -(b.height * 0.40) - Math.random() * 15;
              tx = (Math.random() - 0.5) * (b.isPortrait ? 140 : 260);
              ty = (Math.random() - 0.5) * 100;
              sRot = (Math.atan2(ty - sy, tx - sx) * 180 / Math.PI) + (Math.random() - 0.5) * 8;
            }

            const tRot = sRot + (Math.random() - 0.5) * 10;
            const size = baseSize + (i % 4) * (sizeRange / 4) + Math.random() * 4;
            const dur = 0.68 + (i * 0.018) + Math.random() * 0.06;
            const delay = i * 0.028; // clean echelon sequence
            const wingDur = 0.36 + Math.random() * 0.08;
            const svgTemplate = BIRD_SVGS[birdIndex % BIRD_SVGS.length];
            const color = palette[birdIndex % palette.length];
            birdIndex++;

            bird.style.cssText = `
              position: absolute;
              left: 50%;
              top: 50%;
              width: ${size.toFixed(1)}px;
              height: ${(size * 0.62).toFixed(1)}px;
              margin-left: -${(size * 0.5).toFixed(1)}px;
              margin-top: -${(size * 0.31).toFixed(1)}px;
              color: ${color};
              display: block;
              pointer-events: none;
              will-change: transform, opacity;
              --sx: ${sx.toFixed(1)}px;
              --sy: ${sy.toFixed(1)}px;
              --tx: ${tx.toFixed(1)}px;
              --ty: ${ty.toFixed(1)}px;
              --s-rot: ${sRot.toFixed(1)}deg;
              --t-rot: ${tRot.toFixed(1)}deg;
              --b-size: ${size.toFixed(1)}px;
              --fly-dur: ${dur.toFixed(2)}s;
              --fly-delay: ${delay.toFixed(2)}s;
              --wing-dur: ${wingDur.toFixed(2)}s;
              --b-color: ${color};
            `;
            bird.innerHTML = svgTemplate;
            fragment.appendChild(bird);
          }
        });
        container.appendChild(fragment);
      }

      function spawnBirdsScatter(container) {
        container.innerHTML = '';
        const b = setupBirdsContainer(container);
        const isDark = document.documentElement.classList.contains('dark');
        const palette = isDark ? BIRD_PALETTE_DARK : BIRD_PALETTE_LIGHT;
        const fragment = document.createDocumentFragment();

        const baseSize = b.isPortrait ? 60 : 78;
        const sizeRange = b.isPortrait ? 22 : 32;

        // 3 Downward Streams into Mountain Forest (Total 54 birds):
        // Left Ridge Stream (18), Right Ridge Stream (18), Center Valley Stream (18)
        const streams = [
          { count: 18, dir: 'left' },
          { count: 18, dir: 'right' },
          { count: 18, dir: 'center' }
        ];

        let birdIndex = 0;
        streams.forEach((s) => {
          for (let i = 0; i < s.count; i++) {
            const bird = document.createElement('span');
            bird.className = 'bird-particle bird-scatter';

            // Start across the card body
            const cx = (Math.random() - 0.5) * (b.isPortrait ? 260 : 440);
            const cy = (Math.random() - 0.5) * 140;

            let dx, dy, dRot;
            // The mountain ridges live at dy = +b.height * 0.24 ~ +b.height * 0.38
            // Strictly staying above the bottom edge of .roads!
            const targetRidgeY = (b.height * 0.24) + (Math.random() * (b.height * 0.14));

            if (s.dir === 'left') {
              // Swoop into left mountain ridge
              dx = -(b.width * 0.16) - (i * 15) - Math.random() * 25;
              dy = targetRidgeY;
              dRot = (Math.atan2(dy - cy, dx - cx) * 180 / Math.PI) + (Math.random() - 0.5) * 8;
            } else if (s.dir === 'right') {
              // Swoop into right mountain ridge
              dx = (b.width * 0.16) + (i * 15) + Math.random() * 25;
              dy = targetRidgeY;
              dRot = (Math.atan2(dy - cy, dx - cx) * 180 / Math.PI) + (Math.random() - 0.5) * 8;
            } else {
              // Swoop straight down into center mountain valley
              dx = (i - s.count / 2) * 32 + (Math.random() - 0.5) * 20;
              dy = targetRidgeY + 15;
              dRot = (Math.atan2(dy - cy, dx - cx) * 180 / Math.PI) + (Math.random() - 0.5) * 10;
            }

            const sRot = dRot - 10 + (Math.random() - 0.5) * 14;
            const size = baseSize + (i % 4) * (sizeRange / 4) + Math.random() * 4;
            const dur = 0.72 + (i * 0.015) + Math.random() * 0.06;
            const delay = i * 0.022;
            const wingDur = 0.34 + Math.random() * 0.08;
            const svgTemplate = BIRD_SVGS[birdIndex % BIRD_SVGS.length];
            const color = palette[birdIndex % palette.length];
            birdIndex++;

            bird.style.cssText = `
              position: absolute;
              left: 50%;
              top: 50%;
              width: ${size.toFixed(1)}px;
              height: ${(size * 0.62).toFixed(1)}px;
              margin-left: -${(size * 0.5).toFixed(1)}px;
              margin-top: -${(size * 0.31).toFixed(1)}px;
              color: ${color};
              display: block;
              pointer-events: none;
              will-change: transform, opacity;
              --cx: ${cx.toFixed(1)}px;
              --cy: ${cy.toFixed(1)}px;
              --dx: ${dx.toFixed(1)}px;
              --dy: ${dy.toFixed(1)}px;
              --s-rot: ${sRot.toFixed(1)}deg;
              --d-rot: ${dRot.toFixed(1)}deg;
              --b-size: ${size.toFixed(1)}px;
              --fly-dur: ${dur.toFixed(2)}s;
              --fly-delay: ${delay.toFixed(2)}s;
              --wing-dur: ${wingDur.toFixed(2)}s;
              --b-color: ${color};
            `;
            bird.innerHTML = svgTemplate;
            fragment.appendChild(bird);
          }
        });
        container.appendChild(fragment);
      }

      function open(sheet) {
        lastFocus = document.activeElement;
        sheet.hidden = false;
        void sheet.offsetWidth;
        document.body.style.overflow = 'hidden';

        const birds = sheet.querySelector('.sheet-birds');
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (birds && !prefersReduced) {
          sheet.classList.remove('assembled', 'scattering');
          sheet.classList.add('open', 'assembling');
          spawnBirdsAssemble(birds);

          window.setTimeout(() => {
            sheet.classList.add('assembled');
            sheet.classList.remove('assembling');
          }, 360);

          window.setTimeout(() => {
            birds.innerHTML = '';
          }, 900);
        } else {
          sheet.classList.add('open');
        }

        const x = sheet.querySelector('.sheet-x');
        if (x) x.focus();
      }

      function close(sheet) {
        sheet.dispatchEvent(new CustomEvent('member:close'));
        document.body.style.overflow = '';
        const birds = sheet.querySelector('.sheet-birds');
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (birds && !prefersReduced) {
          sheet.classList.remove('open', 'assembling', 'assembled');
          sheet.classList.add('scattering');
          spawnBirdsScatter(birds);

          window.setTimeout(() => {
            sheet.hidden = true;
            sheet.classList.remove('scattering');
            birds.innerHTML = '';
          }, 900);
        } else {
          sheet.classList.remove('open');
          window.setTimeout(() => { sheet.hidden = true; }, 240);
        }

        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }

      function openSheet() { return sheets.find((s) => !s.hidden); }

      sheets.forEach((sheet) => {
        sheet.querySelectorAll('[data-sheet-close]').forEach((el) => {
          el.addEventListener('click', () => close(sheet));
        });
      });
      document.addEventListener('keydown', (e) => {
        const sheet = openSheet();
        if (!sheet) return;
        if (e.key === 'Escape') close(sheet);
      });

      // ---- chapter sheet ----
      const chapter = document.querySelector('[data-sheet="chapter"]');
      if (chapter) {
        const cards = Array.from(chapter.querySelectorAll('[data-card]'));
      const dialog = chapter.querySelector('[role="dialog"]');
      let current = 0;

      function show(i) {
        current = (i + total) % total;
        cards.forEach((card, n) => {
          const open = n === current;
          card.classList.toggle('is-open', open);
          // Closed chapters stay in the DOM but out of the tab order and
          // the accessibility tree; only their spine remains reachable.
          const body = card.querySelector('.card-body');
          if (body) {
            if (open) {
              body.removeAttribute('inert');
              body.scrollTop = 0;
            } else {
              body.setAttribute('inert', '');
            }
            body.setAttribute('aria-hidden', open ? 'false' : 'true');
          }
          const spine = card.querySelector('.card-spine');
          if (spine) spine.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        const idiom = cards[current] && cards[current].querySelector('.card-idiom');
        if (dialog && idiom) dialog.setAttribute('aria-label', idiom.textContent);
      }

      document.querySelectorAll('[data-open]').forEach((btn) => {
        btn.addEventListener('click', () => {
          show(Number(btn.getAttribute('data-open')));
          open(chapter);
        });
      });
      chapter.querySelectorAll('[data-card-open]').forEach((btn) => {
        btn.addEventListener('click', () =>
          show(Number(btn.getAttribute('data-card-open'))));
      });

      document.addEventListener('keydown', (e) => {
        if (chapter.hidden) return;
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });

      // Touch swipe between chapters on mobile
      let touchStartX = 0;
      let touchStartY = 0;
      chapter.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
        }
      }, { passive: true });
      chapter.addEventListener('touchend', (e) => {
        if (chapter.hidden || !e.changedTouches.length) return;
        const deltaX = e.changedTouches[0].clientX - touchStartX;
        const deltaY = e.changedTouches[0].clientY - touchStartY;
        // Trigger if horizontal movement is dominant and > 45px
        if (Math.abs(deltaX) > 45 && Math.abs(deltaX) > Math.abs(deltaY) * 1.4) {
          if (deltaX < 0) show(current + 1);
          else show(current - 1);
        }
      }, { passive: true });

      show(0);
    }

    // ---- interactive touch & drag controller for the reel ----
    const reel = document.querySelector('[data-reel]');
    const reelTrack = document.querySelector('[data-reel-track]');
    if (reel && reelTrack) {
      let isDown = false;
      let startX = 0;
      let dragDistance = 0;
      let currentX = 0;
      let isHovered = false;
      let lastTime = null;
      const speed = 32; // px per second (~75s per pass)

      // Use JS animation loop so touch drag directly offsets position smoothly
      reelTrack.style.animation = 'none';

      reel.addEventListener('mouseenter', () => { isHovered = true; });
      reel.addEventListener('mouseleave', () => { isHovered = false; });

      function getPassWidth() {
        return (reelTrack.scrollWidth / 4) || 1000;
      }

      function step(time) {
        if (!lastTime) lastTime = time;
        const dt = Math.min((time - lastTime) / 1000, 0.1);
        lastTime = time;

        if (!isDown && !isHovered) {
          currentX -= speed * dt;
          const passWidth = getPassWidth();
          while (currentX < -passWidth) currentX += passWidth;
          while (currentX > 0) currentX -= passWidth;
          reelTrack.style.transform = `translate3d(${currentX}px, 0, 0)`;
        }

        requestAnimationFrame(step);
      }
      requestAnimationFrame(step);

      function onTouchStart(e) {
        isDown = true;
        dragDistance = 0;
        startX = e.touches ? e.touches[0].clientX : e.clientX;
      }

      function onTouchMove(e) {
        if (!isDown) return;
        const x = e.touches ? e.touches[0].clientX : e.clientX;
        const delta = x - startX;
        startX = x;
        dragDistance += Math.abs(delta);

        currentX += delta;
        const passWidth = getPassWidth();
        while (currentX < -passWidth) currentX += passWidth;
        while (currentX > 0) currentX -= passWidth;
        reelTrack.style.transform = `translate3d(${currentX}px, 0, 0)`;
      }

      function onTouchEnd() {
        if (!isDown) return;
        isDown = false;
        // Suppress accidental click on child buttons if user dragged > 10px
        if (dragDistance > 10) {
          const captureClick = (ev) => {
            ev.stopPropagation();
            ev.preventDefault();
          };
          reel.addEventListener('click', captureClick, { capture: true, once: true });
        }
      }

      reel.addEventListener('touchstart', onTouchStart, { passive: true });
      reel.addEventListener('touchmove', onTouchMove, { passive: true });
      reel.addEventListener('touchend', onTouchEnd, { passive: true });
      reel.addEventListener('touchcancel', onTouchEnd, { passive: true });

      reel.addEventListener('mousedown', onTouchStart);
      window.addEventListener('mousemove', onTouchMove);
      window.addEventListener('mouseup', onTouchEnd);
    }

      // ---- member sheet ----
      const member = document.querySelector('[data-sheet="member"]');
      if (member) {
        const byId = Object.fromEntries(members.map((m) => [m.id, m]));
        const elPhoto = member.querySelector('[data-member-photo]');
        const elRole = member.querySelector('[data-member-role]');
        const elName = member.querySelector('[data-member-name]');
        const elBio = member.querySelector('[data-member-bio]');
        const elMeta = member.querySelector('[data-member-meta]');

        document.querySelectorAll('[data-member]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const m = byId[btn.getAttribute('data-member')];
            if (!m) return;
            elPhoto.src = m.photo;
            elPhoto.alt = m.bike;
            elRole.textContent = m.role;
            elName.textContent = m.name;
            elBio.textContent = m.bio;
            elMeta.textContent = m.bike + ' · ' + m.tenure;
            open(member);
            if (btn.closest('[aria-hidden="true"]')) {
              lastFocus = document.querySelector(
                `.garage-lane:not([aria-hidden]) [data-member="${m.id}"]`,
              );
            }
            member.querySelector('.deck--solo').scrollTop = 0;
            member.dispatchEvent(new CustomEvent('member:open'));
          });
        });
      }
    })();
  </script>
  <script>
    import { init_garage } from "../../lib/about/garage";
    init_garage();
  </script>
</BaseLayout>

