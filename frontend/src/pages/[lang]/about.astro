---
export const prerender = true;
// src/pages/[lang]/about.astro
// About page — phase 9 redesign.
//
// Built inside the site's own V4 "Rapha-Inspired Modern" system (see
// styles/variables.css): photography-led, Jost headings, Inter body,
// no ornament. The three ACROSS chapters read as a quiet triptych —
// English title plus the Chinese idiom — and open into a detail
// overlay that carries the full prose. The prose ships in the markup
// (visually hidden, not injected) so crawlers and screen readers get
// the whole page without interacting.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, t, type Locale } from '../../lib/i18n';
import { MEMBERS } from '../../lib/about/members';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const pageTitle = t(lang, 'nav.about');

// Every ride photo on this page is a stand-in. Flip to false once real
// photography lands — it drops the stripe overlay and the corner badge.
const PHOTOS_ARE_PLACEHOLDER = true;

const CHAPTERS = [
  {
    id: 'paths',
    en: 'Across paths',
    symbol: '/images/about/symbols/parallel.svg',
    photo: '/images/about/placeholder/paths.jpg',
    idiom: t(lang, 'about.ch1Idiom'),
    gloss: t(lang, 'about.ch1Gloss'),
    prose: t(lang, 'about.ch1Prose'),
  },
  {
    id: 'mountains',
    en: 'Across mountains',
    symbol: '/images/about/symbols/mountain-rider.svg',
    photo: '/images/about/placeholder/mountains.jpg',
    idiom: t(lang, 'about.ch2Idiom'),
    gloss: t(lang, 'about.ch2Gloss'),
    prose: t(lang, 'about.ch2Prose'),
  },
  {
    id: 'borders',
    en: 'Across borders',
    symbol: '/images/about/symbols/bridge.svg',
    photo: '/images/about/placeholder/borders.jpg',
    idiom: t(lang, 'about.ch3Idiom'),
    gloss: t(lang, 'about.ch3Gloss'),
    prose: t(lang, 'about.ch3Prose'),
  },
] as const;

const phClass = PHOTOS_ARE_PLACEHOLDER ? 'is-placeholder' : '';
const phNote = t(lang, 'about.placeholderNote');
---

<BaseLayout title={pageTitle} lang={lang}>
  {/* Hero rides BaseLayout's named slot so it sits outside <main>'s
      max-width box — the same escape HomeHero uses on the homepage. */}
  <section slot="hero" class:list={['about-hero', phClass]} data-ph-note={phNote}>
    <img class="about-hero-img" src="/images/about/placeholder/hero.jpg" alt="" />
    <div class="about-hero-scrim"></div>

    <div class="about-hero-inner">
      <img class="about-hero-mark" src="/images/about/acc-wordmark.svg" alt="ACC" width="700" height="230" />
      <p class="about-hero-eyebrow">{t(lang, 'about.eyebrow')}</p>
      <h1 class="about-hero-title">Across</h1>
      <p class="about-hero-meta">Across Cycling Club · München · 2023</p>
      <p class="about-hero-lede">{t(lang, 'about.heroLede')}</p>
      <a class="btn-solid" href="#join">{t(lang, 'about.heroCta')}</a>
    </div>
  </section>

  <article class="about">
    {/* ============================================================
        2. THE THREE ROADS — quiet by default, prose lives in the
           overlay below
       ============================================================ */}
    <section class="roads" aria-labelledby="roads-heading">
      {/* The club's own name, split. Three unrelated idioms don't read as
          one idea on their own — before this, the only thing tying them
          together was the English on the cards, which is backwards on a
          page written for Chinese readers. Splitting 穿越无疆 does that
          work in Chinese, and it shows rather than explains: the name
          comes apart here and closes back up in the calligraphy at the
          foot of the page. ACROSS sits above it because naming the shared
          word is the one thing the Chinese can't do for itself. */}
      <div class="roads-intro" data-reveal>
        <h2 class="roads-word" id="roads-heading">Across</h2>
        <p class="roads-name">
          <span>穿</span><i aria-hidden="true">·</i><span>越</span><i aria-hidden="true">·</i><span>无疆</span>
        </p>
      </div>

    </section>

    {/* A film strip: the ridge line runs unbroken behind all three and
        both layers drift, so the concepts read as one continuous reel
        rather than three boxes.

        The track holds four passes and travels exactly one pass (-25%)
        before looping, so it lands frame-perfect on the next copy. Four
        is what keeps the strip full at the end of the travel: three
        passes must still cover the viewport, which holds to ~3600px.
        Pass 0 is the real one; the rest are hidden from assistive tech
        and untabbable, but stay clickable. */}
    <div class="reel" data-reel>
      <div class="reel-ridge" aria-hidden="true"></div>
      <div class="reel-fade reel-fade--l" aria-hidden="true"></div>
      <div class="reel-fade reel-fade--r" aria-hidden="true"></div>

      <div class="reel-track" data-reel-track>
        {[0, 1, 2, 3].map((pass) =>
          CHAPTERS.map((c, i) => (
            <button
              class="concept"
              type="button"
              data-open={i}
              aria-haspopup="dialog"
              aria-hidden={pass > 0 ? 'true' : undefined}
              tabindex={pass > 0 ? -1 : undefined}
            >
              <img class="concept-symbol" src={c.symbol} alt="" width="60" height="40" />
              <span class="concept-en">{c.en}</span>
              <span class="concept-idiom">{c.idiom}</span>
              {c.gloss && <span class="concept-gloss">{c.gloss}</span>}
              <span class="concept-cue" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13"/><path d="m12 6 6 6-6 6"/></svg>
              </span>
            </button>
          )),
        )}
      </div>
    </div>

    {/* ============================================================
        3. CODA
       ============================================================ */}
    <section class="coda bleed" data-reveal>
      <p class="coda-lead">{t(lang, 'about.codaLead')}</p>
      <img class="coda-mark" src="/images/about/chuanyue-wujiang.png" alt="穿越无疆" />
      <p class="coda-sub">Across · Paths · Mountains · Borders</p>
    </section>

    {/* ============================================================
        4. OUR GARAGE
       ============================================================ */}
    <section class="garage">
      <div class="garage-head" data-reveal>
        <p class="eyebrow">{t(lang, 'about.sectionRuleGarage')}</p>
        <h2 class="garage-h2">{t(lang, 'about.garageH2Prefix')}</h2>
        <p class="garage-lede">{t(lang, 'about.garageDesc')}</p>
      </div>

      <ul class="garage-grid">
        {MEMBERS.map((m) => (
          <li class="bike-card" data-reveal>
            <button class="bike-btn" type="button" data-member={m.id} aria-haspopup="dialog">
              <span class="bike-stage">
                <img class="bike-ring" src="/images/about/logo-stamp-red-transparent.png" alt="" />
                <img class="bike-photo" src={m.photo} alt="" loading="lazy" />
              </span>
              <span class="bike-name">{m.name}</span>
              <span class="bike-meta">{m.bike} · {m.joined}</span>
            </button>
          </li>
        ))}
      </ul>
    </section>

    {/* ============================================================
        5. CONTACT
       ============================================================ */}
    <section class="join bleed" id="join">
      <div class="join-inner" data-reveal>
        <p class="eyebrow">{t(lang, 'about.contactTagline')}</p>
        <h2 class="join-h2">{t(lang, 'about.contactHeadline')}</h2>
        <p class="join-body">{t(lang, 'about.contactBody')}</p>
        <div class="join-actions">
          <a class="btn-solid" href={`mailto:${t(lang, 'about.contactEmail')}`}>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
            {t(lang, 'about.contactCta')}
          </a>
          <a class="btn-outline" href="https://www.strava.com/clubs/accmunich" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>
            {t(lang, 'about.contactStrava')}
          </a>
        </div>
      </div>
    </section>
  </article>

  {/* ==============================================================
      Chapter overlay — the "interactive view". Prose is rendered
      here in the markup, so it is indexable and reachable without JS.
     ============================================================== */}
  <div class="sheet" data-sheet="chapter" hidden>
    <div class="sheet-backdrop" data-sheet-close></div>
    <div class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="sheet-idiom">
      <button class="sheet-x" type="button" data-sheet-close aria-label={t(lang, 'about.close')}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>

      <div class="sheet-viewport">
        <div class="sheet-track" data-track>
        {CHAPTERS.map((c, i) => (
          <article class="sheet-slide" data-slide={i}>
            <div class:list={['sheet-media', phClass]} data-ph-note={phNote}>
              <img src={c.photo} alt="" />
            </div>
            <div class="sheet-body">
              <img class="sheet-symbol" src={c.symbol} alt="" width="60" height="40" />
              <p class="sheet-en">{c.en}</p>
              <h2 class="sheet-idiom" id={i === 0 ? 'sheet-idiom' : undefined}>{c.idiom}</h2>
              {c.gloss && <p class="sheet-gloss">{c.gloss}</p>}
              <p class="sheet-prose">{c.prose}</p>
            </div>
          </article>
        ))}
        </div>
      </div>

      <div class="sheet-nav">
        <button class="sheet-arrow" type="button" data-sheet-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="sheet-steps" role="tablist" aria-label="Chapters">
          {CHAPTERS.map((c, i) => (
            <button class="sheet-step" type="button" data-step={i} role="tab" aria-label={c.en}>
              <span class="sheet-step-fill"></span>
            </button>
          ))}
        </div>
        <button class="sheet-arrow" type="button" data-sheet-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>
  </div>

  {/* Member card overlay — same sheet chrome, bike detail */}
  <div class="sheet" data-sheet="member" hidden>
    <div class="sheet-backdrop" data-sheet-close></div>
    <div class="sheet-panel sheet-panel--member" role="dialog" aria-modal="true" aria-labelledby="member-name">
      <button class="sheet-x" type="button" data-sheet-close aria-label={t(lang, 'about.close')}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div class="sheet-viewport">
        <article class="sheet-slide sheet-slide--solo">
          <div class="sheet-media sheet-media--bike">
            <img data-member-photo alt="" />
          </div>
          <div class="sheet-body">
            <p class="sheet-en" data-member-role></p>
            <h2 class="sheet-idiom" id="member-name" data-member-name></h2>
            <p class="sheet-prose" data-member-bio></p>
            <p class="sheet-gloss" data-member-meta></p>
          </div>
        </article>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ members: MEMBERS, total: CHAPTERS.length }}>
    // ---------------------------------------------------------------
    // Scroll reveals — content is visible by default and only hidden
    // once JS confirms it can animate, so a failed script never leaves
    // the page blank.
    // ---------------------------------------------------------------
    (function initReveal() {
      const nodes = Array.from(document.querySelectorAll('[data-reveal]'));
      if (!nodes.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      document.documentElement.classList.add('reveal-ready');
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      nodes.forEach((n) => io.observe(n));
    })();

    // ---------------------------------------------------------------
    // Sheets — one open/close/focus implementation for both overlays.
    // ---------------------------------------------------------------
    (function initSheets() {
      const sheets = Array.from(document.querySelectorAll('[data-sheet]'));
      if (!sheets.length) return;
      let lastFocus = null;

      function open(sheet) {
        lastFocus = document.activeElement;
        sheet.hidden = false;
        // Force a reflow so the transition has a start value. rAF would
        // work too, but it never fires in a backgrounded tab — the sheet
        // would then open stuck at opacity 0.
        void sheet.offsetWidth;
        sheet.classList.add('open');
        document.body.style.overflow = 'hidden';
        const x = sheet.querySelector('.sheet-x');
        if (x) x.focus();
      }
      function close(sheet) {
        sheet.classList.remove('open');
        document.body.style.overflow = '';
        window.setTimeout(() => { sheet.hidden = true; }, 240);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }
      function openSheet() { return sheets.find((s) => !s.hidden); }

      sheets.forEach((sheet) => {
        sheet.querySelectorAll('[data-sheet-close]').forEach((el) => {
          el.addEventListener('click', () => close(sheet));
        });
      });
      document.addEventListener('keydown', (e) => {
        const sheet = openSheet();
        if (!sheet) return;
        if (e.key === 'Escape') close(sheet);
      });

      // ---- chapter sheet ----
      const chapter = document.querySelector('[data-sheet="chapter"]');
      if (chapter) {
        const track = chapter.querySelector('[data-track]');
        const slides = Array.from(chapter.querySelectorAll('[data-slide]'));
        const steps = Array.from(chapter.querySelectorAll('[data-step]'));
        const dialog = chapter.querySelector('[role="dialog"]');
        let current = 0;

        function show(i, animate) {
          current = (i + total) % total;
          if (track) {
            track.style.transition = animate === false ? 'none' : '';
            track.style.transform = 'translateX(' + (-current * 100) + '%)';
          }
          slides.forEach((s, n) => {
            const off = n !== current;
            // keep off-screen chapters out of the tab order and the
            // accessibility tree without removing them from the DOM
            s.classList.toggle('is-active', !off);
            if (off) s.setAttribute('inert', ''); else s.removeAttribute('inert');
            s.setAttribute('aria-hidden', off ? 'true' : 'false');
          });
          steps.forEach((b, n) => {
            b.classList.toggle('on', n === current);
            b.setAttribute('aria-selected', n === current ? 'true' : 'false');
          });
          const idiom = slides[current] && slides[current].querySelector('.sheet-idiom');
          if (dialog && idiom) dialog.setAttribute('aria-label', idiom.textContent);
        }

        document.querySelectorAll('[data-open]').forEach((btn) => {
          btn.addEventListener('click', () => {
            // jump to the chapter without animating in from chapter 1
            show(Number(btn.getAttribute('data-open')), false);
            open(chapter);
            // re-enable the slide transition once the sheet is up
            window.setTimeout(() => { if (track) track.style.transition = ''; }, 60);
          });
        });
        steps.forEach((b, n) => b.addEventListener('click', () => show(n)));
        const prev = chapter.querySelector('[data-sheet-prev]');
        const next = chapter.querySelector('[data-sheet-next]');
        if (prev) prev.addEventListener('click', () => show(current - 1));
        if (next) next.addEventListener('click', () => show(current + 1));

        document.addEventListener('keydown', (e) => {
          if (chapter.hidden) return;
          if (e.key === 'ArrowLeft') show(current - 1);
          if (e.key === 'ArrowRight') show(current + 1);
        });

        // Swipe — the story should move under your thumb, not just jump.
        let startX = null;
        let dragging = false;
        const vp = chapter.querySelector('.sheet-viewport');
        if (vp) {
          vp.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse') return;
            startX = e.clientX;
            dragging = true;
            if (track) track.style.transition = 'none';
          });
          vp.addEventListener('pointermove', (e) => {
            if (!dragging || startX === null || !track) return;
            const dx = e.clientX - startX;
            track.style.transform =
              'translateX(calc(' + (-current * 100) + '% + ' + dx + 'px))';
          });
          const end = (e) => {
            if (!dragging || startX === null) return;
            const dx = e.clientX - startX;
            dragging = false;
            startX = null;
            if (track) track.style.transition = '';
            if (Math.abs(dx) > 60) show(current + (dx < 0 ? 1 : -1));
            else show(current);
          };
          vp.addEventListener('pointerup', end);
          vp.addEventListener('pointercancel', end);
        }

        show(0, false);
      }

      // ---- member sheet ----
      const member = document.querySelector('[data-sheet="member"]');
      if (member) {
        const byId = Object.fromEntries(members.map((m) => [m.id, m]));
        const elPhoto = member.querySelector('[data-member-photo]');
        const elRole = member.querySelector('[data-member-role]');
        const elName = member.querySelector('[data-member-name]');
        const elBio = member.querySelector('[data-member-bio]');
        const elMeta = member.querySelector('[data-member-meta]');

        document.querySelectorAll('[data-member]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const m = byId[btn.getAttribute('data-member')];
            if (!m) return;
            elPhoto.src = m.photo;
            elRole.textContent = m.role;
            elName.textContent = m.name;
            elBio.textContent = m.bio;
            elMeta.textContent = m.bike + ' · ' + m.tenure;
            open(member);
          });
        });
      }
    })();
  </script>
</BaseLayout>

<style>
  .about {
    max-width: none;
    padding: 0;
  }

  /* Escape <main>'s centred max-width box for full-width bands.
     Padding mirrors the negative margin so inner content stays put. */
  .bleed {
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-left: calc(50vw - 50%);
    padding-right: calc(50vw - 50%);
  }

  :global(main:has(.about)) {
    padding-top: 0;
    padding-bottom: 0;
  }

  /* .bleed spans 100vw, which counts the scrollbar and so overhangs the
     client box by a few px each side. Clip it on this page only — `clip`
     rather than `hidden` so no new scroll container is created (that
     would break position: sticky elsewhere in the layout). */
  :global(body:has(.about)) {
    overflow-x: clip;
  }

  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin: 0;
  }

  /* Buttons — same anatomy as the site's .btn set */
  .btn-solid,
  .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-btn);
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .btn-solid {
    background: var(--color-accent);
    color: #fff;
    box-shadow: var(--shadow-sm);
  }
  .btn-solid:hover { background: var(--color-accent-dark); transform: translateY(-1px); }
  .btn-outline {
    background: transparent;
    color: var(--color-text-main);
    border: 1.5px solid var(--color-border-strong);
  }
  .btn-outline:hover { border-color: var(--color-text-main); transform: translateY(-1px); }

  /* ---------- Placeholder photography ---------- */
  .is-placeholder { position: relative; }
  .is-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: repeating-linear-gradient(45deg,
      rgba(198, 40, 40, 0.17) 0 14px, rgba(198, 40, 40, 0) 14px 36px);
  }
  .is-placeholder::after {
    content: attr(data-ph-note);
    position: absolute;
    left: 14px;
    top: 14px;
    z-index: 5;
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-accent);
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }

  /* ---------- Hero ---------- */
  .about-hero {
    position: relative;
    height: 78vh;
    min-height: 460px;
    max-height: 720px;
    overflow: hidden;
    background: var(--color-primary);
    display: flex;
    align-items: flex-end;
  }
  .about-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    animation: heroDrift 26s ease-in-out infinite alternate;
  }
  @keyframes heroDrift {
    from { transform: scale(1); }
    to   { transform: scale(1.07); }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-hero-img { animation: none; }
  }
  .about-hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(to right, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.4) 45%, rgba(0,0,0,0) 75%),
      linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.15) 100%);
  }
  .about-hero-inner {
    position: relative;
    z-index: 3;
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    padding: 3rem 2rem 4rem;
    box-sizing: border-box;
  }
  .about-hero-mark {
    width: 128px;
    height: auto;
    display: block;
    margin-bottom: 1.35rem;
    filter: brightness(0) invert(1);
  }
  .about-hero-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 0.5rem;
  }
  .about-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    text-transform: uppercase;
    color: #fff;
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 0.9rem;
  }
  .about-hero-meta {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.04em;
    margin: 0 0 0.9rem;
  }
  .about-hero-lede {
    font-family: var(--font-body);
