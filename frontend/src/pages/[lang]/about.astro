---
export const prerender = true;
// src/pages/[lang]/about.astro
// About page — phase 9 redesign.
//
// Built inside the site's own V4 "Rapha-Inspired Modern" system (see
// styles/variables.css): photography-led, Jost headings, Inter body,
// no ornament. The three ACROSS chapters read as a quiet triptych —
// English title plus the Chinese idiom — and open into a detail
// overlay that carries the full prose. The prose ships in the markup
// (visually hidden, not injected) so crawlers and screen readers get
// the whole page without interacting.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, t, type Locale } from '../../lib/i18n';
import { MEMBERS } from '../../lib/about/members';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const pageTitle = t(lang, 'nav.about');

// Every ride photo on this page is a stand-in. Flip to false once real
// photography lands — it drops the stripe overlay and the corner badge.
const PHOTOS_ARE_PLACEHOLDER = false;

const CHAPTERS = [
  {
    id: 'paths',
    en: 'Across paths',
    symbol: '/images/about/symbols/parallel.svg',
    photo: '/images/about/paths.webp',
    idiom: t(lang, 'about.ch1Idiom'),
    gloss: t(lang, 'about.ch1Gloss'),
    prose: t(lang, 'about.ch1Prose'),
  },
  {
    id: 'mountains',
    en: 'Across mountains',
    symbol: '/images/about/symbols/mountain-rider.svg',
    photo: '/images/about/mountains.webp',
    idiom: t(lang, 'about.ch2Idiom'),
    gloss: t(lang, 'about.ch2Gloss'),
    prose: t(lang, 'about.ch2Prose'),
  },
  {
    id: 'borders',
    en: 'Across borders',
    symbol: '/images/about/symbols/bridge.svg',
    photo: '/images/about/borders.webp',
    idiom: t(lang, 'about.ch3Idiom'),
    gloss: t(lang, 'about.ch3Gloss'),
    prose: t(lang, 'about.ch3Prose'),
  },
] as const;

const phClass = PHOTOS_ARE_PLACEHOLDER ? 'is-placeholder' : '';
const phNote = t(lang, 'about.placeholderNote');
---

<BaseLayout title={pageTitle} lang={lang}>
  {/* Hero rides BaseLayout's named slot so it sits outside <main>'s
      max-width box — the same escape HomeHero uses on the homepage. */}
  <section slot="hero" class:list={['about-hero', phClass]} data-ph-note={phNote}>
    <img class="about-hero-img" src="/images/about/hero.webp" alt="" />
    <div class="about-hero-scrim"></div>

    <div class="about-hero-inner">
      <img class="about-hero-mark" src="/images/about/acc-wordmark.svg" alt="ACC" width="700" height="230" />
      <p class="about-hero-eyebrow">{t(lang, 'about.eyebrow')}</p>
      <h1 class="about-hero-title">Across Cycling Club</h1>
      <p class="about-hero-meta">München · founded 2023</p>
      <p class="about-hero-lede">{t(lang, 'about.heroLede')}</p>
      <a class="btn-solid" href={`/${lang}/membership`}>{t(lang, 'about.heroCta')}</a>
    </div>
  </section>

  <article class="about">
    {/* ============================================================
        2. THE THREE ROADS — quiet by default, prose lives in the
           overlay below
       ============================================================ */}
    <section class="roads" aria-labelledby="roads-heading">
      <div class="roads-ridge roads-ridge--far" aria-hidden="true"></div>
      <div class="roads-ridge roads-ridge--near" aria-hidden="true"></div>

      {/* The club's own name, split. Three unrelated idioms don't read as
          one idea on their own — before this, the only thing tying them
          together was the English on the cards, which is backwards on a
          page written for Chinese readers. Splitting 穿越无疆 does that
          work in Chinese, and it shows rather than explains: the name
          comes apart here and closes back up in the calligraphy at the
          foot of the page. ACROSS sits above it because naming the shared
          word is the one thing the Chinese can't do for itself. */}
      <div class="roads-intro" data-reveal>
        {/* Speed-ghost wordmark. Redrawn as vectors from the logo study —
            same letterform construction as the ACC mark in the hero, so the
            two agree. Inline rather than an <img> so currentColor follows
            the theme; the echoes stay vermilion in both. */}
        <h2 class="roads-word" id="roads-heading">
          <span class="sr-only">Across</span>
          <svg class="roads-mark" viewBox="0 0 1523 230" aria-hidden="true" focusable="false">
          <path d="M 453.0 8.0 Q 453.0 0.0 445.0 0.0 L 383.0 0.0 Q 375.0 0.0 369.2 5.5 L 332.8 40.5 Q 327.0 46.0 327.0 54.0 L 327.0 176.0 Q 327.0 184.0 332.8 189.5 L 369.2 224.5 Q 375.0 230.0 383.0 230.0 L 445.0 230.0 Q 453.0 230.0 453.0 222.0 L 453.0 212.0 Q 453.0 204.0 445.0 204.0 L 395.0 204.0 Q 387.0 204.0 381.2 198.5 L 358.8 177.5 Q 353.0 172.0 353.0 164.0 L 353.0 66.0 Q 353.0 58.0 358.8 52.5 L 381.2 31.5 Q 387.0 26.0 395.0 26.0 L 445.0 26.0 Q 453.0 26.0 453.0 18.0 Z" fill="#C62828" opacity="0.18" fill-rule="evenodd"/>
          <path d="M 495.0 8.0 Q 495.0 0.0 487.0 0.0 L 425.0 0.0 Q 417.0 0.0 411.2 5.5 L 374.8 40.5 Q 369.0 46.0 369.0 54.0 L 369.0 176.0 Q 369.0 184.0 374.8 189.5 L 411.2 224.5 Q 417.0 230.0 425.0 230.0 L 487.0 230.0 Q 495.0 230.0 495.0 222.0 L 495.0 212.0 Q 495.0 204.0 487.0 204.0 L 437.0 204.0 Q 429.0 204.0 423.2 198.5 L 400.8 177.5 Q 395.0 172.0 395.0 164.0 L 395.0 66.0 Q 395.0 58.0 400.8 52.5 L 423.2 31.5 Q 429.0 26.0 437.0 26.0 L 487.0 26.0 Q 495.0 26.0 495.0 18.0 Z" fill="#C62828" opacity="0.34" fill-rule="evenodd"/>
          <path d="M 537.0 8.0 Q 537.0 0.0 529.0 0.0 L 467.0 0.0 Q 459.0 0.0 453.2 5.5 L 416.8 40.5 Q 411.0 46.0 411.0 54.0 L 411.0 176.0 Q 411.0 184.0 416.8 189.5 L 453.2 224.5 Q 459.0 230.0 467.0 230.0 L 529.0 230.0 Q 537.0 230.0 537.0 222.0 L 537.0 212.0 Q 537.0 204.0 529.0 204.0 L 479.0 204.0 Q 471.0 204.0 465.2 198.5 L 442.8 177.5 Q 437.0 172.0 437.0 164.0 L 437.0 66.0 Q 437.0 58.0 442.8 52.5 L 465.2 31.5 Q 471.0 26.0 479.0 26.0 L 529.0 26.0 Q 537.0 26.0 537.0 18.0 Z" fill="#C62828" opacity="0.58" fill-rule="evenodd"/>
          <path d="M 8.0 230.0 Q 0.0 230.0 5.4 224.1 L 201.6 5.9 Q 207.0 0.0 215.0 0.0 L 297.0 0.0 Q 305.0 0.0 305.0 8.0 L 305.0 222.0 Q 305.0 230.0 297.0 230.0 L 158.0 230.0 Q 150.0 230.0 147.3 222.5 L 133.7 185.5 Q 131.0 178.0 128.3 185.5 L 114.7 222.5 Q 112.0 230.0 104.0 230.0 Z M 221.9 68.2 Q 227.0 62.0 227.0 70.0 L 227.0 170.0 Q 227.0 178.0 219.0 178.0 L 139.0 178.0 Q 131.0 178.0 136.1 171.8 Z M 495.2 5.5 Q 501.0 0.0 509.0 0.0 L 645.0 0.0 Q 653.0 0.0 653.0 8.0 L 653.0 46.0 Q 653.0 54.0 645.0 54.0 L 539.0 54.0 Q 531.0 54.0 525.3 59.7 L 514.7 70.3 Q 509.0 76.0 509.0 84.0 L 509.0 146.0 Q 509.0 154.0 514.7 159.7 L 525.3 170.3 Q 531.0 176.0 539.0 176.0 L 645.0 176.0 Q 653.0 176.0 653.0 184.0 L 653.0 222.0 Q 653.0 230.0 645.0 230.0 L 509.0 230.0 Q 501.0 230.0 495.2 224.5 L 458.8 189.5 Q 453.0 184.0 453.0 176.0 L 453.0 54.0 Q 453.0 46.0 458.8 40.5 Z M 675.0 8.0 Q 675.0 0.0 683.0 0.0 L 817.0 0.0 Q 825.0 0.0 830.9 5.4 L 869.1 40.6 Q 875.0 46.0 875.0 54.0 L 875.0 96.0 Q 875.0 104.0 869.2 109.5 L 850.8 126.5 Q 845.0 132.0 847.5 139.6 L 874.5 222.4 Q 877.0 230.0 869.0 230.0 L 825.0 230.0 Q 817.0 230.0 814.7 222.3 L 793.3 149.7 Q 791.0 142.0 783.0 142.0 L 739.0 142.0 Q 731.0 142.0 731.0 150.0 L 731.0 222.0 Q 731.0 230.0 723.0 230.0 L 683.0 230.0 Q 675.0 230.0 675.0 222.0 Z M 731.0 62.0 Q 731.0 54.0 739.0 54.0 L 812.5 54.0 Q 815.0 54.0 816.8 55.8 L 817.2 56.2 Q 819.0 58.0 819.0 60.5 L 819.0 81.5 Q 819.0 84.0 817.2 85.8 L 816.8 86.2 Q 815.0 88.0 812.5 88.0 L 739.0 88.0 Q 731.0 88.0 731.0 80.0 Z M 941.2 5.5 Q 947.0 0.0 955.0 0.0 L 1043.0 0.0 Q 1051.0 0.0 1056.8 5.5 L 1093.2 40.5 Q 1099.0 46.0 1099.0 54.0 L 1099.0 176.0 Q 1099.0 184.0 1093.2 189.5 L 1056.8 224.5 Q 1051.0 230.0 1043.0 230.0 L 955.0 230.0 Q 947.0 230.0 941.2 224.5 L 904.8 189.5 Q 899.0 184.0 899.0 176.0 L 899.0 54.0 Q 899.0 46.0 904.8 40.5 Z M 971.3 59.7 Q 977.0 54.0 985.0 54.0 L 1013.0 54.0 Q 1021.0 54.0 1026.7 59.7 L 1037.3 70.3 Q 1043.0 76.0 1043.0 84.0 L 1043.0 146.0 Q 1043.0 154.0 1037.3 159.7 L 1026.7 170.3 Q 1021.0 176.0 1013.0 176.0 L 985.0 176.0 Q 977.0 176.0 971.3 170.3 L 960.7 159.7 Q 955.0 154.0 955.0 146.0 L 955.0 84.0 Q 955.0 76.0 960.7 70.3 Z M 1159.2 5.5 Q 1165.0 0.0 1173.0 0.0 L 1303.0 0.0 Q 1311.0 0.0 1311.0 8.0 L 1311.0 46.0 Q 1311.0 54.0 1303.0 54.0 L 1199.0 54.0 Q 1191.0 54.0 1185.3 59.7 L 1182.7 62.3 Q 1177.0 68.0 1177.0 76.0 L 1177.0 82.0 Q 1177.0 90.0 1182.7 95.7 L 1185.3 98.3 Q 1191.0 104.0 1199.0 104.0 L 1261.0 104.0 Q 1269.0 104.0 1274.7 109.7 L 1305.3 140.3 Q 1311.0 146.0 1311.0 154.0 L 1311.0 180.0 Q 1311.0 188.0 1305.2 193.5 L 1272.8 224.5 Q 1267.0 230.0 1259.0 230.0 L 1129.0 230.0 Q 1121.0 230.0 1121.0 222.0 L 1121.0 184.0 Q 1121.0 176.0 1129.0 176.0 L 1233.0 176.0 Q 1241.0 176.0 1246.7 170.3 L 1249.3 167.7 Q 1255.0 162.0 1255.0 154.0 L 1255.0 148.0 Q 1255.0 140.0 1249.3 134.3 L 1246.7 131.7 Q 1241.0 126.0 1233.0 126.0 L 1171.0 126.0 Q 1163.0 126.0 1157.3 120.3 L 1126.7 89.7 Q 1121.0 84.0 1121.0 76.0 L 1121.0 50.0 Q 1121.0 42.0 1126.8 36.5 Z M 1371.2 5.5 Q 1377.0 0.0 1385.0 0.0 L 1515.0 0.0 Q 1523.0 0.0 1523.0 8.0 L 1523.0 46.0 Q 1523.0 54.0 1515.0 54.0 L 1411.0 54.0 Q 1403.0 54.0 1397.3 59.7 L 1394.7 62.3 Q 1389.0 68.0 1389.0 76.0 L 1389.0 82.0 Q 1389.0 90.0 1394.7 95.7 L 1397.3 98.3 Q 1403.0 104.0 1411.0 104.0 L 1473.0 104.0 Q 1481.0 104.0 1486.7 109.7 L 1517.3 140.3 Q 1523.0 146.0 1523.0 154.0 L 1523.0 180.0 Q 1523.0 188.0 1517.2 193.5 L 1484.8 224.5 Q 1479.0 230.0 1471.0 230.0 L 1341.0 230.0 Q 1333.0 230.0 1333.0 222.0 L 1333.0 184.0 Q 1333.0 176.0 1341.0 176.0 L 1445.0 176.0 Q 1453.0 176.0 1458.7 170.3 L 1461.3 167.7 Q 1467.0 162.0 1467.0 154.0 L 1467.0 148.0 Q 1467.0 140.0 1461.3 134.3 L 1458.7 131.7 Q 1453.0 126.0 1445.0 126.0 L 1383.0 126.0 Q 1375.0 126.0 1369.3 120.3 L 1338.7 89.7 Q 1333.0 84.0 1333.0 76.0 L 1333.0 50.0 Q 1333.0 42.0 1338.8 36.5 Z" fill="currentColor" fill-rule="evenodd"/>
          </svg>
        </h2>
        <p class="roads-name">
          <span>穿</span><i aria-hidden="true">·</i><span>越</span><i aria-hidden="true">·</i><span>无疆</span>
        </p>
      </div>

      {/* A film strip: the ridge line runs unbroken behind all three and
          both layers drift, so the concepts read as one continuous reel
          rather than three boxes.

          The track holds four passes and travels exactly one pass (-25%)
          before looping, so it lands frame-perfect on the next copy. Four
          is what keeps the strip full at the end of the travel: three
          passes must still cover the viewport, which holds to ~3600px.
          Pass 0 is the real one; the rest are hidden from assistive tech
          and untabbable, but stay clickable. */}
      <div class="reel" data-reel>
        <div class="reel-fade reel-fade--l" aria-hidden="true"></div>
        <div class="reel-fade reel-fade--r" aria-hidden="true"></div>

        <div class="reel-track" data-reel-track>
          {[0, 1, 2, 3].map((pass) =>
            CHAPTERS.map((c, i) => (
              <button
                class="concept"
                type="button"
                data-open={i}
                aria-haspopup="dialog"
                aria-hidden={pass > 0 ? 'true' : undefined}
                tabindex={pass > 0 ? -1 : undefined}
              >
                <img class="concept-symbol" src={c.symbol} alt="" width="60" height="40" />
                <span class="concept-en">{c.en}</span>
                <span class="concept-idiom">{c.idiom}</span>
                {c.gloss && <span class="concept-gloss">{c.gloss}</span>}
                <span class="concept-cue" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13"/><path d="m12 6 6 6-6 6"/></svg>
                </span>
              </button>
            )),
          )}
        </div>
      </div>
    </section>

    {/* ============================================================
        3. CODA
       ============================================================ */}
    <section class="coda bleed" data-reveal>
      <p class="coda-lead">{t(lang, 'about.codaLead')}</p>
      <img class="coda-mark" src="/images/about/chuanyue-wujiang.png" alt="穿越无疆" />
      <p class="coda-sub">Across · Paths · Mountains · Borders</p>
    </section>

    {/* ============================================================
        4. OUR GARAGE
       ============================================================ */}
    <section class="garage">
      <div class="garage-head" data-reveal>
        <p class="eyebrow">{t(lang, 'about.sectionRuleGarage')}</p>
        <h2 class="garage-h2">{t(lang, 'about.garageH2Prefix')}</h2>
        <p class="garage-lede">{t(lang, 'about.garageDesc')}</p>
      </div>

      <div class="garage-window">
        <div class="garage-grid" id="garage-bikes">
          {[false, true].map((copy) => (
            <ul class="garage-lane" aria-hidden={copy ? 'true' : undefined}>
              {MEMBERS.map((m) => (
                <li class="bike-card">
                  <button class="bike-btn" type="button" data-member={m.id}
                    aria-haspopup="dialog" tabindex={copy ? -1 : 0}>
                    <span class="bike-stage">
                      <img class="bike-ring" src="/images/about/logo-stamp-red-transparent.png" alt="" />
                      <img class="bike-photo" src={m.photo} alt="" loading="lazy" draggable="false" />
                    </span>
                    <span class="bike-name">{m.name}</span>
                    <span class="bike-meta">{m.bike} · {m.joined}</span>
                  </button>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>

    </section>

    {/* ============================================================
        5. CONTACT
       ============================================================ */}
    <section class="join bleed" id="join">
      <div class="join-inner" data-reveal>
        <p class="eyebrow">{t(lang, 'about.sectionRuleJoin')}</p>
        <h2 class="join-h2">Ride Across</h2>
        <p class="join-line">{t(lang, 'about.contactHeadline')}</p>
        <p class="join-body">{t(lang, 'about.contactBody')}</p>
        <div class="join-actions">
          <a class="btn-solid" href={`mailto:${t(lang, 'about.contactEmail')}`}>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
            {t(lang, 'about.contactCta')}
          </a>
          <a class="btn-outline" href="https://www.strava.com/clubs/accmunich" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>
            {t(lang, 'about.contactStrava')}
          </a>
        </div>
      </div>
    </section>
  </article>

  {/* SVG filter for organic Chinese ink wash / colored pencil sketch texture */}
  <svg style="position:absolute;width:0;height:0;pointer-events:none;" aria-hidden="true">
    <defs>
      <filter id="acc-ink-wash" x="-25%" y="-25%" width="150%" height="150%">
        <feTurbulence type="fractalNoise" baseFrequency="0.075" numOctaves="3" result="grain" />
        <feDisplacementMap in="SourceGraphic" in2="grain" scale="2.2" xChannelSelector="R" yChannelSelector="G" result="inkEdge" />
        <feComposite in="inkEdge" in2="SourceGraphic" operator="over" />
      </filter>
    </defs>
  </svg>

  {/* ==============================================================
      Chapter overlay — the "interactive view". Prose is rendered
      here in the markup, so it is indexable and reachable without JS.
     ============================================================== */}
  <div class="sheet" data-sheet="chapter" hidden>
    <div class="sheet-backdrop" data-sheet-close></div>
    <div class="sheet-birds" aria-hidden="true"></div>
    <div class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="sheet-idiom">
      <button class="sheet-x" type="button" data-sheet-close aria-label={t(lang, 'about.close')}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>

      {/* A fanned deck: the open chapter takes the room, the rest stay as
          overlapping spines you can read edge-on and click straight to.
          Every chapter's prose is in the markup whatever is open, so the
          page stays complete without JS and for crawlers. */}
      <div class="deck" data-deck>
        {CHAPTERS.map((c, i) => (
          <article class:list={['card', { 'is-open': i === 0 }]} data-card={i} style={`--i:${i}`}>
            <button
              class="card-spine"
              type="button"
              data-card-open={i}
              aria-expanded={i === 0 ? 'true' : 'false'}
            >
              <img class="card-mark" src={c.symbol} alt="" aria-hidden="true" width="60" height="40" />
              <span class="card-edge">{c.idiom}</span>
            </button>

            <div class="card-body">
              <div class="card-text">
                <p class="card-en">{c.en}</p>
                <h3 class="card-idiom" id={i === 0 ? 'sheet-idiom' : undefined}>{c.idiom}</h3>
                {c.gloss && <p class="card-gloss">{c.gloss}</p>}
                <p class="card-prose">{c.prose}</p>
              </div>
              <div class:list={['card-media', phClass]} data-ph-note={phNote}>
                <img src={c.photo} alt="" decoding="async" />
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  {/* Member card overlay — same sheet chrome, bike detail */}
  <div class="sheet" data-sheet="member" hidden>
    <div class="sheet-backdrop" data-sheet-close></div>
    <div class="sheet-panel sheet-panel--member" role="dialog" aria-modal="true" aria-labelledby="member-name">
      <button class="sheet-x" type="button" data-sheet-close aria-label={t(lang, 'about.close')}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div class="deck deck--solo" tabindex="0"
        role="region" aria-labelledby="member-name">
        <article class="card is-open">
          <div class="card-body">
            <div class="card-media card-media--bike">
              <img data-member-photo alt="" />
            </div>
            <div class="card-text">
              <p class="card-en" data-member-role></p>
              <h2 class="card-idiom" id="member-name" data-member-name></h2>
              <p class="card-prose" data-member-bio></p>
              <p class="card-gloss" data-member-meta></p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ members: MEMBERS, total: CHAPTERS.length }}>
    // ---------------------------------------------------------------
    // Scroll reveals — content is visible by default and only hidden
    // once JS confirms it can animate, so a failed script never leaves
    // the page blank.
    // ---------------------------------------------------------------
    (function initReveal() {
      const nodes = Array.from(document.querySelectorAll('[data-reveal]'));
      if (!nodes.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      document.documentElement.classList.add('reveal-ready');
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      nodes.forEach((n) => io.observe(n));
    })();

    // ---------------------------------------------------------------
    // Sheets — one open/close/focus implementation for both overlays.
    // ---------------------------------------------------------------
    (function initSheets() {
      const sheets = Array.from(document.querySelectorAll('[data-sheet]'));
      if (!sheets.length) return;
      let lastFocus = null;

      // Chinese ink wash & colored pencil sketch bird vectors (写意水墨/彩铅素描风)
      const BIRD_SVGS = [
        // 1. Soaring Falcon / Raptor (水墨大鹏滑翔 — 浓淡写意羽羽生辉)
        '<svg viewBox="0 0 54 36" fill="none" aria-hidden="true" style="display:block;width:100%;height:100%;overflow:visible;filter:url(#acc-ink-wash);">' +
          '<path d="M27 15 C19 8, 10 7, 2 13 C9 15, 17 18, 23 20" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />' +
          '<path d="M27 15 C35 8, 44 7, 52 13 C45 15, 37 18, 31 20" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />' +
