---
export const prerender = true;
// src/pages/[lang]/about.astro
// Editorial about page — hero, Across poem, stamp-wall garage marquee,
// featured-rider accordion, contact. Based on Phase 8 Claude Design output.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, t, type Locale } from '../../lib/i18n';
import { MEMBERS, formatJoined } from '../../lib/about/members';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const pageTitle = t(lang, 'nav.about');

// Split into two rows, preserving original order (i % 2).
const row1 = MEMBERS.filter((_, i) => i % 2 === 0);
const row2 = MEMBERS.filter((_, i) => i % 2 === 1);

// Featured bios for accordion — first four members.
const featured = MEMBERS.slice(0, 4);
---

<BaseLayout title={pageTitle} lang={lang}>
  <article class="about-page">
    {/* ============================================================
        1. TITLE BLOCK
       ============================================================ */}
    <div class="about-title-block">
      <div class="about-eyebrow">{t(lang, 'about.eyebrow')}</div>
      <h1 class="about-h1">{t(lang, 'about.h1')}</h1>
      <div class="about-subtitle">{t(lang, 'about.subtitle')}</div>
    </div>

    {/* ============================================================
        2. INTRO LEDE
       ============================================================ */}
    <div class="about-intro">
      <p>{t(lang, 'about.intro1')}</p>
      <p>
        {t(lang, 'about.intro2Prefix')}
        <em> {t(lang, 'about.intro2Em')}</em>
      </p>
    </div>

    <span class="intro-to-poem-divider" aria-hidden="true"></span>

    {/* ============================================================
        3. ACROSS — three-beat poem
       ============================================================ */}
    <section class="across-poem" aria-label="The meaning of across" data-poem>
      <div class="across-stanzas">
        <div class="across-stanza" data-order="1">
          <div class="across-glyph-bg">
            <svg viewBox="0 0 600 180" aria-hidden="true" preserveAspectRatio="none">
              <polyline points="10,160 100,70 190,120 300,20 400,96 500,50 590,150"/>
            </svg>
          </div>
          <div class="across-text">
            <div class="across-word"><span class="across-key">Across</span> {t(lang, 'about.poemWord1')}</div>
            <div class="across-gloss">{t(lang, 'about.poemGloss1')}</div>
          </div>
        </div>
        <div class="across-stanza" data-order="2">
          <div class="across-glyph-bg">
            <svg viewBox="0 0 600 180" aria-hidden="true" preserveAspectRatio="none">
              <path d="M20,30 C180,40 260,150 580,160"/>
              <path d="M20,160 C180,150 260,40 580,30"/>
            </svg>
          </div>
          <div class="across-text">
            <div class="across-word"><span class="across-key">Across</span> {t(lang, 'about.poemWord2')}</div>
            <div class="across-gloss">{t(lang, 'about.poemGloss2')}</div>
          </div>
        </div>
        <div class="across-stanza" data-order="3">
          <div class="across-glyph-bg">
            <svg viewBox="0 0 600 180" aria-hidden="true" preserveAspectRatio="none">
              <path d="M 230,90 m -100,0 a 100,70 0 1,0 200,0 a 100,70 0 1,0 -200,0"/>
              <path d="M 370,90 m -100,0 a 100,70 0 1,0 200,0 a 100,70 0 1,0 -200,0"/>
              <path class="dashed" d="M 295,90 L 305,90"/>
            </svg>
          </div>
          <div class="across-text">
            <div class="across-word"><span class="across-key">Across</span> {t(lang, 'about.poemWord3')}</div>
            <div class="across-gloss">{t(lang, 'about.poemGloss3')}</div>
          </div>
        </div>
      </div>

      <div class="across-signature" data-signature>
        <span class="across-signature-rule"></span>
        <div class="across-signature-text">
          <b>Across</b> {t(lang, 'about.signatureClub')}
        </div>
      </div>
    </section>

    {/* ============================================================
        4. OUR GARAGE — stamp-wall marquee
       ============================================================ */}
    <div class="section-rule">{t(lang, 'about.sectionRuleGarage')}</div>

    <section class="garage-section">
      <h2 class="garage-h2">
        {t(lang, 'about.garageH2Prefix')} <em>{t(lang, 'about.garageH2Em')}</em>
      </h2>

      <div class="garage-stamp-wall" data-stamp-wall>
        <div class="stamp-wall-label">{t(lang, 'about.stableEyebrow')}</div>
        <div class="stamp-rows">
          {[row1, row2].map((row) => (
            <div class="stamp-row-clip">
              <div class="stamp-track" data-track>
                {[1, 2, 3].map((lap) => (
                  <div class="stamp-lap" data-lap={lap}>
                    {row.map((m) => (
                      <button class="stamp-tile" type="button" data-member-id={m.id}>
                        <img
                          class="stamp-ring stamp-ring-light"
                          src="/images/about/logo-stamp-red-transparent.png"
                          alt=""
                          draggable="false"
                          loading="lazy"
                        />
                        <img
                          class="stamp-ring stamp-ring-dark"
                          src="/images/about/logo-stamp-white-transparent.png"
                          alt=""
                          draggable="false"
                          loading="lazy"
                        />
                        <div class="stamp-bike-wrap">
                          <img class="stamp-bike" src={m.photo} alt="" draggable="false" loading="lazy"/>
                        </div>
                        <div class="stamp-caption">
                          {m.name}
                          <div class="stamp-subcaption">{m.bike} · {m.joined}</div>
                        </div>
                      </button>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="stamp-edge stamp-edge-left" aria-hidden="true"></div>
        <div class="stamp-edge stamp-edge-right" aria-hidden="true"></div>
      </div>
    </section>

    {/* ============================================================
        5. FEATURED RIDERS — accordion
       ============================================================ */}
    <section class="roster-section">
      <div class="roster-head">
        <div class="roster-eyebrow">{t(lang, 'about.rosterEyebrow')}</div>
        <h2 class="roster-title">
          {t(lang, 'about.rosterTitlePrefix')} <em>{t(lang, 'about.rosterTitleEm')}</em>
        </h2>
      </div>
      <div class="roster-accordion" data-accordion>
        {featured.map((m, i) => (
          <div class={`roster-item${i === 0 ? ' open' : ''}`} data-roster-item>
            <button class="roster-item-head" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
              <div class="roster-item-photo">
                <img src={m.photo} alt="" draggable="false" loading="lazy"/>
              </div>
              <div class="roster-item-summary">
                <div class="roster-item-name">
                  {m.name}
                  {m.captain && <span class="captain-badge">{t(lang, 'about.captainBadge')}</span>}
                </div>
                <div class="roster-item-meta">
                  {m.role} · <b>{m.bike}</b> · {formatJoined(lang, m.joined)}
                </div>
              </div>
              <div class="roster-item-chevron" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </div>
            </button>
            <div class="roster-item-body">
              <div class="roster-item-body-inner">
                <div class="roster-item-tenure">{m.tenure.toUpperCase()}</div>
                <p class="roster-item-bio">{m.bio}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* ============================================================
        6. CONTACT
       ============================================================ */}
    <div class="section-rule">{t(lang, 'about.sectionRuleJoin')}</div>

    <section class="contact-section">
      <div class="contact-eyebrow">{t(lang, 'about.contactEyebrow')}</div>
      <h2 class="contact-h2">{t(lang, 'about.contactH2')}</h2>
      <p class="contact-lede">{t(lang, 'about.contactLede')}</p>
      <div class="contact-channels">
        <a class="channel-btn primary" href={`mailto:${t(lang, 'about.contactEmail')}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/>
          </svg>
          {t(lang, 'about.contactEmail')}
        </a>
        <a class="channel-btn ghost" href="https://www.strava.com/clubs/accmunich" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
          </svg>
          {t(lang, 'about.contactStrava')}
        </a>
      </div>
    </section>
  </article>

  {/* Member card overlay — shown when user clicks a stamp */}
  <div class="member-card-backdrop" data-member-card hidden>
    <div class="member-card" role="dialog" aria-modal="true" aria-labelledby="member-card-name">
      <div class="member-card-photo">
        <img data-member-card-photo alt=""/>
      </div>
      <div class="member-card-body">
        <div class="member-card-role" data-member-card-role></div>
        <div class="member-card-name" id="member-card-name" data-member-card-name></div>
        <p class="member-card-bio" data-member-card-bio></p>
        <div class="member-card-meta" data-member-card-meta></div>
      </div>
      <button class="member-card-close" type="button" aria-label="Close" data-member-card-close>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ members: MEMBERS }}>
  // ------------------------------------------------------------------
  // Across poem — sequential reveal via IntersectionObserver + timers
  // ------------------------------------------------------------------
  (function initPoem() {
    const poem = document.querySelector('[data-poem]');
    if (!poem) return;
    const stanzas = poem.querySelectorAll('.across-stanza');
    const signature = poem.querySelector('[data-signature]');
    let started = false;

    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || started) continue;
        started = true;
        io.disconnect();
        stanzas.forEach((s, i) => {
          setTimeout(() => s.classList.add('in'), i * 1400);
        });
        if (signature) {
          setTimeout(() => signature.classList.add('in'), stanzas.length * 1400);
        }
      }
    }, { threshold: 0.25, rootMargin: '0px 0px -10% 0px' });
    io.observe(poem);
  })();

  // ------------------------------------------------------------------
  // Stamp-wall marquee — rAF-driven infinite translate, wheel nudge,
  // pause on hover, ResizeObserver-backed lap measurement.
  // ------------------------------------------------------------------
  (function initStampWall() {
    const wall = document.querySelector('[data-stamp-wall]');
    if (!wall) return;
    const tracks = wall.querySelectorAll('[data-track]');
    if (!tracks.length) return;

    const state = {
      offset: 0,
      lapW: 0,
      interacting: 0,
      speed: 22,
    };

    function measure() {
      const firstLap = tracks[0].querySelector('[data-lap="1"]');
      if (firstLap) {
        const w = firstLap.getBoundingClientRect().width;
        if (w > 0) state.lapW = w;
      }
    }
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(tracks[0]);

    let last = performance.now();
    function tick(now) {
      const dt = Math.min(64, now - last);
      last = now;
      if (!state.lapW) {
        measure();
      } else {
        if (state.interacting <= 0) {
          state.offset -= state.speed * (dt / 1000);
        }
        if (state.offset <= -state.lapW) state.offset += state.lapW;
        if (state.offset > 0) state.offset -= state.lapW;
        const transform = `translate3d(${state.offset}px, 0, 0)`;
        tracks.forEach((t) => { t.style.transform = transform; });
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    let resumeTimer = null;
    function onWheel(e) {
      const dx = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      if (!dx) return;
      e.preventDefault();
      state.offset -= dx;
      state.interacting = 1;
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => { state.interacting = 0; }, 1200);
    }
    wall.addEventListener('wheel', onWheel, { passive: false });
    wall.addEventListener('mouseenter', () => { state.interacting = Math.max(state.interacting, 1); });
    wall.addEventListener('mouseleave', () => { state.interacting = 0; });
  })();

  // ------------------------------------------------------------------
  // Stamp tile click → wobble + member card overlay
  // ------------------------------------------------------------------
  (function initStampClicks() {
    const backdrop = document.querySelector('[data-member-card]');
    if (!backdrop) return;
    const closeBtn = backdrop.querySelector('[data-member-card-close]');
    const elPhoto = backdrop.querySelector('[data-member-card-photo]');
    const elRole = backdrop.querySelector('[data-member-card-role]');
    const elName = backdrop.querySelector('[data-member-card-name]');
    const elBio = backdrop.querySelector('[data-member-card-bio]');
    const elMeta = backdrop.querySelector('[data-member-card-meta]');

    const byId = Object.fromEntries(members.map((m) => [m.id, m]));

    function open(id) {
      const m = byId[id];
      if (!m) return;
      elPhoto.src = m.photo;
      elRole.textContent = `${m.role} · ${m.tenure}`;
      elName.textContent = m.name;
      elBio.textContent = m.bio;
      elMeta.textContent = `${m.bike} · ${m.joined}`;
      backdrop.hidden = false;
      requestAnimationFrame(() => backdrop.classList.add('open'));
    }
    function close() {
      backdrop.classList.remove('open');
      setTimeout(() => { backdrop.hidden = true; }, 220);
    }

    document.querySelectorAll('.stamp-tile').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-member-id');
        btn.classList.remove('wobble');
        void btn.offsetWidth;
        btn.classList.add('wobble');
        setTimeout(() => open(id), 420);
      });
    });
    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', (e) => { if (e.target === backdrop) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !backdrop.hidden) close();
    });
  })();

  // ------------------------------------------------------------------
  // Roster accordion — click to toggle a single open item
  // ------------------------------------------------------------------
  (function initAccordion() {
    const items = document.querySelectorAll('[data-roster-item]');
    items.forEach((item) => {
      const head = item.querySelector('.roster-item-head');
      if (!head) return;
      head.addEventListener('click', () => {
        const isOpen = item.classList.toggle('open');
        head.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  })();
</script>

<style>
  .about-page {
    max-width: none;
    padding: 64px 24px 0;
  }

  /* ---------- Title ---------- */
  .about-title-block {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .about-eyebrow {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 14px;
  }
  .about-h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(40px, 5.5vw, 64px);
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--color-text-main);
    margin: 0;
  }
  .about-h1::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-accent);
    margin: 18px auto 0;
  }
  .about-subtitle {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: 17px;
    color: var(--color-text-secondary);
    margin-top: 14px;
    letter-spacing: 0.01em;
  }

  /* ---------- Intro ---------- */
  .about-intro {
    max-width: 860px;
    margin: 48px auto 0;
    text-align: center;
    padding: 0 24px;
  }
  .about-intro p {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 1.7;
    font-weight: 400;
    color: var(--color-text-main);
    margin: 0;
    letter-spacing: -0.005em;
  }
  .about-intro p + p {
    margin-top: 18px;
    font-size: 17.5px;
    color: var(--color-text-secondary);
  }
  .about-intro em {
    font-style: italic;
    color: var(--color-text-main);
  }

  .intro-to-poem-divider {
    display: block;
    width: 1px;
    height: 48px;
    background: var(--color-text-secondary);
    margin: 72px auto 0;
    opacity: 0.55;
  }

  /* ---------- Section rule ---------- */
  .section-rule {
    max-width: 700px;
    margin: 96px auto 0;
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-heading);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-text-secondary);
  }
  .section-rule::before,
  .section-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border-strong);
  }

  /* ---------- Across poem ---------- */
  .across-poem {
    max-width: 900px;
    margin: 56px auto 0;
    padding: 0 24px;
  }
  .across-stanzas {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .across-stanza {
    position: relative;
    min-height: 18vh;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 800ms ease, transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .across-stanza.in {
    opacity: 1;
    transform: translateY(0);
  }

  .across-glyph-bg {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: clamp(200px, 38%, 340px);
    height: 52%;
    z-index: 0;
    color: var(--color-accent);
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms ease 180ms;
  }
  .across-stanza.in .across-glyph-bg { opacity: 0.22; }
  :global(:root.dark) .across-stanza.in .across-glyph-bg { opacity: 0.32; }
  .across-glyph-bg svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .across-glyph-bg :global(path),
  .across-glyph-bg :global(line),
  .across-glyph-bg :global(polyline) {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    transition: stroke-dashoffset 1400ms cubic-bezier(0.55, 0, 0.25, 1) 260ms;
  }
  .across-stanza.in .across-glyph-bg :global(path),
  .across-stanza.in .across-glyph-bg :global(line),
  .across-stanza.in .across-glyph-bg :global(polyline) {
    stroke-dashoffset: 0;
  }
  .across-glyph-bg :global(.dashed) {
    stroke-dasharray: 6 8;
    stroke-dashoffset: 0;
    opacity: 0;
    transition: opacity 600ms ease 900ms;
  }
  .across-stanza.in .across-glyph-bg :global(.dashed) { opacity: 0.9; }

  .across-text {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .across-word {
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
    font-size: clamp(34px, 4.8vw, 54px);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-text-main);
  }
  .across-word .across-key {
    color: var(--color-accent);
    font-style: italic;
  }
  .across-gloss {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    font-style: italic;
    margin: 12px auto 0;
    max-width: 520px;
  }

  .across-signature {
    margin-top: 72px;
    text-align: center;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 900ms ease 200ms, transform 900ms ease 200ms;
  }
  .across-signature.in {
    opacity: 1;
    transform: translateY(0);
  }
  .across-signature-rule {
    display: block;
    width: 36px;
    height: 1px;
    background: var(--color-border-strong);
    margin: 0 auto 18px;
  }
  .across-signature-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }
  .across-signature-text b {
    font-weight: 700;
    font-style: italic;
    color: var(--color-text-main);
  }

  @media (max-width: 640px) {
    .across-stanza { min-height: 22vh; }
    .across-gloss { font-size: 14.5px; }
  }

  /* ---------- Garage ---------- */
  .garage-section {
    max-width: 1200px;
    margin: 28px auto 0;
    padding: 0 24px;
    text-align: center;
  }
  .garage-h2 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(30px, 3.8vw, 44px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-text-main);
    max-width: 720px;
    margin: 0 auto;
  }
  .garage-h2 em {
    font-style: italic;
    color: var(--color-accent);
    font-weight: 500;
  }

  .garage-stamp-wall {
    position: relative;
    margin-top: 44px;
    border-top: 1px solid var(--color-border-strong);
    border-bottom: 1px solid var(--color-border-strong);
    overflow: hidden;
    background: var(--color-bg-canvas);
  }
  :global(:root.dark) .garage-stamp-wall {
    background: #0d0d0d;
  }
  .garage-stamp-wall::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 140%, rgba(198, 40, 40, 0.07), transparent 60%);
    pointer-events: none;
  }
  :global(:root.dark) .garage-stamp-wall::before {
    background: radial-gradient(ellipse at 50% 140%, rgba(198, 40, 40, 0.14), transparent 60%);
  }

  .stamp-wall-label {
    position: absolute;
    top: 22px;
    left: 0;
    right: 0;
