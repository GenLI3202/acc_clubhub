---
export const prerender = true;
// src/pages/[lang]/about.astro
// Editorial about page — hero, Across poem, stamp-wall garage marquee, contact.
// Based on Phase 8 Claude Design output.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, t, type Locale } from '../../lib/i18n';
import { MEMBERS } from '../../lib/about/members';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const pageTitle = t(lang, 'nav.about');

// Split into two rows, preserving original order (i % 2).
const row1 = MEMBERS.filter((_, i) => i % 2 === 0);
const row2 = MEMBERS.filter((_, i) => i % 2 === 1);
---

<BaseLayout title={pageTitle} lang={lang}>
  <article class="about-page">
    {/* ============================================================
        1. TITLE BLOCK
       ============================================================ */}
    <div class="about-title-block">
      <div class="about-eyebrow">{t(lang, 'about.eyebrow')}</div>
      <h1 class="about-h1">{t(lang, 'about.h1')}</h1>
      <div class="about-subtitle">{t(lang, 'about.subtitle')}</div>
    </div>

    {/* ============================================================
        2. INTRO LEDE
       ============================================================ */}
    <div class="about-intro">
      <p>{t(lang, 'about.intro1')}</p>
      <p>
        {t(lang, 'about.intro2Prefix')}
        <em> {t(lang, 'about.intro2Em')}</em>
      </p>
    </div>

    <span class="intro-to-poem-divider" aria-hidden="true"></span>

    {/* ============================================================
        3. ACROSS — three-beat poem
       ============================================================ */}
    <section class="across-poem" aria-label="The meaning of across" data-poem>
      <div class="across-stanzas">
        <div class="across-stanza" data-order="1">
          <div class="across-glyph-bg">
            <svg viewBox="0 0 600 180" aria-hidden="true" preserveAspectRatio="none">
              <polyline points="10,160 100,70 190,120 300,20 400,96 500,50 590,150"/>
            </svg>
          </div>
          <div class="across-text">
            <div class="across-word"><span class="across-key">Across</span> {t(lang, 'about.poemWord1')}</div>
            <div class="across-gloss">{t(lang, 'about.poemGloss1')}</div>
          </div>
        </div>
        <div class="across-stanza" data-order="2">
          <div class="across-glyph-bg">
            <svg viewBox="0 0 600 180" aria-hidden="true" preserveAspectRatio="none">
              <path d="M20,30 C180,40 260,150 580,160"/>
              <path d="M20,160 C180,150 260,40 580,30"/>
            </svg>
          </div>
          <div class="across-text">
            <div class="across-word"><span class="across-key">Across</span> {t(lang, 'about.poemWord2')}</div>
            <div class="across-gloss">{t(lang, 'about.poemGloss2')}</div>
          </div>
        </div>
        <div class="across-stanza" data-order="3">
          <div class="across-glyph-bg">
            <svg viewBox="0 0 600 180" aria-hidden="true" preserveAspectRatio="none">
              <path d="M 230,90 m -100,0 a 100,70 0 1,0 200,0 a 100,70 0 1,0 -200,0"/>
              <path d="M 370,90 m -100,0 a 100,70 0 1,0 200,0 a 100,70 0 1,0 -200,0"/>
              <path class="dashed" d="M 295,90 L 305,90"/>
            </svg>
          </div>
          <div class="across-text">
            <div class="across-word"><span class="across-key">Across</span> {t(lang, 'about.poemWord3')}</div>
            <div class="across-gloss">{t(lang, 'about.poemGloss3')}</div>
          </div>
        </div>
      </div>

      <div class="across-signature" data-signature>
        <span class="across-signature-rule"></span>
        <div class="across-signature-text">
          <b>Across</b> {t(lang, 'about.signatureClub')}
        </div>
      </div>
    </section>

    {/* ============================================================
        4. OUR GARAGE — stamp-wall marquee
       ============================================================ */}
    <div class="section-rule">{t(lang, 'about.sectionRuleGarage')}</div>

    <section class="garage-section">
      <h2 class="garage-h2">{t(lang, 'about.garageH2Prefix')}</h2>
      <p class="garage-lede">{t(lang, 'about.garageLede')}</p>
      <p class="garage-desc">{t(lang, 'about.garageDesc')}</p>

      <div class="garage-stamp-wall" data-stamp-wall>
        <div class="stamp-rows">
          {[row1, row2].map((row) => {
            // Single continuous strip: 6 originals + 3 cloned head tiles so a
            // 2-tile step can scroll through all 6 and wrap seamlessly back to
            // the start after the clone slot.
            const tiles = [...row, ...row.slice(0, 3)];
            return (
              <div class="stamp-row-clip">
                <div class="stamp-track" data-track>
                  {tiles.map((m, idx) => (
                    <button
                      class="stamp-tile"
                      type="button"
                      data-member-id={m.id}
                      aria-hidden={idx >= 6 ? 'true' : undefined}
                      tabindex={idx >= 6 ? -1 : undefined}
                    >
                      <img
                        class="stamp-ring stamp-ring-light"
                        src="/images/about/logo-stamp-red-transparent.png"
                        alt=""
                        draggable="false"
                        loading="lazy"
                      />
                      <img
                        class="stamp-ring stamp-ring-dark"
                        src="/images/about/logo-stamp-white-transparent.png"
                        alt=""
                        draggable="false"
                        loading="lazy"
                      />
                      <div class="stamp-bike-wrap">
                        <img class="stamp-bike" src={m.photo} alt="" draggable="false" loading="lazy"/>
                      </div>
                      <div class="stamp-caption">
                        {m.name}
                        <div class="stamp-subcaption">{m.bike} · {m.joined}</div>
                      </div>
                    </button>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
        <button class="stamp-arrow stamp-arrow--prev" type="button" data-stamp-prev aria-label="Previous page">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="stamp-arrow stamp-arrow--next" type="button" data-stamp-next aria-label="Next page">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>

        <div class="stamp-dots" data-stamp-dots>
          <button class="stamp-dot active" type="button" data-stamp-dot="0" aria-label="Page 1"></button>
          <button class="stamp-dot" type="button" data-stamp-dot="1" aria-label="Page 2"></button>
          <button class="stamp-dot" type="button" data-stamp-dot="2" aria-label="Page 3"></button>
        </div>
      </div>
    </section>

    {/* ============================================================
        5. CONTACT
       ============================================================ */}
    <div class="section-rule">{t(lang, 'about.sectionRuleJoin')}</div>

    <section class="contact-section">
      <div class="contact-eyebrow">{t(lang, 'about.contactEyebrow')}</div>
      <h2 class="contact-h2">{t(lang, 'about.contactH2')}</h2>
      <p class="contact-lede">{t(lang, 'about.contactLede')}</p>
      <div class="contact-channels">
        <a class="channel-btn primary" href={`mailto:${t(lang, 'about.contactEmail')}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/>
          </svg>
          {t(lang, 'about.contactEmail')}
        </a>
        <a class="channel-btn ghost" href="https://www.strava.com/clubs/accmunich" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
          </svg>
          {t(lang, 'about.contactStrava')}
        </a>
      </div>
    </section>
  </article>

  {/* Member card overlay — shown when user clicks a stamp */}
  <div class="member-card-backdrop" data-member-card aria-hidden="true">
    <div class="member-card" role="dialog" aria-modal="true" aria-labelledby="member-card-name">
      {/* Top 2/3 — large bike photo */}
      <div class="member-card-bike">
        <img data-member-card-photo alt=""/>
      </div>
      {/* Bottom 1/3 — avatar (1/4) + text (3/4) */}
      <div class="member-card-footer">
        <div class="member-card-avatar">
          <div class="member-card-initials" data-member-card-avatar></div>
        </div>
        <div class="member-card-body">
          <div class="member-card-role" data-member-card-role></div>
          <div class="member-card-name" id="member-card-name" data-member-card-name></div>
          <p class="member-card-bio" data-member-card-bio></p>
          <div class="member-card-meta" data-member-card-meta></div>
        </div>
      </div>
      <button class="member-card-close" type="button" aria-label="Close" data-member-card-close>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>
  </div>

  <script is:inline define:vars={{ members: MEMBERS }}>
  // ------------------------------------------------------------------
  // Across poem — sequential reveal via IntersectionObserver + timers
  // ------------------------------------------------------------------
  (function initPoem() {
    const poem = document.querySelector('[data-poem]');
    if (!poem) return;
    const stanzas = poem.querySelectorAll('.across-stanza');
    const signature = poem.querySelector('[data-signature]');
    let started = false;

    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || started) continue;
        started = true;
        io.disconnect();
        stanzas.forEach((s, i) => {
          setTimeout(() => s.classList.add('in'), i * 1400);
        });
        if (signature) {
          setTimeout(() => signature.classList.add('in'), stanzas.length * 1400);
        }
      }
    }, { threshold: 0.25, rootMargin: '0px 0px -10% 0px' });
    io.observe(poem);
  })();

  // ------------------------------------------------------------------
  // Stamp wall — single continuous strip, 3 tiles visible, 2-tile step.
  // Each row renders 6 originals + 3 cloned head tiles so we can step
  // through 3 logical positions (0, 2, 4 tiles) and wrap seamlessly:
  // advancing past step 2 slides onto the clone head, then we snap back
  // to step 0 without transition. Tile pitch is measured from the DOM so
  // the same math works across responsive widths.
  // ------------------------------------------------------------------
  (function initStampWall() {
    const wall = document.querySelector('[data-stamp-wall]');
    if (!wall) return;
    const tracks = Array.from(wall.querySelectorAll('[data-track]'));
    if (!tracks.length) return;
    const dots = Array.from(wall.querySelectorAll('[data-stamp-dot]'));

    const TOTAL_STEPS = 3;          // 3 logical stops → 3 dots
    const TILES_PER_STEP = 2;       // shift 2 tiles per row per step (4 bikes total)
    const SLIDE_MS = 700;
    const DWELL_MS = 4500;

    let current = 0;                // 0..TOTAL_STEPS (TOTAL_STEPS = wrap slot)
    let unit = 0;                   // px: tile-width + gap
    let timerId = null;
    let paused = false;
    let animating = false;

    function measureUnit() {
      const sample = tracks[0].querySelectorAll('.stamp-tile');
      if (sample.length < 2) return;
      const r0 = sample[0].getBoundingClientRect();
      const r1 = sample[1].getBoundingClientRect();
      const u = r1.left - r0.left;
      if (u > 0) unit = u;
    }

    function applyTransform(stepIdx, animated) {
      const x = -stepIdx * TILES_PER_STEP * unit;
      tracks.forEach((track) => {
        track.style.transition = animated
          ? 'transform ' + SLIDE_MS + 'ms cubic-bezier(0.2, 0.8, 0.2, 1)'
          : 'none';
        track.style.transform = 'translate3d(' + x + 'px, 0, 0)';
      });
    }

    function setActiveDot(visibleIdx) {
      dots.forEach((dot, i) => dot.classList.toggle('active', i === visibleIdx));
    }

    function advance() {
      if (animating || unit === 0) return;
      animating = true;
      const target = current + 1;
      applyTransform(target, true);
      setActiveDot(target % TOTAL_STEPS);
      current = target;

      window.setTimeout(() => {
        if (current >= TOTAL_STEPS) {
          applyTransform(0, false);
          void tracks[0].offsetWidth;
          current = 0;
        }
        animating = false;
      }, SLIDE_MS + 30);
    }

    function jumpTo(stepIdx) {
      if (animating || unit === 0) return;
      const visible = current % TOTAL_STEPS;
      if (stepIdx === visible) return;
      animating = true;
      applyTransform(stepIdx, true);
      setActiveDot(stepIdx);
      current = stepIdx;
      window.setTimeout(() => { animating = false; }, SLIDE_MS + 30);
    }

    function userStep(delta) {
      if (animating || unit === 0) return;
      const visible = current % TOTAL_STEPS;
      if (delta > 0 && visible === TOTAL_STEPS - 1) {
        advance();
      } else if (delta < 0 && visible === 0) {
        // backward wrap: silently jump to clone slot, then animate to last step
        animating = true;
        applyTransform(TOTAL_STEPS, false);
        void tracks[0].offsetWidth;
        current = TOTAL_STEPS;
        requestAnimationFrame(() => {
          applyTransform(TOTAL_STEPS - 1, true);
          setActiveDot(TOTAL_STEPS - 1);
          current = TOTAL_STEPS - 1;
          window.setTimeout(() => { animating = false; }, SLIDE_MS + 30);
        });
      } else {
        jumpTo((visible + delta + TOTAL_STEPS) % TOTAL_STEPS);
      }
      stopTimer();
      window.setTimeout(startTimer, DWELL_MS);
    }

    function startTimer() {
      stopTimer();
      timerId = window.setInterval(() => {
        if (!paused) advance();
      }, DWELL_MS);
    }
    function stopTimer() {
      if (timerId !== null) {
        window.clearInterval(timerId);
        timerId = null;
      }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        jumpTo(i);
        stopTimer();
        window.setTimeout(startTimer, DWELL_MS);
      });
    });

    const prevBtn = wall.querySelector('[data-stamp-prev]');
    const nextBtn = wall.querySelector('[data-stamp-next]');
    if (prevBtn) prevBtn.addEventListener('click', () => userStep(-1));
    if (nextBtn) nextBtn.addEventListener('click', () => userStep(1));

    wall.addEventListener('mouseenter', () => { paused = true; });
    wall.addEventListener('mouseleave', () => { paused = false; });

    // Initial measure + re-measure on resize (keep current step position)
    measureUnit();
    applyTransform(0, false);
    setActiveDot(0);

    const ro = new ResizeObserver(() => {
      measureUnit();
      if (!animating) applyTransform(current, false);
    });
    ro.observe(tracks[0]);

    startTimer();
  })();

  // ------------------------------------------------------------------
  // Stamp tile click → wobble + member card overlay
  // ------------------------------------------------------------------
  (function initStampClicks() {
    const backdrop = document.querySelector('[data-member-card]');
    if (!backdrop) return;
    const closeBtn = backdrop.querySelector('[data-member-card-close]');
    const elPhoto = backdrop.querySelector('[data-member-card-photo]');
    const elAvatar = backdrop.querySelector('[data-member-card-avatar]');
    const elRole = backdrop.querySelector('[data-member-card-role]');
    const elName = backdrop.querySelector('[data-member-card-name]');
    const elBio = backdrop.querySelector('[data-member-card-bio]');
    const elMeta = backdrop.querySelector('[data-member-card-meta]');

    const byId = Object.fromEntries(members.map((m) => [m.id, m]));

    function initials(name) {
      return name.trim().split(/\s+/).map((w) => w[0].toUpperCase()).join('');
    }

    function open(id) {
      const m = byId[id];
      if (!m) return;
      elPhoto.src = m.photo;
      elAvatar.textContent = initials(m.name);
      elRole.textContent = `${m.role} · ${m.tenure}`;
      elName.textContent = m.name;
      elBio.textContent = m.bio;
      elMeta.textContent = `${m.bike} · ${m.joined}`;
      backdrop.setAttribute('aria-hidden', 'false');
      backdrop.classList.add('open');
    }
    function close() {
      backdrop.classList.remove('open');
      backdrop.setAttribute('aria-hidden', 'true');
    }

    document.querySelectorAll('.stamp-tile').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-member-id');
        btn.classList.remove('wobble');
        void btn.offsetWidth;
        btn.classList.add('wobble');
        setTimeout(() => open(id), 420);
      });
    });
    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', (e) => { if (e.target === backdrop) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop.classList.contains('open')) close();
    });
  })();

  </script>
</BaseLayout>

<style>
  .about-page {
    max-width: none;
    padding: 64px 24px 0;
  }

  /* ---------- Title ---------- */
  .about-title-block {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .about-eyebrow {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 14px;
  }
  .about-h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(40px, 5.5vw, 64px);
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--color-text-main);
    margin: 0;
  }
  .about-h1::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-accent);
    margin: 18px auto 0;
  }
  .about-subtitle {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: 17px;
    color: var(--color-text-secondary);
    margin-top: 14px;
    letter-spacing: 0.01em;
  }

  /* ---------- Intro ---------- */
  .about-intro {
    max-width: 860px;
    margin: 48px auto 0;
    text-align: center;
    padding: 0 24px;
  }
  .about-intro p {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 1.7;
    font-weight: 400;
    color: var(--color-text-main);
    margin: 0;
    letter-spacing: -0.005em;
  }
  .about-intro p + p {
    margin-top: 18px;
    font-size: 17.5px;
    color: var(--color-text-secondary);
  }
  .about-intro em {
    font-style: italic;
    color: var(--color-text-main);
  }

  .intro-to-poem-divider {
    display: block;
    width: 1px;
    height: 48px;
    background: var(--color-text-secondary);
    margin: 72px auto 0;
    opacity: 0.55;
  }

  /* ---------- Section rule ---------- */
  .section-rule {
    max-width: 700px;
    margin: 96px auto 0;
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-heading);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-text-secondary);
  }
  .section-rule::before,
  .section-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border-strong);
  }

  /* ---------- Across poem ---------- */
  .across-poem {
    max-width: 900px;
    margin: 56px auto 0;
    padding: 0 24px;
  }
  .across-stanzas {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .across-stanza {
    position: relative;
    min-height: 18vh;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 800ms ease, transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .across-stanza.in {
    opacity: 1;
    transform: translateY(0);
  }

  .across-glyph-bg {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: clamp(200px, 38%, 340px);
    height: 52%;
    z-index: 0;
    color: var(--color-accent);
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms ease 180ms;
  }
  .across-stanza.in .across-glyph-bg { opacity: 0.22; }
  :global(:root.dark) .across-stanza.in .across-glyph-bg { opacity: 0.32; }
  .across-glyph-bg svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .across-glyph-bg :global(path),
  .across-glyph-bg :global(line),
  .across-glyph-bg :global(polyline) {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    transition: stroke-dashoffset 1400ms cubic-bezier(0.55, 0, 0.25, 1) 260ms;
  }
  .across-stanza.in .across-glyph-bg :global(path),
  .across-stanza.in .across-glyph-bg :global(line),
  .across-stanza.in .across-glyph-bg :global(polyline) {
    stroke-dashoffset: 0;
  }
  .across-glyph-bg :global(.dashed) {
    stroke-dasharray: 6 8;
    stroke-dashoffset: 0;
    opacity: 0;
    transition: opacity 600ms ease 900ms;
  }
  .across-stanza.in .across-glyph-bg :global(.dashed) { opacity: 0.9; }

  .across-text {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .across-word {
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
    font-size: clamp(34px, 4.8vw, 54px);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-text-main);
  }
  .across-word .across-key {
    color: var(--color-accent);
    font-style: italic;
  }
  .across-gloss {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    font-style: italic;
    margin: 12px auto 0;
    max-width: 520px;
  }

  .across-signature {
    margin-top: 72px;
    text-align: center;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 900ms ease 200ms, transform 900ms ease 200ms;
  }
  .across-signature.in {
    opacity: 1;
    transform: translateY(0);
  }
  .across-signature-rule {
    display: block;
    width: 36px;
    height: 1px;
    background: var(--color-border-strong);
    margin: 0 auto 18px;
  }
  .across-signature-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }
  .across-signature-text b {
    font-weight: 700;
