---
// dashboard/login.astro — GitHub OAuth login page (SSR)
export const prerender = false;

const apiUrl = import.meta.env.PUBLIC_API_URL || "https://acc-clubhub-events-ms.vercel.app";

// Check if already authenticated (server-side, no cookies forwarded)
try {
  const cookie = Astro.request.headers.get("cookie") || "";
  const meRes = await fetch(`${apiUrl}/auth/me`, {
    headers: { "Cookie": cookie },
  });
  if (meRes.ok) {
    return Astro.redirect("/dashboard", 302);
  }
} catch {
  // Not authenticated — show login page
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login | ACC ClubHub</title>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        background: #f6f8fa;
      }
      .login-box {
        background: white;
        padding: 3rem;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        text-align: center;
        max-width: 400px;
      }
      h1 { font-size: 1.5rem; margin-bottom: 0.5rem; color: #24292f; }
      p { color: #57606a; margin-bottom: 2rem; }
      .login-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: #24292f;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        transition: background 0.2s;
      }
      .login-btn:hover { background: #3d444d; }
      .login-btn svg { width: 20px; height: 20px; }
    </style>
  </head>
  <body>
    <div class="login-box">
      <h1>ACC ClubHub Admin</h1>
      <p>Sign in with your GitHub account to access the admin dashboard.</p>
      <a href="/auth/login" class="login-btn">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        Login with GitHub
      </a>
    </div>
  </body>
</html>
