---
export const prerender = false;

import {
  RideLeaderTrendChart,
} from "../../../components/dashboard/RideLeaderTrendChart";
import "../../../styles/dashboard.css";

const apiUrl = import.meta.env.PUBLIC_API_URL
  || "https://acc-clubhub-events-ms.vercel.app";
const isLocalPreview = import.meta.env.DEV
  && ["127.0.0.1", "localhost"].includes(Astro.url.hostname)
  && Astro.url.searchParams.get("preview") === "1";

const cookie = Astro.request.headers.get("cookie") || "";

const now = new Date();
const requestedYear = Number(
  Astro.url.searchParams.get("year") || now.getUTCFullYear(),
);
const year = Number.isFinite(requestedYear) ? requestedYear : now.getUTCFullYear();
const selectedLeader = Astro.url.searchParams.get("leader") || "";

let summaryData = { year, leaders: [] as any[] };
let detailData: any = null;
let allLeaderDetails: any[] = [];
let fetchError: string | null = null;

if (isLocalPreview) {
  summaryData = {
    year,
    leaders: [
      {
        leader_name: "Alice Zhang",
        lead_events_count: 4,
        total_credited_km: 186.5,
        reimbursement_eligible: false,
        annual_target_km: 320,
        excess_km: 0,
        estimated_subsidy_eur: 0,
      },
      {
        leader_name: "Bob Li",
        lead_events_count: 7,
        total_credited_km: 332,
        reimbursement_eligible: true,
        annual_target_km: 320,
        excess_km: 12,
        estimated_subsidy_eur: 1,
      },
    ],
  };
  detailData = {
    year,
    leader_name: selectedLeader || "Bob Li",
    lead_events_count: 7,
    total_credited_km: 332,
    reimbursement_eligible: true,
    annual_target_km: 320,
    excess_km: 12,
    estimated_subsidy_eur: 1,
    progress: [
      {
        event_id: 1,
        event_date: `${year}-03-15T09:00:00Z`,
        cumulative_km: 45,
        credit_km: 45,
      },
      {
        event_id: 2,
        event_date: `${year}-04-05T09:00:00Z`,
        cumulative_km: 102,
        credit_km: 57,
      },
      {
        event_id: 3,
        event_date: `${year}-05-11T09:00:00Z`,
        cumulative_km: 175,
        credit_km: 73,
      },
      {
        event_id: 4,
        event_date: `${year}-06-09T09:00:00Z`,
        cumulative_km: 245,
        credit_km: 70,
      },
      {
        event_id: 5,
        event_date: `${year}-07-19T09:00:00Z`,
        cumulative_km: 332,
        credit_km: 87,
      },
    ],
    history: [
      {
        event_id: 5,
        event_slug: "preview-alps-ride",
        event_title: "Preview Alps Ride",
        event_date: `${year}-07-19T09:00:00Z`,
        distance_km: 87,
        checked_in_count: 18,
        effective_group_count: 3,
        credited_leader_count: 3,
        credit_km: 87,
      },
    ],
  };
  allLeaderDetails = [
    {
      leader_name: "Alice Zhang",
      annual_target_km: 320,
      total_credited_km: 186.5,
      progress: [
        {
          event_id: 11,
          event_date: `${year}-02-10T09:00:00Z`,
          cumulative_km: 32,
          credit_km: 32,
        },
        {
          event_id: 12,
          event_date: `${year}-03-22T09:00:00Z`,
          cumulative_km: 78,
          credit_km: 46,
        },
        {
          event_id: 13,
          event_date: `${year}-05-18T09:00:00Z`,
          cumulative_km: 141.5,
          credit_km: 63.5,
        },
        {
          event_id: 14,
          event_date: `${year}-07-03T09:00:00Z`,
          cumulative_km: 186.5,
          credit_km: 45,
        },
      ],
    },
    detailData,
  ];
} else {
  try {
    const overviewRes = await fetch(
      `${apiUrl}/api/admin/ride-leaders/overview?year=${year}`,
      { headers: { "Cookie": cookie } },
    );
    if (overviewRes.status === 401) {
      return Astro.redirect("/dashboard/login", 302);
    }
    if (!overviewRes.ok) {
      fetchError = `Failed to fetch ride leader data: ${overviewRes.status}`;
    } else {
      const overview = await overviewRes.json();
      summaryData = { year: overview.year, leaders: overview.leaders ?? [] };
      allLeaderDetails = overview.details ?? [];
      const leaderForDetail = (
        selectedLeader || summaryData.leaders[0]?.leader_name
      );
      detailData = allLeaderDetails.find(
        (leader: any) => leader.leader_name === leaderForDetail,
      ) ?? allLeaderDetails[0] ?? null;
    }
  } catch (e) {
    const message = e instanceof Error ? e.message : String(e);
    fetchError = `Failed to load ride leader board: ${message}`;
  }
}

function formatDate(value: string | null): string {
  if (!value) return "—";
  return new Date(value).toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

function formatKm(value: number | null | undefined): string {
  if (value == null || Number.isNaN(value)) return "—";
  return `${Number(value).toFixed(1)} km`;
}

function buildLeaderUrl(leaderName: string): string {
  const params = new URLSearchParams();
  params.set("year", String(year));
  params.set("leader", leaderName);
  return `/dashboard/ride-leaders?${params.toString()}`;
}

function buildYearUrl(nextYear: number): string {
  const params = new URLSearchParams();
  params.set("year", String(nextYear));
  if (selectedLeader) params.set("leader", selectedLeader);
  return `/dashboard/ride-leaders?${params.toString()}`;
}

const trendLeaders = allLeaderDetails.length > 0
  ? allLeaderDetails
  : detailData
    ? [detailData]
    : [];
const selectedProgressPercent = detailData
  ? Math.min(
      100,
      Math.max(
        0,
        (Number(detailData.total_credited_km ?? 0)
          / Number(detailData.annual_target_km ?? 320)) * 100,
      ),
    )
  : 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ride Leader Board | ACC ClubHub Admin</title>
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #f6f8fa;
        margin: 0;
        padding: 2rem;
      }
      .container { max-width: 1200px; margin: 0 auto; }
      .breadcrumb { margin-bottom: 1.5rem; }
      .breadcrumb a { color: #0969da; text-decoration: none; font-size: 0.9rem; }
      .breadcrumb a:hover { text-decoration: underline; }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      h1 { font-size: 1.5rem; margin: 0; color: #24292f; }
      .year-switcher {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .year-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2rem;
        height: 2rem;
        border-radius: 999px;
        border: 1px solid #d0d7de;
        background: white;
        color: #24292f;
        text-decoration: none;
      }
      .year-link:hover { background: #f6f8fa; }
      .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      .summary-card {
        background: white;
        border: 1px solid #d0d7de;
        border-radius: 8px;
        padding: 1rem 1.2rem;
      }
      .summary-card .label {
        font-size: 0.75rem;
        color: #57606a;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .summary-card .value {
        margin-top: 0.35rem;
        font-size: 1.4rem;
        font-weight: 700;
        color: #24292f;
      }
      .error {
        background: #ffebe9;
        border: 1px solid #ff818266;
        padding: 1rem;
        border-radius: 6px;
        color: #cf222e;
        margin-bottom: 1rem;
      }
      .panel {
        background: white;
        border: 1px solid #d0d7de;
        border-radius: 8px;
        padding: 1rem 1.2rem;
        margin-bottom: 1.5rem;
      }
      .panel h2 {
        margin: 0 0 1rem;
        font-size: 1.05rem;
        color: #24292f;
      }
      .panel-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
      }
      .panel-header h2 { margin-bottom: 0.25rem; }
      .panel-kicker {
        margin: 0;
        color: #57606a;
        font-size: 0.88rem;
      }
      .table-scroll {
        overflow-x: auto;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        padding: 0.75rem 0.6rem;
        border-bottom: 1px solid #eaeef2;
        text-align: left;
        font-size: 0.9rem;
      }
      th {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #57606a;
      }
      tr:last-child td { border-bottom: none; }
      .leader-link {
        color: #0969da;
        text-decoration: none;
        font-weight: 600;
      }
      .leader-link:hover { text-decoration: underline; }
      .chart-shell {
        border: 1px solid #d0d7de;
        border-radius: 8px;
        padding: 1rem;
        background:
          radial-gradient(
            circle at top left,
            rgba(37, 99, 235, 0.08),
            transparent 28rem
          ),
          linear-gradient(to top, #f8fafc 0%, white 78%);
      }
      .chart-meta {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 0.75rem;
        color: #57606a;
        font-size: 0.85rem;
      }
      .trend-shell {
        position: relative;
        overflow: hidden;
        padding: 1.1rem 1.1rem 0.85rem;
      }
      .chart-empty {
        color: #57606a;
        padding: 2rem 0;
      }
      .history-layout {
        display: grid;
        grid-template-columns: minmax(280px, 0.85fr) minmax(420px, 1.15fr);
        gap: 1.5rem;
      }
      .selected-progress {
        display: grid;
        gap: 0.9rem;
      }
      .metric-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #eaeef2;
      }
      .metric-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }
      .metric-row span:first-child {
        color: #57606a;
        font-size: 0.88rem;
      }
      .metric-row strong {
        color: #24292f;
        font-size: 1rem;
      }
      .progress-track {
        height: 0.65rem;
        overflow: hidden;
        border-radius: 999px;
        background: #eaeef2;
      }
      .progress-fill {
        width: var(--progress-width);
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #2563eb, #0891b2);
      }
      .pill {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        background: #eef1f5;
        color: #57606a;
        font-size: 0.78rem;
        font-weight: 600;
      }
      .pill.good {
        background: #dafbe1;
        color: #1a7f37;
      }
      @media (max-width: 900px) {
        body { padding: 1rem; }
        .panel-header { display: block; }
        .history-layout { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body class="dashboard-page dashboard-ride-leaders">
    <div class="container">
      <div class="breadcrumb">
        <a href="/dashboard">&larr; Admin Dashboard</a>
      </div>

      <div class="header">
        <h1>Ride Leader Board</h1>
        <div class="year-switcher">
          <a
            class="year-link"
            href={buildYearUrl(year - 1)}
            aria-label="Previous year"
          >
            ←
          </a>
          <strong>{year}</strong>
          <a
            class="year-link"
            href={buildYearUrl(year + 1)}
            aria-label="Next year"
          >
            →
          </a>
        </div>
      </div>

      {fetchError && <div class="error">{fetchError}</div>}

      {detailData && (
        <div class="summary-grid">
          <div class="summary-card">
            <div class="label">Selected Leader</div>
            <div class="value">{detailData.leader_name}</div>
          </div>
          <div class="summary-card">
            <div class="label">Lead Events</div>
            <div class="value">{detailData.lead_events_count}</div>
          </div>
          <div class="summary-card">
            <div class="label">Total Credited</div>
            <div class="value">{formatKm(detailData.total_credited_km)}</div>
          </div>
          <div class="summary-card">
            <div class="label">Reimbursement</div>
            <div class="value">
              <span class={`pill ${detailData.reimbursement_eligible ? 'good' : ''}`}>
                {detailData.reimbursement_eligible ? 'Eligible' : 'In progress'}
              </span>
            </div>
          </div>
        </div>
      )}

      <section class="panel">
        <div class="panel-header">
          <div>
            <h2>All Leaders · Cumulative Trend</h2>
            <p class="panel-kicker">
              Date-based annual credit progress across ride leaders.
            </p>
          </div>
          <span class="pill">{trendLeaders.length} leaders</span>
        </div>
        <div class="chart-shell trend-shell">
          <RideLeaderTrendChart
            leaders={trendLeaders}
            selectedLeader={detailData?.leader_name}
            year={year}
            client:load
          />
        </div>
      </section>

      <section class="panel">
        <h2>Annual Board</h2>
        {summaryData.leaders.length === 0 ? (
          <div class="chart-empty">No ride leader credits recorded for {year} yet.</div>
        ) : (
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Ride Leader</th>
                  <th>Lead Events</th>
                  <th>Total Credited</th>
                  <th>300 km Threshold</th>
                  <th>Annual Target</th>
                  <th>Excess</th>
                  <th>Estimated Subsidy</th>
                </tr>
              </thead>
              <tbody>
                {summaryData.leaders.map((leader: any) => (
                  <tr>
                    <td>
                      <a
                        class="leader-link"
                        href={buildLeaderUrl(leader.leader_name)}
                      >
                        {leader.leader_name}
                      </a>
                    </td>
                    <td>{leader.lead_events_count}</td>
                    <td>{formatKm(leader.total_credited_km)}</td>
                    <td>
                      <span
                        class={`pill ${leader.reimbursement_eligible ? 'good' : ''}`}
                      >
                        {leader.reimbursement_eligible ? 'Reached' : 'Not yet'}
                      </span>
                    </td>
                    <td>{formatKm(leader.annual_target_km)}</td>
                    <td>{formatKm(leader.excess_km)}</td>
                    <td>€{Number(leader.estimated_subsidy_eur ?? 0).toFixed(0)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      {detailData && (
        <div class="history-layout">
          <section class="panel">
            <h2>{detailData.leader_name} · Progress Snapshot</h2>
            <div class="selected-progress">
              <div class="progress-track" aria-label="Annual target progress">
                <div
                  class="progress-fill"
                  style={`--progress-width: ${selectedProgressPercent}%`}
                ></div>
              </div>
              <div class="metric-row">
                <span>Total credited</span>
                <strong>{formatKm(detailData.total_credited_km)}</strong>
              </div>
              <div class="metric-row">
                <span>Annual target</span>
                <strong>{formatKm(detailData.annual_target_km)}</strong>
              </div>
              <div class="metric-row">
                <span>300 km threshold</span>
                <strong>
                  {detailData.reimbursement_eligible ? "Reached" : "Not yet"}
                </strong>
              </div>
              <div class="metric-row">
                <span>Lead events</span>
                <strong>{detailData.lead_events_count}</strong>
              </div>
            </div>
          </section>

          <section class="panel">
            <h2>{detailData.leader_name} · Event History</h2>
            {detailData.history.length === 0 ? (
              <div class="chart-empty">No event history available.</div>
            ) : (
              <div class="table-scroll">
                <table>
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Event</th>
                      <th>Distance</th>
                      <th>Checked-in</th>
                      <th>Groups</th>
                      <th>Leaders</th>
                      <th>Credited</th>
                    </tr>
                  </thead>
                  <tbody>
                    {detailData.history.map((row: any) => (
                      <tr>
                        <td>{formatDate(row.event_date)}</td>
                        <td>{row.event_title}</td>
                        <td>{formatKm(row.distance_km)}</td>
                        <td>{row.checked_in_count}</td>
                        <td>{row.effective_group_count}</td>
                        <td>{row.credited_leader_count}</td>
                        <td>{formatKm(row.credit_km)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </div>
      )}
    </div>
  </body>
</html>
