---
// dashboard/season-planner/[id].astro — Slot detail & edit page (SSR)
export const prerender = false;

import type { PlanSlot } from "../../../lib/admin/seasonPlanner";
import { EVENT_TYPE_LABEL } from "../../../lib/admin/seasonPlanner";
import "../../../styles/dashboard.css";

const apiUrl = import.meta.env.PUBLIC_API_URL || "https://acc-clubhub-events-ms.vercel.app";
const cookie = Astro.request.headers.get("cookie") || "";

const { id } = Astro.params;

let slot: PlanSlot | null = null;
let loadError: string | null = null;

try {
  const res = await fetch(`${apiUrl}/api/admin/season/slots/${id}`, {
    headers: { Cookie: cookie },
  });
  if (res.status === 404) return Astro.redirect("/dashboard/season-planner", 302);
  if (res.status === 401) return Astro.redirect("/dashboard/login", 302);
  if (res.ok) slot = await res.json();
  else loadError = `Failed to load slot (${res.status})`;
} catch (e: unknown) {
  loadError = `Error: ${e instanceof Error ? e.message : String(e)}`;
}

const canDelete =
  slot !== null &&
  slot.claimed_by === null &&
  slot.published_event_id === null;

function formatDate(d: string): string {
  try {
    return new Date(d + "T00:00:00").toLocaleDateString("en-GB", {
      weekday: "short", year: "numeric", month: "short", day: "numeric",
    });
  } catch { return d; }
}

const READINESS_OPTIONS = [
  { value: "idea",              label: "Idea only / 初步想法" },
  { value: "route_drafted",     label: "Route sketched / 路线大致确定" },
  { value: "leader_confirmed",  label: "Owner confirmed / 负责人确认" },
  { value: "logistics_done",    label: "Logistics ready / 后勤信息完成" },
  { value: "ready_to_publish",  label: "Ready for agent handoff / 信息完整" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Slot #{id} | Season Planning | ACC ClubHub Admin</title>
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #f6f8fa;
        margin: 0;
        padding: 2rem;
      }
      .container { max-width: 760px; margin: 0 auto; }
      .breadcrumb { margin-bottom: 1.5rem; font-size: 0.9rem; }
      .breadcrumb a { color: #C62828; text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      .breadcrumb span { color: #57606a; margin: 0 0.4rem; }

      .slot-header { margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid #d0d7de; }
      .slot-header h1 { font-size: 1.3rem; margin: 0 0 0.3rem; color: #24292f; }
      .slot-meta { font-size: 0.85rem; color: #57606a; display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.4rem; }
      .slot-meta .badge {
        display: inline-block; padding: 0.15rem 0.5rem;
        border-radius: 4px; font-size: 0.74rem; font-weight: 600;
        background: #eef1f5; color: #57606a;
      }

      .card {
        background: white;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.25rem;
      }
      .card h2 { font-size: 0.95rem; font-weight: 700; color: #24292f; margin: 0 0 1rem; }

      .form-group { margin-bottom: 0.9rem; }
      .form-group label {
        display: block; font-size: 0.82rem; font-weight: 600;
        color: #57606a; text-transform: uppercase; letter-spacing: 0.04em;
        margin-bottom: 0.3rem;
      }
      .form-group input[type="text"],
      .form-group input[type="email"],
      .form-group input[type="url"],
      .form-group input[type="number"],
      .form-group textarea,
      .form-group select {
        width: 100%; padding: 0.45rem 0.7rem;
        border: 1px solid #d0d7de; border-radius: 6px;
        font-size: 0.875rem; font-family: inherit;
        background: white;
      }
      .form-group textarea { resize: vertical; min-height: 80px; }
      .form-group input:focus,
      .form-group textarea:focus,
      .form-group select:focus { outline: 2px solid #C62828; outline-offset: 1px; border-color: #C62828; }
      .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

      .action-btn {
        padding: 0.45rem 1.1rem;
        background: #C62828; color: white;
        border: none; border-radius: 6px;
        font-size: 0.875rem; font-weight: 600;
        cursor: pointer; transition: background 0.2s;
      }
      .action-btn:hover { background: #a81f1f; }
      .action-btn:disabled { background: #8b949e; cursor: not-allowed; }
      .btn-secondary {
        padding: 0.45rem 1rem;
        background: white; border: 1px solid #d0d7de;
        border-radius: 6px; font-size: 0.875rem;
        cursor: pointer; color: #24292f;
      }
      .btn-secondary:hover { background: #f6f8fa; }
      .btn-danger {
        padding: 0.45rem 1rem;
        background: white; border: 1px solid #cf222e;
        color: #cf222e; border-radius: 6px;
        font-size: 0.875rem; cursor: pointer;
      }
      .btn-danger:hover { background: #ffebe9; }
      .btn-row { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }

      .owner-name { font-weight: 600; color: #24292f; }
      .field-note { margin: 0.3rem 0 0; font-size: 0.78rem; color: #57606a; }

      .msg { padding: 0.6rem 0.9rem; border-radius: 6px; font-size: 0.85rem; margin-top: 0.6rem; }
      .msg-ok  { background: #dafbe1; color: #1a7f37; }
      .msg-err { background: #ffebe9; color: #cf222e; }
      .msg { display: none; }
      .msg.visible { display: block; }

      .error-banner { background: #ffebe9; border: 1px solid #ff818266; padding: 1rem; border-radius: 6px; color: #cf222e; }
    </style>
  </head>
  <body class="dashboard-page dashboard-season-detail">
    <div class="container">
      <div class="breadcrumb">
        <a href="/dashboard">Admin Dashboard</a>
        <span>›</span>
        <a href="/dashboard/season-planner">Season Planning</a>
        <span>›</span>
        Slot #{id}
      </div>

      {loadError && <div class="error-banner">{loadError}</div>}

      {slot && (
        <>
          <div class="slot-header">
            <h1>{EVENT_TYPE_LABEL[slot.event_type] ?? slot.event_type}</h1>
            <div class="slot-meta">
              <span>{formatDate(slot.planned_date)}</span>
              <span>Week {slot.iso_week}</span>
              <span class="badge">Season {slot.season}</span>
              {slot.auto_generated && <span class="badge">Auto-generated</span>}
              {slot.locked && <span class="badge" style="background:#fff8c5;color:#9a6700;">Locked</span>}
            </div>
          </div>

          <!-- Planning form -->
          <div class="card">
            <h2>Planning Details</h2>
            <div class="form-group">
              <label for="f-title">Working title / 活动标题</label>
              <input type="text" id="f-title" value={slot.title ?? ""} placeholder="Leave blank to use the default slot type" />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="f-location">Area / Meeting point</label>
                <input type="text" id="f-location" value={slot.location ?? ""} placeholder="e.g. Ammersee / Giesing / Olympiapark" />
              </div>
              <div class="form-group">
                <label for="f-distance">Estimated distance (km)</label>
                <input type="number" id="f-distance" step="0.1" min="0"
                  value={slot.distance_km != null ? String(slot.distance_km) : ""} />
              </div>
            </div>
            <div class="form-group">
              <label for="f-route-url">Route link / 路线链接</label>
              <input type="url" id="f-route-url" value={slot.route_url ?? ""} placeholder="Komoot / Strava / Google Maps URL" />
            </div>
            <div class="form-group">
              <label for="f-notes">Ride idea / 简短备注</label>
              <textarea id="f-notes" placeholder="Route idea, rough intensity, constraints, or anything the owner should know">{slot.notes ?? ""}</textarea>
            </div>
          </div>

          <!-- Ownership -->
          <div class="card">
            <h2>Ownership</h2>
            <div class="form-row">
              <div class="form-group">
                <label for="f-owner">Owner</label>
                <input type="text" id="f-owner" value={slot.claimed_by ?? ""} placeholder="Unclaimed / 未认领" />
              </div>
              <div class="form-group">
                <label for="f-owner-email">Owner email</label>
                <input type="email" id="f-owner-email" value={slot.claimed_email ?? ""} placeholder="Optional, for reminders" />
              </div>
            </div>
            <div class="form-group">
              <label for="f-backup">Backup / 替班说明</label>
              <textarea id="f-backup" placeholder="Who can cover if the owner cannot lead? Any handoff notes?">{slot.backup_or_replacement ?? ""}</textarea>
            </div>
            <div class="form-group">
              <label for="f-readiness">Planning readiness</label>
              <select id="f-readiness">
                {READINESS_OPTIONS.map((o) => (
                  <option value={o.value} selected={slot!.readiness === o.value}>{o.label}</option>
                ))}
              </select>
              <p class="field-note">Internal planning signal only. It does not connect to the public event publishing flow.</p>
            </div>
            <div class="btn-row">
              <button class="action-btn" id="save-btn">Save Slot</button>
              {slot.claimed_by && (
                <button class="btn-secondary" id="release-btn" type="button">Clear Owner</button>
              )}
            </div>
            <div class="msg" id="save-msg"></div>
            <div class="msg" id="ownership-msg"></div>
          </div>

          <div class="card">
            <h2>Current Summary</h2>
            <div class="slot-meta">
              <span class="badge">{slot.claimed_by ? slot.claimed_by : "Unclaimed"}</span>
              <span class="badge">{READINESS_OPTIONS.find((o) => o.value === slot!.readiness)?.label ?? slot.readiness}</span>
              {slot.route_url && (
                <a href={slot.route_url} target="_blank" rel="noreferrer" class="breadcrumb">Open route link</a>
              )}
            </div>
          </div>

          <!-- Danger zone -->
          {canDelete && (
            <div class="card" style="border-color:#ff818266;">
              <h2 style="color:#cf222e;">Danger Zone</h2>
              <p style="font-size:0.85rem;color:#57606a;margin:0 0 0.75rem;">
                This slot has no owner and can be removed from the planning board.
              </p>
              <button class="btn-danger" id="delete-btn">Delete Slot</button>
              <div class="msg" id="delete-msg"></div>
            </div>
          )}
        </>
      )}
    </div>

    <script define:vars={{ slotId: id }}>
      function showMsg(elId, text, isOk) {
        const el = document.getElementById(elId);
        if (!el) return;
        el.textContent = text;
        el.className = "msg visible " + (isOk ? "msg-ok" : "msg-err");
      }

      async function apiCall(path, method, body) {
        const res = await fetch(path, {
          method,
          headers: body ? { "Content-Type": "application/json" } : {},
          body: body ? JSON.stringify(body) : undefined,
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || JSON.stringify(data));
        return data;
      }

      document.getElementById("save-btn")?.addEventListener("click", async () => {
        const btn = document.getElementById("save-btn");
        btn.disabled = true;
        btn.textContent = "Saving...";
        try {
          const payload = {
            title: document.getElementById("f-title").value.trim() || null,
            location: document.getElementById("f-location").value.trim() || null,
            distance_km: document.getElementById("f-distance").value
              ? parseFloat(document.getElementById("f-distance").value) : null,
            route_url: document.getElementById("f-route-url").value.trim() || null,
            notes: document.getElementById("f-notes").value.trim() || null,
            claimed_by: document.getElementById("f-owner").value.trim() || null,
            claimed_email: document.getElementById("f-owner-email").value.trim() || null,
            backup_or_replacement: document.getElementById("f-backup").value.trim() || null,
            readiness: document.getElementById("f-readiness").value,
          };
          await apiCall(`/api/admin/season/${slotId}`, "PATCH", payload);
          showMsg("save-msg", "Saved. Reloading...", true);
          setTimeout(() => location.reload(), 700);
        } catch (e) {
          showMsg("save-msg", "Error: " + e.message, false);
          btn.disabled = false;
          btn.textContent = "Save Slot";
        }
      });

      document.getElementById("release-btn")?.addEventListener("click", async () => {
        if (!confirm("Clear the owner for this slot?")) return;
        try {
          await apiCall(`/api/admin/season/${slotId}/release`, "POST");
          showMsg("ownership-msg", "Owner cleared. Reloading...", true);
          setTimeout(() => location.reload(), 700);
        } catch (e) {
          showMsg("ownership-msg", "Error: " + e.message, false);
        } finally {
          const ownerInput = document.getElementById("f-owner");
          const ownerEmailInput = document.getElementById("f-owner-email");
          if (ownerInput) ownerInput.value = "";
          if (ownerEmailInput) ownerEmailInput.value = "";
        }
      });

      // Delete
      document.getElementById("delete-btn")?.addEventListener("click", async () => {
        if (!confirm("Delete this slot permanently? This cannot be undone.")) return;
        try {
          await apiCall(`/api/admin/season/${slotId}`, "DELETE");
          window.location.href = "/dashboard/season-planner";
        } catch (e) {
          showMsg("delete-msg", "Error: " + e.message, false);
        }
      });

    </script>
  </body>
</html>
