---
// dashboard/season-planner/index.astro — Season Planning weekly board (SSR)
export const prerender = false;

import type { GroupedSlotsResponse, WeekGroup, PlanSlot } from "../../../lib/admin/seasonPlanner";
import {
  EVENT_TYPE_LABEL,
  STATUS_LABEL,
} from "../../../lib/admin/seasonPlanner";

const apiUrl = import.meta.env.PUBLIC_API_URL || "https://acc-clubhub-events-ms.vercel.app";

// Verify authentication — forward browser cookies to backend
const cookie = Astro.request.headers.get("cookie") || "";
try {
  const meRes = await fetch(`${apiUrl}/auth/me`, {
    headers: { "Cookie": cookie },
  });
  if (!meRes.ok) {
    return Astro.redirect("/dashboard/login", 302);
  }
} catch {
  return Astro.redirect("/dashboard/login", 302);
}

const season = Astro.url.searchParams.get("season") || "2026";

let weeks: WeekGroup[] = [];
let fetchError: string | null = null;

try {
  const res = await fetch(
    `${apiUrl}/api/admin/season/slots/grouped?season=${encodeURIComponent(season)}`,
    { headers: { "Cookie": cookie } },
  );
  if (res.ok) {
    const data: GroupedSlotsResponse = await res.json();
    weeks = data.weeks || [];
  } else if (res.status === 401) {
    return Astro.redirect("/dashboard/login", 302);
  } else {
    fetchError = `Failed to load slots (${res.status})`;
  }
} catch (e: unknown) {
  fetchError = `Error loading slots: ${e instanceof Error ? e.message : String(e)}`;
}

// Map weekday index (Mon=0) → slot for a given week's slots
function slotsByWeekday(slots: PlanSlot[]): Map<number, PlanSlot> {
  const m = new Map<number, PlanSlot>();
  for (const s of slots) {
    m.set(s.weekday, s);
  }
  return m;
}

const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

function slotColor(eventType: string): string {
  if (eventType === "after_work_south" || eventType === "after_work_north") return "cell-afterwork";
  if (eventType === "weekend_casual") return "cell-casual";
  if (eventType === "weekend_challenge") return "cell-challenge";
  if (eventType === "special_event") return "cell-special";
  if (eventType === "eyas_program") return "cell-eyas";
  return "cell-other";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Season Planning | ACC ClubHub Admin</title>
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #f6f8fa;
        margin: 0;
        padding: 2rem;
      }
      .container { max-width: 1100px; margin: 0 auto; }
      .breadcrumb { margin-bottom: 1.5rem; }
      .breadcrumb a { color: #C62828; text-decoration: none; font-size: 0.9rem; }
      .breadcrumb a:hover { text-decoration: underline; }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #d0d7de;
      }
      h1 { font-size: 1.5rem; margin: 0; color: #24292f; }
      .action-btn {
        display: inline-block;
        padding: 0.4rem 1rem;
        background: #C62828;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s;
      }
      .action-btn:hover { background: #a81f1f; }
      .action-btn:disabled { background: #8b949e; cursor: not-allowed; }

      .error { background: #ffebe9; border: 1px solid #ff818266; padding: 1rem; border-radius: 6px; color: #cf222e; margin-bottom: 1rem; }
      .empty { text-align: center; padding: 3rem; color: #57606a; }

      /* Weekly grid */
      .week-section { margin-bottom: 2rem; }
      .week-label {
        font-size: 0.9rem;
        font-weight: 700;
        color: #24292f;
        margin-bottom: 0.5rem;
      }
      .week-label .date-range { font-weight: 400; color: #57606a; font-size: 0.82rem; margin-left: 0.5rem; }

      .day-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
      }
      .day-header {
        text-align: center;
        font-size: 0.72rem;
        font-weight: 700;
        color: #57606a;
        padding: 0.25rem 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .day-cell {
        min-height: 72px;
        border-radius: 6px;
        border: 1px solid #d0d7de;
        background: #f6f8fa;
        position: relative;
        overflow: hidden;
      }
      .day-cell.cell-empty { background: #f6f8fa; }

      /* Slot colors */
      .cell-afterwork  { background: #fff8c5; border-color: #d4a017; }
      .cell-casual     { background: #dafbe1; border-color: #57ab5a; }
      .cell-challenge  { background: #ddf4ff; border-color: #54aeff; }
      .cell-special    { background: #ffeff7; border-color: #bf8700; }
      .cell-eyas       { background: #f0fff4; border-color: #116329; }
      .cell-other      { background: #eef1f5; border-color: #8c959f; }

      .day-cell a {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 0.4rem 0.5rem;
        height: 100%;
        text-decoration: none;
        color: inherit;
      }
      .day-cell a:hover { opacity: 0.85; }
      .cell-type {
        font-size: 0.7rem;
        font-weight: 700;
        line-height: 1.2;
        color: #24292f;
      }
      .cell-date {
        font-size: 0.65rem;
        color: #57606a;
        margin-top: auto;
      }
      .cell-status {
        font-size: 0.62rem;
        font-weight: 600;
        color: #57606a;
        margin-top: 2px;
      }

      /* Legend */
      .legend {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
        font-size: 0.8rem;
        color: #57606a;
      }
      .legend-item { display: flex; align-items: center; gap: 0.35rem; }
      .legend-dot {
        width: 12px; height: 12px; border-radius: 3px;
        border: 1px solid rgba(0,0,0,0.12);
      }

      /* Generate modal */
      dialog {
        border: 1px solid #d0d7de;
        border-radius: 8px;
        padding: 0;
        max-width: 420px;
        width: 100%;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
      }
      dialog::backdrop { background: rgba(0, 0, 0, 0.4); }
      .dialog-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #d0d7de;
        font-weight: 700;
        font-size: 1rem;
        color: #24292f;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .dialog-body { padding: 1.25rem; }
      .form-group { margin-bottom: 1rem; }
      .form-group label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #24292f;
        margin-bottom: 0.3rem;
      }
      .form-group input[type="text"],
      .form-group input[type="date"] {
        width: 100%;
        padding: 0.45rem 0.7rem;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        font-size: 0.875rem;
      }
      .form-group input:focus { outline: 2px solid #C62828; outline-offset: 1px; }
      .checkbox-row { display: flex; align-items: center; gap: 0.5rem; }
      .checkbox-row label { margin: 0; font-weight: 400; }
      .dialog-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid #d0d7de;
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
      }
      .btn-secondary {
        padding: 0.4rem 0.9rem;
        background: white;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        font-size: 0.875rem;
        cursor: pointer;
      }
      .btn-secondary:hover { background: #f6f8fa; }
      .preview-box {
        background: #f6f8fa;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        padding: 0.75rem;
        font-size: 0.85rem;
        color: #24292f;
        margin-top: 0.75rem;
        display: none;
      }
      .preview-box.visible { display: block; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="breadcrumb">
        <a href="/dashboard">&larr; Admin Dashboard</a>
      </div>

      <div class="header">
        <h1>Season Planning Dashboard</h1>
        <button class="action-btn" id="open-generate-modal">Generate Slots</button>
      </div>

      <!-- Legend -->
      <div class="legend">
        <span class="legend-item"><span class="legend-dot" style="background:#fff8c5;border-color:#d4a017;"></span>Afterwork</span>
        <span class="legend-item"><span class="legend-dot" style="background:#dafbe1;border-color:#57ab5a;"></span>Weekend Casual</span>
        <span class="legend-item"><span class="legend-dot" style="background:#ddf4ff;border-color:#54aeff;"></span>Weekend Challenge</span>
        <span class="legend-item"><span class="legend-dot" style="background:#ffeff7;border-color:#bf8700;"></span>Special Event</span>
        <span class="legend-item"><span class="legend-dot" style="background:#f0fff4;border-color:#116329;"></span>EYAS</span>
        <span class="legend-item"><span class="legend-dot" style="background:#f6f8fa;border-color:#d0d7de;"></span>Empty</span>
      </div>

      {fetchError && <div class="error">{fetchError}</div>}

      {weeks.length === 0 && !fetchError && (
        <div class="empty">
          No planning slots yet. Click &quot;Generate Slots&quot; to create the {season} season plan.
        </div>
      )}

      {weeks.map((week) => {
        const byDay = slotsByWeekday(week.slots);
        return (
          <div class="week-section">
            <div class="week-label">
              Week {week.iso_week}
              <span class="date-range">· {week.date_range}</span>
            </div>
            <div class="day-grid">
              {DAYS.map((d) => <div class="day-header">{d}</div>)}
              {DAYS.map((_, idx) => {
                const slot = byDay.get(idx);
                if (!slot) {
                  return <div class="day-cell cell-empty"></div>;
                }
                return (
                  <div class={`day-cell ${slotColor(slot.event_type)}`}>
                    <a href={`/dashboard/season-planner/${slot.id}`}>
                      <span class="cell-type">{EVENT_TYPE_LABEL[slot.event_type] ?? slot.event_type}</span>
                      <span class="cell-date">{slot.planned_date}</span>
                      <span class="cell-status">{STATUS_LABEL[slot.status] ?? slot.status}</span>
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Generate Slots modal -->
    <dialog id="generate-dialog">
      <div class="dialog-header">
        <span>Generate Planning Slots</span>
        <button class="btn-secondary" id="close-dialog" style="border:none;font-size:1.1rem;padding:0 0.3rem;">✕</button>
      </div>
      <div class="dialog-body">
        <div class="form-group">
          <label for="gen-season">Season</label>
          <input type="text" id="gen-season" value="2026" />
        </div>
        <div class="form-group">
          <label for="gen-start">Start Date</label>
          <input type="date" id="gen-start" value="2026-05-01" />
        </div>
        <div class="form-group">
          <label for="gen-end">End Date</label>
          <input type="date" id="gen-end" value="2026-11-30" />
        </div>
        <div class="form-group">
          <div class="checkbox-row">
            <input type="checkbox" id="gen-overwrite" />
            <label for="gen-overwrite">Overwrite existing unclaimed slots</label>
          </div>
        </div>
        <div class="preview-box" id="preview-box"></div>
      </div>
      <div class="dialog-footer">
        <button class="btn-secondary" id="cancel-dialog">Cancel</button>
        <button class="action-btn" id="dry-run-btn">Preview</button>
        <button class="action-btn" id="confirm-btn" style="display:none;">Confirm</button>
      </div>
    </dialog>

    <script>
      const dialog = document.getElementById("generate-dialog") as HTMLDialogElement;
      const openBtn = document.getElementById("open-generate-modal");
      const closeBtn = document.getElementById("close-dialog");
      const cancelBtn = document.getElementById("cancel-dialog");
      const dryRunBtn = document.getElementById("dry-run-btn") as HTMLButtonElement;
      const confirmBtn = document.getElementById("confirm-btn") as HTMLButtonElement;
      const previewBox = document.getElementById("preview-box") as HTMLDivElement;

      function openDialog() {
        previewBox.classList.remove("visible");
        previewBox.textContent = "";
        confirmBtn.style.display = "none";
        dryRunBtn.style.display = "";
        dialog.showModal();
      }

      function closeDialog() { dialog.close(); }

      openBtn?.addEventListener("click", openDialog);
      closeBtn?.addEventListener("click", closeDialog);
      cancelBtn?.addEventListener("click", closeDialog);
      dialog.addEventListener("click", (e) => { if (e.target === dialog) closeDialog(); });

      async function callGenerate(dryRun: boolean) {
        const season = (document.getElementById("gen-season") as HTMLInputElement).value.trim();
        const startDate = (document.getElementById("gen-start") as HTMLInputElement).value;
        const endDate = (document.getElementById("gen-end") as HTMLInputElement).value;
        const overwrite = (document.getElementById("gen-overwrite") as HTMLInputElement).checked;

        const res = await fetch("/api/admin/season/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            season,
            start_date: startDate,
            end_date: endDate,
            dry_run: dryRun,
            overwrite_unclaimed: overwrite,
          }),
        });

        if (!res.ok) {
          const err = await res.text();
          throw new Error(`API error (${res.status}): ${err}`);
        }
        return res.json();
      }

      dryRunBtn?.addEventListener("click", async () => {
        dryRunBtn.disabled = true;
        dryRunBtn.textContent = "Calculating…";
        previewBox.classList.remove("visible");
        try {
          const data = await callGenerate(true);
          previewBox.textContent = `Preview: will create ${data.would_create} slot(s), skipping ${data.skipped} existing.`;
          previewBox.classList.add("visible");
          confirmBtn.style.display = "";
        } catch (e: unknown) {
          previewBox.textContent = `Error: ${e instanceof Error ? e.message : String(e)}`;
          previewBox.classList.add("visible");
        } finally {
          dryRunBtn.disabled = false;
          dryRunBtn.textContent = "Preview";
        }
      });

      confirmBtn?.addEventListener("click", async () => {
        confirmBtn.disabled = true;
        confirmBtn.textContent = "Generating…";
        try {
          const data = await callGenerate(false);
          previewBox.textContent = `Done: created ${data.created} slot(s), skipped ${data.skipped}.`;
          previewBox.classList.add("visible");
          setTimeout(() => { closeDialog(); window.location.reload(); }, 1200);
        } catch (e: unknown) {
          previewBox.textContent = `Error: ${e instanceof Error ? e.message : String(e)}`;
          previewBox.classList.add("visible");
          confirmBtn.disabled = false;
          confirmBtn.textContent = "Confirm";
        }
      });
    </script>
  </body>
</html>
