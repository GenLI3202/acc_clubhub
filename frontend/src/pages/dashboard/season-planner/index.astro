---
// dashboard/season-planner/index.astro — Season Planning weekly board (SSR)
export const prerender = false;

import type { GroupedSlotsResponse, WeekGroup, PlanSlot } from "../../../lib/admin/seasonPlanner";
import { EVENT_TYPE_LABEL, STATUS_LABEL } from "../../../lib/admin/seasonPlanner";

const apiUrl = import.meta.env.PUBLIC_API_URL || "https://acc-clubhub-events-ms.vercel.app";

const cookie = Astro.request.headers.get("cookie") || "";
try {
  const meRes = await fetch(`${apiUrl}/auth/me`, { headers: { "Cookie": cookie } });
  if (!meRes.ok) return Astro.redirect("/dashboard/login", 302);
} catch {
  return Astro.redirect("/dashboard/login", 302);
}

const season = Astro.url.searchParams.get("season") || "2026";

let weeks: WeekGroup[] = [];
let fetchError: string | null = null;

try {
  const res = await fetch(
    `${apiUrl}/api/admin/season/slots/grouped?season=${encodeURIComponent(season)}`,
    { headers: { "Cookie": cookie } },
  );
  if (res.ok) {
    const data: GroupedSlotsResponse = await res.json();
    weeks = data.weeks || [];
  } else if (res.status === 401) {
    return Astro.redirect("/dashboard/login", 302);
  } else {
    fetchError = `Failed to load slots (${res.status})`;
  }
} catch (e: unknown) {
  fetchError = `Error loading slots: ${e instanceof Error ? e.message : String(e)}`;
}

function addDays(dateStr: string, days: number): string {
  const [y, m, d] = dateStr.split("-").map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d));
  dt.setUTCDate(dt.getUTCDate() + days);
  return dt.toISOString().split("T")[0];
}

function slotsByWeekday(slots: PlanSlot[]): Map<number, PlanSlot> {
  const m = new Map<number, PlanSlot>();
  for (const s of slots) m.set(s.weekday, s);
  return m;
}

function slotColor(eventType: string): string {
  if (eventType === "after_work_south" || eventType === "after_work_north") return "cell-afterwork";
  if (eventType === "weekend_casual") return "cell-casual";
  if (eventType === "weekend_challenge") return "cell-challenge";
  if (eventType === "special_ride") return "cell-special";
  if (eventType === "workshop") return "cell-workshop";
  if (eventType === "eyas_program") return "cell-eyas";
  return "cell-other";
}

const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

const lastWeek = weeks.length > 0 ? weeks[weeks.length - 1] : null;
const nextWeekMonday = lastWeek ? addDays(lastWeek.monday, 7) : null;
const nextWeekSunday = lastWeek ? addDays(lastWeek.monday, 13) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Season Planning | ACC ClubHub Admin</title>
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #f6f8fa;
        margin: 0;
        padding: 2rem;
      }
      .container { max-width: 1100px; margin: 0 auto; }
      .breadcrumb { margin-bottom: 1.5rem; }
      .breadcrumb a { color: #C62828; text-decoration: none; font-size: 0.9rem; }
      .breadcrumb a:hover { text-decoration: underline; }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #d0d7de;
      }
      h1 { font-size: 1.5rem; margin: 0; color: #24292f; }

      .btn-ghost {
        padding: 0.35rem 0.8rem;
        background: transparent;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        font-size: 0.8rem;
        color: #57606a;
        cursor: pointer;
      }
      .btn-ghost:hover { background: #f6f8fa; border-color: #8c959f; }

      .action-btn {
        display: inline-block;
        padding: 0.4rem 1rem;
        background: #C62828;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s;
      }
      .action-btn:hover { background: #a81f1f; }
      .action-btn:disabled { background: #8b949e; cursor: not-allowed; }

      .error { background: #ffebe9; border: 1px solid #ff818266; padding: 1rem; border-radius: 6px; color: #cf222e; margin-bottom: 1rem; }
      .empty { text-align: center; padding: 3rem; color: #57606a; }

      /* Legend */
      .legend {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
        font-size: 0.79rem;
        color: #57606a;
        align-items: center;
      }
      .legend-item { display: flex; align-items: center; gap: 0.35rem; }
      .legend-dot {
        width: 11px; height: 11px; border-radius: 3px;
        border: 1px solid rgba(0,0,0,0.12); flex-shrink: 0;
      }

      /* Weekly grid */
      .week-section { margin-bottom: 1.5rem; }
      .week-label {
        font-size: 0.88rem;
        font-weight: 700;
        color: #24292f;
        margin-bottom: 0.4rem;
      }
      .week-label .date-range { font-weight: 400; color: #57606a; font-size: 0.8rem; margin-left: 0.5rem; }

      .day-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
      }
      .day-header {
        text-align: center;
        font-size: 0.69rem;
        font-weight: 700;
        color: #8c959f;
        padding: 0.2rem 0;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .day-cell {
        min-height: 76px;
        border-radius: 6px;
        border: 1px solid #d0d7de;
        position: relative;
        overflow: hidden;
      }

      /* Empty cells — clickable */
      .day-cell.cell-empty {
        background: #f6f8fa;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s, border-color 0.15s;
      }
      .day-cell.cell-empty:hover {
        background: #eef1f5;
        border-color: #8c959f;
      }
      .add-icon {
        font-size: 1.4rem;
        color: #d0d7de;
        line-height: 1;
        transition: color 0.15s;
        user-select: none;
      }
      .day-cell.cell-empty:hover .add-icon { color: #8c959f; }

      /* Filled slot cells */
      .cell-afterwork  { background: #fff8c5; border-color: #d4a017; }
      .cell-casual     { background: #dafbe1; border-color: #57ab5a; }
      .cell-challenge  { background: #ddf4ff; border-color: #54aeff; }
      .cell-special    { background: #ffeff7; border-color: #8250df; }
      .cell-workshop   { background: #fff3e0; border-color: #e65c00; }
      .cell-eyas       { background: #f0fff4; border-color: #116329; }
      .cell-other      { background: #eef1f5; border-color: #8c959f; }

      .day-cell a {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 0.45rem 0.5rem;
        height: 100%;
        text-decoration: none;
        color: inherit;
      }
      .day-cell a:hover { opacity: 0.82; }
      .cell-type { font-size: 0.69rem; font-weight: 700; line-height: 1.25; color: #24292f; }
      .cell-date { font-size: 0.63rem; color: #57606a; margin-top: auto; }
      .cell-status { font-size: 0.61rem; font-weight: 600; color: #57606a; margin-top: 2px; }

      /* Add-next-week button */
      .add-week-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1rem;
        padding-top: 1.25rem;
        border-top: 2px dashed #d0d7de;
      }
      .add-week-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #C62828;
        color: white;
        border: none;
        font-size: 1.8rem;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s, transform 0.1s;
        flex-shrink: 0;
      }
      .add-week-btn:hover { background: #a81f1f; transform: scale(1.08); }
      .add-week-btn:disabled { background: #8b949e; cursor: not-allowed; transform: none; }
      .add-week-label { font-size: 0.85rem; color: #57606a; }

      /* Dialogs */
      dialog {
        border: 1px solid #d0d7de;
        border-radius: 8px;
        padding: 0;
        max-width: 400px;
        width: 100%;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      }
      dialog::backdrop { background: rgba(0,0,0,0.4); }
      .dialog-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #d0d7de;
        font-weight: 700;
        font-size: 0.95rem;
        color: #24292f;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .dialog-body { padding: 1.25rem; }
      .form-group { margin-bottom: 0.9rem; }
      .form-group label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #57606a;
        margin-bottom: 0.25rem;
      }
      .form-group input[type="text"],
      .form-group input[type="date"],
      .form-group select {
        width: 100%;
        padding: 0.45rem 0.7rem;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        font-size: 0.875rem;
        font-family: inherit;
        background: white;
      }
      .form-group input:focus,
      .form-group select:focus { outline: 2px solid #C62828; outline-offset: 1px; border-color: #C62828; }
      .form-group input[readonly] { background: #f6f8fa; color: #57606a; }
      .dialog-footer {
        padding: 0.9rem 1.25rem;
        border-top: 1px solid #d0d7de;
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
      }
      .btn-secondary {
        padding: 0.4rem 0.9rem;
        background: white;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        font-size: 0.875rem;
        cursor: pointer;
      }
      .btn-secondary:hover { background: #f6f8fa; }

      .msg { padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.82rem; display: none; margin-top: 0.5rem; }
      .msg.visible { display: block; }
      .msg-ok  { background: #dafbe1; color: #1a7f37; }
      .msg-err { background: #ffebe9; color: #cf222e; }

      /* Generate modal */
      .gen-preview-box {
        background: #f6f8fa;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        padding: 0.75rem;
        font-size: 0.85rem;
        color: #24292f;
        margin-top: 0.75rem;
        display: none;
      }
      .gen-preview-box.visible { display: block; }
      .checkbox-row { display: flex; align-items: center; gap: 0.5rem; }
      .checkbox-row label { margin: 0; font-weight: 400; font-size: 0.875rem; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="breadcrumb">
        <a href="/dashboard">&larr; Admin Dashboard</a>
      </div>

      <div class="header">
        <h1>Season Planning</h1>
        <button class="btn-ghost" id="open-generate-modal">Bulk Generate…</button>
      </div>

      <!-- Legend -->
      <div class="legend">
        <span class="legend-item"><span class="legend-dot" style="background:#fff8c5;border-color:#d4a017;"></span>Afterwork</span>
        <span class="legend-item"><span class="legend-dot" style="background:#dafbe1;border-color:#57ab5a;"></span>Weekend Casual</span>
        <span class="legend-item"><span class="legend-dot" style="background:#ddf4ff;border-color:#54aeff;"></span>Weekend Challenge</span>
        <span class="legend-item"><span class="legend-dot" style="background:#ffeff7;border-color:#8250df;"></span>Special Ride</span>
        <span class="legend-item"><span class="legend-dot" style="background:#fff3e0;border-color:#e65c00;"></span>Workshop</span>
        <span class="legend-item"><span class="legend-dot" style="background:#f0fff4;border-color:#116329;"></span>EYAS · 雏鹰计划</span>
        <span class="legend-item" style="margin-left:auto;font-size:0.75rem;color:#8c959f;">Click grey cell to add · Click "+" for next week</span>
      </div>

      {fetchError && <div class="error">{fetchError}</div>}

      {weeks.length === 0 && !fetchError && (
        <div class="empty">
          No planning slots yet. Click &ldquo;Bulk Generate&rdquo; above or use the&nbsp;
          <strong>+</strong>&nbsp;button that appears after each week.
        </div>
      )}

      {weeks.map((week) => {
        const byDay = slotsByWeekday(week.slots);
        return (
          <div class="week-section">
            <div class="week-label">
              Week {week.iso_week}
              <span class="date-range">· {week.date_range}</span>
            </div>
            <div class="day-grid">
              {DAYS.map((d) => <div class="day-header">{d}</div>)}
              {DAYS.map((_, idx) => {
                const slot = byDay.get(idx);
                const cellDate = addDays(week.monday, idx);
                if (!slot) {
                  return (
                    <div
                      class="day-cell cell-empty"
                      data-date={cellDate}
                      data-weekday={String(idx)}
                      data-season={season}
                      title={`Add slot for ${cellDate}`}
                    >
                      <span class="add-icon">+</span>
                    </div>
                  );
                }
                return (
                  <div class={`day-cell ${slotColor(slot.event_type)}`}>
                    <a href={`/dashboard/season-planner/${slot.id}`}>
                      <span class="cell-type">{EVENT_TYPE_LABEL[slot.event_type] ?? slot.event_type}</span>
                      <span class="cell-date">{slot.planned_date}</span>
                      <span class="cell-status">{STATUS_LABEL[slot.status] ?? slot.status}</span>
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}

      {nextWeekMonday && (
        <div class="add-week-row">
          <button
            class="add-week-btn"
            id="add-week-btn"
            data-next-monday={nextWeekMonday}
            data-next-sunday={nextWeekSunday}
            data-season={season}
            title={`Add week of ${nextWeekMonday}`}
          >+</button>
          <span class="add-week-label">Add week of <strong>{nextWeekMonday}</strong> (Tue · Thu · Sat defaults)</span>
        </div>
      )}
    </div>

    <!-- Create-slot dialog (empty cell click) -->
    <dialog id="create-slot-dialog">
      <div class="dialog-header">
        <span>New Planning Slot</span>
        <button class="btn-secondary" id="cs-close" style="border:none;font-size:1.1rem;padding:0 0.3rem;">✕</button>
      </div>
      <div class="dialog-body">
        <div class="form-group">
          <label>Date</label>
          <input type="text" id="cs-date" readonly />
        </div>
        <div class="form-group">
          <label for="cs-type">Event Type</label>
          <select id="cs-type">
            <option value="after_work_south">Tue Evening · South</option>
            <option value="after_work_north">Thu Evening · North</option>
            <option value="weekend_casual">Weekend Casual</option>
            <option value="weekend_challenge">Weekend Challenge</option>
            <option value="special_ride">Special Ride</option>
            <option value="workshop">Workshop</option>
            <option value="eyas_program">EYAS · 雏鹰计划</option>
          </select>
        </div>
        <div class="msg" id="cs-msg"></div>
      </div>
      <div class="dialog-footer">
        <button class="btn-secondary" id="cs-cancel">Cancel</button>
        <button class="action-btn" id="cs-create">Create Slot</button>
      </div>
    </dialog>

    <!-- Bulk-generate dialog (secondary) -->
    <dialog id="generate-dialog">
      <div class="dialog-header">
        <span>Bulk Generate Slots</span>
        <button class="btn-secondary" id="gen-close" style="border:none;font-size:1.1rem;padding:0 0.3rem;">✕</button>
      </div>
      <div class="dialog-body">
        <div class="form-group">
          <label for="gen-season">Season</label>
          <input type="text" id="gen-season" value="2026" />
        </div>
        <div class="form-group">
          <label for="gen-start">Start Date</label>
          <input type="date" id="gen-start" value="2026-05-01" />
        </div>
        <div class="form-group">
          <label for="gen-end">End Date</label>
          <input type="date" id="gen-end" value="2026-11-30" />
        </div>
        <div class="form-group">
          <div class="checkbox-row">
            <input type="checkbox" id="gen-overwrite" />
            <label for="gen-overwrite">Overwrite existing unclaimed slots</label>
          </div>
        </div>
        <div class="gen-preview-box" id="gen-preview"></div>
      </div>
      <div class="dialog-footer">
        <button class="btn-secondary" id="gen-cancel">Cancel</button>
        <button class="action-btn" id="gen-dry-run">Preview</button>
        <button class="action-btn" id="gen-confirm" style="display:none;">Confirm</button>
      </div>
    </dialog>

    <script define:vars={{ currentSeason: season }}>
      // ── Create slot dialog ──────────────────────────────────
      const createDialog = document.getElementById("create-slot-dialog");
      const csDateInput  = document.getElementById("cs-date");
      const csType       = document.getElementById("cs-type");
      const csMsg        = document.getElementById("cs-msg");
      const csCreate     = document.getElementById("cs-create");

      const DEFAULT_TYPE = { 1: "after_work_south", 3: "after_work_north", 5: "weekend_casual" };
      let csSeasonOverride = currentSeason;

      function showMsg(el, text, ok) {
        el.textContent = text;
        el.className = "msg visible " + (ok ? "msg-ok" : "msg-err");
      }

      document.querySelectorAll(".day-cell.cell-empty[data-date]").forEach((cell) => {
        cell.addEventListener("click", () => {
          const d    = cell.dataset.date;
          const wday = parseInt(cell.dataset.weekday);
          csSeasonOverride      = cell.dataset.season || currentSeason;
          csDateInput.value     = d;
          csType.value          = DEFAULT_TYPE[wday] || "after_work_south";
          csMsg.className       = "msg";
          csMsg.textContent     = "";
          csCreate.disabled     = false;
          csCreate.textContent  = "Create Slot";
          createDialog.showModal();
        });
      });

      document.getElementById("cs-close")?.addEventListener("click",  () => createDialog.close());
      document.getElementById("cs-cancel")?.addEventListener("click", () => createDialog.close());
      createDialog.addEventListener("click", (e) => { if (e.target === createDialog) createDialog.close(); });

      csCreate?.addEventListener("click", async () => {
        csCreate.disabled    = true;
        csCreate.textContent = "Creating…";
        try {
          const res = await fetch("/api/admin/season/slots", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              season: csSeasonOverride,
              planned_date: csDateInput.value,
              event_type: csType.value,
            }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.detail || JSON.stringify(data));
          window.location.href = `/dashboard/season-planner/${data.id}`;
        } catch (e) {
          showMsg(csMsg, "Error: " + (e instanceof Error ? e.message : String(e)), false);
          csCreate.disabled    = false;
          csCreate.textContent = "Create Slot";
        }
      });

      // ── Add-next-week button ────────────────────────────────
      document.getElementById("add-week-btn")?.addEventListener("click", async () => {
        const btn        = document.getElementById("add-week-btn");
        const nextMonday = btn.dataset.nextMonday;
        const nextSunday = btn.dataset.nextSunday;
        const season     = btn.dataset.season || currentSeason;
        btn.disabled     = true;
        btn.textContent  = "…";
        try {
          const res = await fetch("/api/admin/season/generate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              season,
              start_date: nextMonday,
              end_date:   nextSunday,
              dry_run: false,
              overwrite_unclaimed: false,
            }),
          });
          if (!res.ok) throw new Error(`Error ${res.status}`);
          window.location.reload();
        } catch (e) {
          btn.disabled    = false;
          btn.textContent = "+";
          alert("Error: " + (e instanceof Error ? e.message : String(e)));
        }
      });

      // ── Bulk-generate dialog (secondary) ────────────────────
      const genDialog  = document.getElementById("generate-dialog");
      const genPreview = document.getElementById("gen-preview");
      const genDryRun  = document.getElementById("gen-dry-run");
      const genConfirm = document.getElementById("gen-confirm");

      function openGenDialog() {
        genPreview.classList.remove("visible");
        genPreview.textContent = "";
        genConfirm.style.display = "none";
        genDryRun.style.display  = "";
        genDialog.showModal();
      }
      function closeGenDialog() { genDialog.close(); }

      document.getElementById("open-generate-modal")?.addEventListener("click", openGenDialog);
      document.getElementById("gen-close")?.addEventListener("click",  closeGenDialog);
      document.getElementById("gen-cancel")?.addEventListener("click", closeGenDialog);
      genDialog.addEventListener("click", (e) => { if (e.target === genDialog) closeGenDialog(); });

      async function callGenerate(dryRun) {
        const season    = document.getElementById("gen-season").value.trim();
        const startDate = document.getElementById("gen-start").value;
        const endDate   = document.getElementById("gen-end").value;
        const overwrite = document.getElementById("gen-overwrite").checked;
        const res = await fetch("/api/admin/season/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ season, start_date: startDate, end_date: endDate, dry_run: dryRun, overwrite_unclaimed: overwrite }),
        });
        if (!res.ok) throw new Error(`API error (${res.status}): ${await res.text()}`);
        return res.json();
      }

      genDryRun?.addEventListener("click", async () => {
        genDryRun.disabled    = true;
        genDryRun.textContent = "Calculating…";
        genPreview.classList.remove("visible");
        try {
          const data = await callGenerate(true);
          genPreview.textContent = `Preview: will create ${data.would_create} slot(s), skipping ${data.skipped} existing.`;
          genPreview.classList.add("visible");
          genConfirm.style.display = "";
        } catch (e) {
          genPreview.textContent = `Error: ${e instanceof Error ? e.message : String(e)}`;
          genPreview.classList.add("visible");
        } finally {
          genDryRun.disabled    = false;
          genDryRun.textContent = "Preview";
        }
      });

      genConfirm?.addEventListener("click", async () => {
        genConfirm.disabled    = true;
        genConfirm.textContent = "Generating…";
        try {
          const data = await callGenerate(false);
          genPreview.textContent = `Done: created ${data.created} slot(s), skipped ${data.skipped}.`;
          genPreview.classList.add("visible");
          setTimeout(() => { closeGenDialog(); window.location.reload(); }, 1200);
        } catch (e) {
          genPreview.textContent = `Error: ${e instanceof Error ? e.message : String(e)}`;
          genPreview.classList.add("visible");
          genConfirm.disabled    = false;
          genConfirm.textContent = "Confirm";
        }
      });
    </script>
  </body>
</html>
