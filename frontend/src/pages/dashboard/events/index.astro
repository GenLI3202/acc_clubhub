---
// dashboard/events/index.astro — Admin event list with stats (SSR)
// Source of truth: Markdown content collection (same as frontend)
// RSVP stats: enriched from backend DB API
export const prerender = false;

import { getCollection } from 'astro:content';
import {
  ADMIN_EVENT_CATEGORIES,
  ADMIN_EVENT_VIEWS,
  filterAdminEvents,
  formatRegistrationSummary,
  getAdminEventStatus,
  getEventTypeLabel,
  type AdminEventCategory,
  type AdminEventRow,
  type AdminEventView,
} from '../../../lib/admin/events';
import { resolveRecurringEvents } from '../../../lib/events/recurringEvents';

const apiUrl = import.meta.env.PUBLIC_API_URL || "https://acc-clubhub-events-ms.vercel.app";
const isLocalPreview = import.meta.env.DEV
  && ["127.0.0.1", "localhost"].includes(Astro.url.hostname)
  && Astro.url.searchParams.get("preview") === "1";

const requestedView = Astro.url.searchParams.get("view") as AdminEventView | null;
const activeView: AdminEventView = requestedView && ADMIN_EVENT_VIEWS.some((view) => view.key === requestedView)
  ? requestedView
  : "upcoming";

const requestedCategory = Astro.url.searchParams.get("category") as AdminEventCategory | null;
const activeCategory: AdminEventCategory = requestedCategory && ADMIN_EVENT_CATEGORIES.some((cat) => cat.key === requestedCategory)
  ? requestedCategory
  : "all";

const now = new Date();

// Verify authentication — forward browser cookies to backend
const cookie = Astro.request.headers.get("cookie") || "";
if (!isLocalPreview) {
  try {
    const meRes = await fetch(`${apiUrl}/auth/me`, {
      headers: { "Cookie": cookie },
    });
    if (!meRes.ok) {
      return Astro.redirect("/dashboard/login", 302);
    }
  } catch {
    return Astro.redirect("/dashboard/login", 302);
  }
}

// 1. Read events from Markdown (source of truth — same as frontend)
const allEvents = await getCollection('events');
const zhEvents = resolveRecurringEvents(
  allEvents.filter((e) => {
    const entryLang = e.id.includes('/') ? e.id.split('/')[0] : 'zh';
    return entryLang === 'zh';
  })
);

// 2. Sync resolved occurrences to DB before fetching RSVP stats
const dbStatsMap = new Map<string, any>();
let statsWarning: string | null = null;
let schemaWarning: string | null = null;

try {
  const schemaRes = await fetch(`${apiUrl}/api/admin/health/schema`, {
    headers: { "Cookie": cookie },
  });
  if (schemaRes.status === 401) {
    return Astro.redirect("/dashboard/login", 302);
  }
  if (schemaRes.ok) {
    const schemaHealth = await schemaRes.json();
    if (!schemaHealth.ok && schemaHealth.missing_columns?.length) {
      schemaWarning = `Database schema missing: ${schemaHealth.missing_columns.join(", ")}`;
    }
  } else {
    schemaWarning = `Database schema check unavailable (API returned ${schemaRes.status})`;
  }
} catch (e) {
  const message = e instanceof Error ? e.message : String(e);
  schemaWarning = `Database schema check unavailable: ${message}`;
}

const occurrencePayload = zhEvents.map((e) => ({
  slug: e.data.slug,
  title: e.data.title,
  event_date: e.data.date,
  location: e.data.location ?? null,
  event_type: e.data.eventType,
  max_participants: e.data.maxParticipants ?? null,
  registration_deadline: e.data.registrationDeadline ?? null,
  description: e.data.description ?? null,
  distance_km: e.data.distanceKm ?? null,
}));

if (isLocalPreview) {
  statsWarning = "Local preview mode: RSVP stats and admin actions are not loaded.";
} else {
  try {
    const syncRes = await fetch(`${apiUrl}/api/admin/sync-occurrences`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Cookie": cookie,
      },
      body: JSON.stringify(occurrencePayload),
    });
    if (syncRes.status === 401) {
      return Astro.redirect("/dashboard/login", 302);
    }
    if (!syncRes.ok) {
      statsWarning = `Occurrence sync unavailable (API returned ${syncRes.status})`;
    }
  } catch (e: any) {
    statsWarning = `Occurrence sync unavailable: ${e.message}`;
  }
}

// 3. Fetch RSVP stats from DB (for enrichment only)
if (!isLocalPreview) {
  try {
    const res = await fetch(`${apiUrl}/api/admin/events`, {
      headers: { "Cookie": cookie },
    });
    if (res.ok) {
      const dbEvents = await res.json();
      for (const e of dbEvents) {
        dbStatsMap.set(e.slug, e);
      }
    } else if (res.status === 401) {
      return Astro.redirect("/dashboard/login", 302);
    } else {
      statsWarning = `RSVP stats unavailable (API returned ${res.status})`;
    }
  } catch (e: any) {
    statsWarning = `RSVP stats unavailable: ${e.message}`;
  }
}

// 4. Merge: Markdown events + DB RSVP stats
const allMerged: AdminEventRow[] = zhEvents.map((e) => {
  const slug = e.data.slug ?? e.id.split('/').pop()?.replace(/\.mdx?$/, '') ?? '';
  const stats = dbStatsMap.get(slug);
  return {
    slug,
    title: e.data.title,
    date: String(e.data.date),
    location: e.data.location ?? null,
    eventType: e.data.eventType,
    maxParticipants: e.data.maxParticipants ?? null,
    registrationDeadline: e.data.registrationDeadline ?? null,
    confirmed_count: stats?.confirmed_count ?? 0,
    waitlist_count: stats?.waitlist_count ?? 0,
    cancelled_count: stats?.cancelled_count ?? 0,
    spots_remaining: stats?.spots_remaining ?? null,
    db_id: stats?.id ?? null,
    in_db: !!stats,
    distance_km: stats?.distance_km ?? (e.data.distanceKm ?? null),
  };
});

const events = filterAdminEvents(allMerged, activeView, activeCategory, now);

const viewCounts = new Map<AdminEventView, number>();
for (const view of ADMIN_EVENT_VIEWS) {
  viewCounts.set(
    view.key,
    filterAdminEvents(allMerged, view.key, activeCategory, now).length,
  );
}

const categoryCounts = new Map<AdminEventCategory, number>();
for (const category of ADMIN_EVENT_CATEGORIES) {
  categoryCounts.set(
    category.key,
    filterAdminEvents(allMerged, activeView, category.key, now).length,
  );
}

let fetchError: string | null = null;

function formatDate(dateStr: string | null): string {
  if (!dateStr) return "—";
  try {
    return new Date(dateStr).toLocaleDateString("en-GB", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  } catch {
    return dateStr;
  }
}

function formatKm(value: number | null | undefined): string {
  if (value == null || Number.isNaN(value)) return "—";
  return `${Number(value).toFixed(1)} km`;
}

function getViewUrl(view: AdminEventView): string {
  const params = new URLSearchParams();
  if (view !== "upcoming") params.set("view", view);
  if (activeCategory !== "all") params.set("category", activeCategory);
  const query = params.toString();
  return query ? `/dashboard/events?${query}` : "/dashboard/events";
}

function getCategoryUrl(category: AdminEventCategory): string {
  const params = new URLSearchParams();
  if (activeView !== "upcoming") params.set("view", activeView);
  if (category !== "all") params.set("category", category);
  const query = params.toString();
  return query ? `/dashboard/events?${query}` : "/dashboard/events";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Events | ACC ClubHub Admin</title>
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #f6f8fa;
        margin: 0;
        padding: 2rem;
      }
      .container { max-width: 1180px; margin: 0 auto; }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #d0d7de;
      }
      h1 { font-size: 1.5rem; margin: 0; color: #24292f; }
      .breadcrumb { margin-bottom: 1.5rem; }
      .breadcrumb a { color: #0969da; text-decoration: none; font-size: 0.9rem; }
      .breadcrumb a:hover { text-decoration: underline; }
      .back-link { color: #0969da; text-decoration: none; font-size: 0.9rem; }
      .back-link:hover { text-decoration: underline; }
      table {
        width: 100%;
        background: white;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        border-collapse: collapse;
        overflow: hidden;
      }
      th {
        background: #f6f8fa;
        text-align: left;
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: #57606a;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #d0d7de;
      }
      td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #eaeef2;
        font-size: 0.9rem;
      }
      tr:last-child td { border-bottom: none; }
      tr:hover td { background: #f6f8fa; }
      .event-title { font-weight: 600; color: #24292f; }
      .badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
      }
      .status {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
      }
      .status-open { background: #dafbe1; color: #1a7f37; }
      .status-full,
      .status-waitlist { background: #fff8c5; color: #9a6700; }
      .status-closed,
      .status-past,
      .status-not-synced { background: #eef1f5; color: #57606a; }
      .registration-summary {
        color: #24292f;
        font-size: 0.86rem;
        line-height: 1.35;
      }
      .spots-left {
        color: #57606a;
        font-size: 0.78rem;
        margin-top: 0.2rem;
      }
      .distance-note {
        color: #57606a;
        font-size: 0.78rem;
        margin-top: 0.2rem;
      }
      .action-btn {
        display: inline-block;
        padding: 0.3rem 0.7rem;
        background: #0969da;
        color: white !important;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 500;
        transition: background 0.2s;
      }
      .action-btn:hover { background: #0860ca; text-decoration: none; }
      .error { background: #ffebe9; border: 1px solid #ff818266; padding: 1rem; border-radius: 6px; color: #cf222e; margin-bottom: 1rem; }
      .warning { background: #fff8c5; border: 1px solid #d4a72c66; padding: 1rem; border-radius: 6px; color: #9a6700; margin-bottom: 1rem; }
      .no-db { color: #8b949e; font-size: 0.8rem; font-style: italic; }
      .empty { text-align: center; padding: 3rem; color: #57606a; }

      .view-nav,
      .category-nav {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .view-nav { margin-bottom: 1rem; }
      .category-nav { margin-bottom: 1.5rem; }
      .view-tab,
      .category-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 0.9rem;
        border: 1px solid #d0d7de;
        border-radius: 20px;
        background: white;
        color: #57606a;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.15s ease;
        cursor: pointer;
      }
      .view-tab {
        border-radius: 6px;
        font-weight: 600;
      }
      .view-tab:hover,
      .category-tab:hover {
        background: #f6f8fa;
        border-color: #0969da;
        color: #0969da;
        text-decoration: none;
      }
      .view-tab.active,
      .category-tab.active {
        background: #0969da;
        border-color: #0969da;
        color: white;
      }
      .view-tab.active:hover,
      .category-tab.active:hover {
        background: #0860ca;
      }
      .tab-count {
        display: inline-block;
        min-width: 1.3rem;
        padding: 0.05rem 0.35rem;
        border-radius: 10px;
        font-size: 0.7rem;
        font-weight: 600;
        text-align: center;
        background: rgba(0, 0, 0, 0.08);
      }
      .view-tab.active .tab-count,
      .category-tab.active .tab-count {
        background: rgba(255, 255, 255, 0.25);
      }
      .type-badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-size: 0.74rem;
        font-weight: 600;
        background: #eef1f5;
        color: #57606a;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="breadcrumb">
        <a href="/dashboard">&larr; Admin Dashboard</a>
      </div>

      <div class="header">
        <h1>Events</h1>
      </div>

      <nav class="view-nav" aria-label="Event views">
        {ADMIN_EVENT_VIEWS.map((view) => (
          <a
            href={getViewUrl(view.key)}
            class={`view-tab ${activeView === view.key ? "active" : ""}`}
          >
            {view.label}
            <span class="tab-count">{viewCounts.get(view.key) ?? 0}</span>
          </a>
        ))}
      </nav>

      <nav class="category-nav">
        {ADMIN_EVENT_CATEGORIES.map((cat) => (
          <a
            href={getCategoryUrl(cat.key)}
            class={`category-tab ${activeCategory === cat.key ? "active" : ""}`}
          >
            {cat.label}
            <span class="tab-count">{categoryCounts.get(cat.key) ?? 0}</span>
          </a>
        ))}
      </nav>

      {fetchError && <div class="error">{fetchError}</div>}
      {schemaWarning && <div class="warning">{schemaWarning}</div>}
      {statsWarning && <div class="warning">{statsWarning}</div>}

      {events.length === 0 && !fetchError ? (
        <div class="empty">No events found.</div>
      ) : (
        <table>
          <thead>
            <tr>
              <th>Event</th>
              <th>Date</th>
              <th>Category</th>
              <th>Status</th>
              <th>Location</th>
              <th>Registration</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {events.map((event) => {
              const status = getAdminEventStatus(event, now);
              return (
                <tr>
                  <td class="event-title">{event.title}</td>
                  <td>{formatDate(event.date)}</td>
                  <td>
                    <span class="type-badge">{getEventTypeLabel(event.eventType)}</span>
                  </td>
                  <td>
                    <span class={`status status-${status.key}`}>{status.label}</span>
                  </td>
                  <td>{event.location || "—"}</td>
                  <td>
                    <div class="registration-summary">
                      {formatRegistrationSummary(event)}
                    </div>
                    <div class="spots-left">
                      {event.maxParticipants === null
                        ? "No capacity limit"
                        : `${event.spots_remaining ?? event.maxParticipants} spots left`}
                    </div>
                    <div class="distance-note">Distance: {formatKm(event.distance_km)}</div>
                  </td>
                  <td>
                    {event.db_id ? (
                      <a href={`/dashboard/events/${event.db_id}`} class="action-btn">
                        Manage
                      </a>
                    ) : (
                      <span class="no-db" title="Event not yet synced to database">Not synced</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </div>
  </body>
</html>
